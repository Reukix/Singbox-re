@@ -0,0 +1,47 @@
+//go:build with_script
+
+package script
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestLocalSourceRejectsBrokenScripts(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "script.js")
+	logger := log.NewNOPFactory().NewLogger("test")
+	var options option.Script
+	options.Tag = "local"
+	options.LocalOptions = option.LocalScriptSource{Path: path}
+	if err := os.WriteFile(path, []byte("this is not javascript"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NewLocalSource(context.Background(), logger, options); err == nil {
+		t.Fatal("a local script with a syntax error must fail at startup")
+	}
+	if err := os.WriteFile(path, []byte(`$done({ body: "v1" });`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	source, err := NewLocalSource(context.Background(), logger, options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer source.Close()
+	if source.Program() == nil {
+		t.Fatal("valid script not compiled")
+	}
+	if err := os.WriteFile(path, []byte("broken {"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := source.reloadFile(path); err == nil {
+		t.Fatal("broken reload accepted")
+	}
+	if text, _ := source.Text(); text != `$done({ body: "v1" });` {
+		t.Fatalf("broken reload replaced the working script: %q", text)
+	}
+}
diff --git a/script/source_remote.go b/script/source_remote.go
new file mode 100644
index 000000000..c8fb98949
--- /dev/null
+++ b/script/source_remote.go
@@ -0,0 +1,316 @@
+//go:build with_script
+
+package script
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"runtime"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/experimental/deprecated"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	F "github.com/sagernet/sing/common/format"
+	"github.com/sagernet/sing/common/logger"
+	"github.com/sagernet/sing/service"
+	"github.com/sagernet/sing/service/pause"
+
+	"github.com/dop251/goja"
+)
+
+var _ Source = (*RemoteSource)(nil)
+
+type RemoteSource struct {
+	ctx            context.Context
+	cancel         context.CancelFunc
+	logger         logger.ContextLogger
+	options        option.Script
+	updateInterval time.Duration
+	httpClient     *http.Client
+	program        *lazyProgram
+	lastUpdated    time.Time
+	lastAttempt    time.Time
+	lastEtag       string
+	cacheFile      adapter.CacheFile
+	pauseManager   pause.Manager
+}
+
+func NewRemoteSource(ctx context.Context, logger logger.ContextLogger, options option.Script) (*RemoteSource, error) {
+	ctx, cancel := context.WithCancel(ctx)
+	var updateInterval time.Duration
+	if options.RemoteOptions.UpdateInterval > 0 {
+		updateInterval = time.Duration(options.RemoteOptions.UpdateInterval)
+	} else {
+		updateInterval = 24 * time.Hour
+	}
+	return &RemoteSource{
+		ctx:            ctx,
+		cancel:         cancel,
+		logger:         logger,
+		options:        options,
+		updateInterval: updateInterval,
+		program:        newLazyProgram(F.ToString("script:", options.Tag), logger),
+		pauseManager:   service.FromContext[pause.Manager](ctx),
+	}, nil
+}
+
+func (s *RemoteSource) StartContext(ctx context.Context, startContext *adapter.HTTPStartContext) error {
+	s.cacheFile = service.FromContext[adapter.CacheFile](s.ctx)
+	if s.cacheFile != nil {
+		if savedSet := s.cacheFile.LoadScript(s.options.Tag); savedSet != nil {
+			err := s.loadBytes(savedSet.Content)
+			if err != nil {
+				s.logger.Error(E.Cause(err, "restore cached script; fetching a fresh copy"))
+			} else {
+				s.lastUpdated = savedSet.LastUpdated
+				s.lastEtag = savedSet.LastEtag
+			}
+		}
+	}
+	transport, err := s.resolveTransport()
+	if err != nil {
+		s.logger.Error(E.Cause(err, "create script http client; remote script disabled until restart"))
+		return nil
+	}
+	startContext.Register(transport)
+	s.httpClient = &http.Client{Transport: transport}
+	if s.lastUpdated.IsZero() {
+		err := s.fetchOnce(ctx)
+		if err != nil {
+			s.logger.Error(E.Cause(err, "initial script fetch failed open: ", s.options.Tag))
+		}
+	}
+	return nil
+}
+
+func (s *RemoteSource) PostStart() error {
+	go s.loopUpdate()
+	return nil
+}
+
+// Program compiles the script only when goja runs it. Remote scripts are
+// often large (Script Hub's frontend is hundreds of KiB), and the compiled
+// program is dropped again after an idle period.
+func (s *RemoteSource) Program() *goja.Program {
+	return s.program.Program()
+}
+
+func (s *RemoteSource) Text() (string, string) {
+	return s.program.Text()
+}
+
+func (s *RemoteSource) uncompiledLength() int {
+	return s.program.uncompiledLength()
+}
+
+func (s *RemoteSource) loadBytes(content []byte) error {
+	s.program.setContent(content)
+	return nil
+}
+
+const (
+	// maxRemoteScriptSize rejects oversized downloads before they are
+	// buffered; the largest real-world module scripts are a few hundred KiB.
+	maxRemoteScriptSize int64 = 8 * 1024 * 1024
+	// A script that has never been downloaded is retried on this interval
+	// instead of the regular update interval.
+	remoteScriptRetryInterval = 10 * time.Minute
+	remoteScriptFetchSlots    = 4
+)
+
+func (s *RemoteSource) loopUpdate() {
+	for {
+		interval := s.updateInterval
+		if s.lastUpdated.IsZero() {
+			interval = remoteScriptRetryInterval
+		}
+		// The start already downloaded (or tried to download) a script
+		// without cache; do not fetch it again right away.
+		wait := interval - time.Since(s.lastUpdated)
+		if !s.lastAttempt.IsZero() {
+			wait = max(wait, interval-time.Since(s.lastAttempt))
+		}
+		if wait > 0 {
+			timer := time.NewTimer(wait)
+			select {
+			case <-s.ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+		}
+		if s.pauseManager != nil {
+			s.pauseManager.WaitActive()
+		}
+		updated := s.lastUpdated
+		err := s.fetchOnce(s.ctx)
+		if err != nil {
+			s.logger.Error(E.Cause(err, "update script ", s.options.Tag))
+		} else if s.lastUpdated != updated {
+			// Drop the previous version of the script right away.
+			runtime.GC()
+		}
+	}
+}
+
+// Downloads of the same URL are coalesced: modules often point many script
+// entries at one file (a dozen RedPaper rules share one script), and a start
+// without cache used to download every copy at the same time.
+type remoteFetchResult struct {
+	status     int
+	statusText string
+	etag       string
+	content    []byte
+	err        error
+}
+
+type remoteFetchCall struct {
+	done   chan struct{}
+	result remoteFetchResult
+}
+
+var (
+	remoteFetchAccess sync.Mutex
+	remoteFetchCalls  = make(map[string]*remoteFetchCall)
+	remoteFetchSlots  = make(chan struct{}, remoteScriptFetchSlots)
+)
+
+func (s *RemoteSource) download(ctx context.Context) remoteFetchResult {
+	key := s.options.RemoteOptions.URL + "\x00" + s.options.RemoteOptions.DownloadDetour + "\x00" + s.lastEtag //nolint:staticcheck
+	remoteFetchAccess.Lock()
+	if call, loaded := remoteFetchCalls[key]; loaded {
+		remoteFetchAccess.Unlock()
+		select {
+		case <-call.done:
+			return call.result
+		case <-ctx.Done():
+			return remoteFetchResult{err: ctx.Err()}
+		}
+	}
+	call := &remoteFetchCall{done: make(chan struct{})}
+	remoteFetchCalls[key] = call
+	remoteFetchAccess.Unlock()
+	call.result = s.downloadOnce(ctx)
+	remoteFetchAccess.Lock()
+	delete(remoteFetchCalls, key)
+	remoteFetchAccess.Unlock()
+	close(call.done)
+	return call.result
+}
+
+func (s *RemoteSource) downloadOnce(ctx context.Context) remoteFetchResult {
+	select {
+	case remoteFetchSlots <- struct{}{}:
+	case <-ctx.Done():
+		return remoteFetchResult{err: ctx.Err()}
+	}
+	defer func() { <-remoteFetchSlots }()
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, s.options.RemoteOptions.URL, nil)
+	if err != nil {
+		return remoteFetchResult{err: err}
+	}
+	if s.lastEtag != "" {
+		request.Header.Set("If-None-Match", s.lastEtag)
+	}
+	request.Header.Set("User-Agent", "sing-box Script Loader")
+	request.Header.Set("Accept", "application/javascript, text/javascript, text/plain, */*")
+	response, err := s.httpClient.Do(request)
+	if err != nil {
+		return remoteFetchResult{err: err}
+	}
+	defer response.Body.Close()
+	result := remoteFetchResult{status: response.StatusCode, statusText: response.Status, etag: response.Header.Get("Etag")}
+	if response.StatusCode != http.StatusOK {
+		return result
+	}
+	content, err := io.ReadAll(io.LimitReader(response.Body, maxRemoteScriptSize+1))
+	if err != nil {
+		return remoteFetchResult{err: err}
+	}
+	if int64(len(content)) > maxRemoteScriptSize {
+		return remoteFetchResult{err: E.New("remote script exceeds ", maxRemoteScriptSize, " bytes")}
+	}
+	result.content = content
+	return result
+}
+
+func (s *RemoteSource) resolveTransport() (adapter.HTTPTransport, error) {
+	httpClientManager := service.FromContext[adapter.HTTPClientManager](s.ctx)
+	if s.options.RemoteOptions.DownloadDetour != "" { //nolint:staticcheck
+		deprecated.Report(s.ctx, deprecated.OptionLegacyRuleSetDownloadDetour)
+		return httpClientManager.ResolveTransport(s.ctx, s.logger, option.HTTPClientOptions{
+			DialerOptions: option.DialerOptions{
+				Detour: s.options.RemoteOptions.DownloadDetour, //nolint:staticcheck
+			},
+			DisableEmptyDirectCheck: true,
+		})
+	}
+	defaultTransport := httpClientManager.DefaultTransport()
+	if defaultTransport == nil {
+		return nil, E.New("default http client transport is not initialized")
+	}
+	return defaultTransport, nil
+}
+
+func (s *RemoteSource) fetchOnce(ctx context.Context) error {
+	s.logger.Debug("updating script ", s.options.Tag, " from URL: ", s.options.RemoteOptions.URL)
+	if s.httpClient == nil {
+		return E.New("script HTTP client is unavailable")
+	}
+	s.lastAttempt = time.Now()
+	result := s.download(ctx)
+	if result.err != nil {
+		return result.err
+	}
+	var err error
+	switch result.status {
+	case http.StatusOK:
+	case http.StatusNotModified:
+		s.lastUpdated = time.Now()
+		if s.cacheFile != nil {
+			savedRuleSet := s.cacheFile.LoadScript(s.options.Tag)
+			if savedRuleSet != nil {
+				savedRuleSet.LastUpdated = s.lastUpdated
+				err = s.cacheFile.SaveScript(s.options.Tag, savedRuleSet)
+				if err != nil {
+					s.logger.Error("save script updated time: ", err)
+					return nil
+				}
+			}
+		}
+		s.logger.Info("update script ", s.options.Tag, ": not modified")
+		return nil
+	default:
+		return E.New("unexpected status: ", result.statusText)
+	}
+	content := result.content
+	// The download may be shared with other entries of the same URL and is
+	// never written, so the program can keep it without another copy.
+	s.program.setSharedContent(content)
+	if result.etag != "" {
+		s.lastEtag = result.etag
+	}
+	s.lastUpdated = time.Now()
+	if s.cacheFile != nil {
+		err = s.cacheFile.SaveScript(s.options.Tag, &adapter.SavedBinary{
+			LastUpdated: s.lastUpdated,
+			Content:     content,
+			LastEtag:    s.lastEtag,
+		})
+		if err != nil {
+			s.logger.Error("save script cache: ", err)
+		}
+	}
+	s.logger.Info("updated script ", s.options.Tag)
+	return nil
+}
+
+func (s *RemoteSource) Close() error {
+	s.program.close()
+	s.cancel()
+	return nil
+}
