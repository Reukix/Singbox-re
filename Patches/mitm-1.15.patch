diff --git a/mitm/body.go b/mitm/body.go
new file mode 100644
index 000000000..d6b23b0eb
--- /dev/null
+++ b/mitm/body.go
@@ -0,0 +1,317 @@
+package mitm
+
+import (
+	"bytes"
+	"compress/flate"
+	"compress/gzip"
+	"compress/zlib"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/andybalholm/brotli"
+	"golang.org/x/net/http/httpguts"
+)
+
+const (
+	requestRewriteBodyLimit  int64 = 32 * 1024 * 1024
+	responseRewriteBodyLimit int64 = 1024 * 1024
+	mapLocalBodyLimit        int64 = 4 * 1024 * 1024
+	printBodyLimit           int64 = 128 * 1024
+)
+
+// bufferHTTPBody returns a decoded, replayable body when it fits within limit.
+// If the body is too large, the returned replay body contains every byte read so
+// forwarding can continue without truncation.
+func bufferHTTPBody(body io.ReadCloser, contentLength int64, headers http.Header, limit int64) (content []byte, replay io.ReadCloser, available bool, decoded bool, err error) {
+	if body == nil || body == http.NoBody || contentLength == 0 {
+		return []byte{}, http.NoBody, true, false, nil
+	}
+	if limit <= 0 {
+		limit = responseRewriteBodyLimit
+	}
+	if contentLength > limit {
+		return nil, body, false, false, nil
+	}
+
+	wireBody, readErr := io.ReadAll(io.LimitReader(body, limit+1))
+	if readErr != nil {
+		return nil, body, false, false, readErr
+	}
+	if int64(len(wireBody)) > limit {
+		return nil, &surgeReplayBody{
+			Reader: io.MultiReader(bytes.NewReader(wireBody), body),
+			Closer: body,
+		}, false, false, nil
+	}
+	_ = body.Close()
+
+	contentEncoding := headers.Get("Content-Encoding")
+	if strings.TrimSpace(contentEncoding) == "" || strings.EqualFold(strings.TrimSpace(contentEncoding), "identity") {
+		return wireBody, io.NopCloser(bytes.NewReader(wireBody)), true, false, nil
+	}
+	decodedBody, decodeErr := decodeHTTPBody(wireBody, contentEncoding, limit)
+	if decodeErr != nil {
+		return nil, io.NopCloser(bytes.NewReader(wireBody)), false, false, nil
+	}
+	return decodedBody, io.NopCloser(bytes.NewReader(decodedBody)), true, true, nil
+}
+
+func decodeHTTPBody(content []byte, contentEncoding string, limit int64) ([]byte, error) {
+	encodings := strings.Split(contentEncoding, ",")
+	decoded := content
+	for index := len(encodings) - 1; index >= 0; index-- {
+		encoding := strings.ToLower(strings.TrimSpace(encodings[index]))
+		if encoding == "" || encoding == "identity" {
+			continue
+		}
+		var (
+			reader io.ReadCloser
+			err    error
+		)
+		switch encoding {
+		case "gzip", "x-gzip":
+			reader, err = gzip.NewReader(bytes.NewReader(decoded))
+		case "deflate":
+			reader, err = zlib.NewReader(bytes.NewReader(decoded))
+			if err != nil {
+				reader = flate.NewReader(bytes.NewReader(decoded))
+				err = nil
+			}
+		case "br":
+			reader = io.NopCloser(brotli.NewReader(bytes.NewReader(decoded)))
+		default:
+			return nil, &unsupportedContentEncodingError{encoding: encoding}
+		}
+		if err != nil {
+			return nil, err
+		}
+		next, readErr := io.ReadAll(io.LimitReader(reader, limit+1))
+		closeErr := reader.Close()
+		if readErr != nil {
+			return nil, readErr
+		}
+		if closeErr != nil {
+			return nil, closeErr
+		}
+		if int64(len(next)) > limit {
+			return nil, &bodyLimitError{limit: limit}
+		}
+		decoded = next
+	}
+	return decoded, nil
+}
+
+type unsupportedContentEncodingError struct {
+	encoding string
+}
+
+func (e *unsupportedContentEncodingError) Error() string {
+	return "unsupported content encoding: " + e.encoding
+}
+
+type bodyLimitError struct {
+	limit int64
+}
+
+func (e *bodyLimitError) Error() string {
+	return "decoded body exceeds limit: " + strconv.FormatInt(e.limit, 10)
+}
+
+func setRequestBody(request *http.Request, body []byte, decoded bool) {
+	request.Body = io.NopCloser(bytes.NewReader(body))
+	request.ContentLength = int64(len(body))
+	request.TransferEncoding = nil
+	request.Header.Del("Transfer-Encoding")
+	request.Header.Set("Content-Length", strconv.Itoa(len(body)))
+	if decoded {
+		request.Header.Del("Content-Encoding")
+	}
+}
+
+func setResponseBody(response *http.Response, body []byte, decoded bool) {
+	if response.Body != nil {
+		_ = response.Body.Close()
+	}
+	response.Body = io.NopCloser(bytes.NewReader(body))
+	response.ContentLength = int64(len(body))
+	response.TransferEncoding = nil
+	response.Uncompressed = false
+	response.Header.Del("Transfer-Encoding")
+	response.Header.Set("Content-Length", strconv.Itoa(len(body)))
+	if decoded {
+		response.Header.Del("Content-Encoding")
+	}
+}
+
+func cloneScriptHeaders(headers http.Header) http.Header {
+	if headers == nil {
+		return nil
+	}
+	cloned := headers.Clone()
+	sanitizeHeaders(cloned)
+	cloned.Del("Host")
+	return cloned
+}
+
+func replaceRequestHeaders(request *http.Request, headers http.Header) {
+	if headers == nil {
+		return
+	}
+	host := headers.Get("Host")
+	request.Header = cloneScriptHeaders(headers)
+	if host != "" {
+		request.Host = host
+	}
+}
+
+func replaceResponseHeaders(response *http.Response, headers http.Header) {
+	if headers != nil {
+		response.Header = headers.Clone()
+		sanitizeHeaders(response.Header)
+	}
+}
+
+func sanitizeHeaders(headers http.Header) {
+	for name, values := range headers {
+		if !httpguts.ValidHeaderFieldName(name) || strings.HasPrefix(name, ":") {
+			headers.Del(name)
+			continue
+		}
+		validValues := values[:0]
+		for _, value := range values {
+			if httpguts.ValidHeaderFieldValue(value) {
+				validValues = append(validValues, value)
+			}
+		}
+		if len(validValues) == 0 {
+			headers.Del(name)
+		} else {
+			headers[name] = validValues
+		}
+	}
+}
+
+func normalizeRequestFraming(request *http.Request) {
+	removeHopByHopHeaders(request.Header)
+	request.Header.Del("Content-Length")
+	request.Header.Del("Transfer-Encoding")
+	if request.ContentLength == 0 && request.Body == nil {
+		request.Body = http.NoBody
+	}
+}
+
+func normalizeResponseFraming(response *http.Response) {
+	removeHopByHopHeaders(response.Header)
+	response.Header.Del("Transfer-Encoding")
+	response.TransferEncoding = nil
+	if response.ContentLength >= 0 {
+		response.Header.Set("Content-Length", strconv.FormatInt(response.ContentLength, 10))
+	} else {
+		response.Header.Del("Content-Length")
+	}
+}
+
+func removeHopByHopHeaders(headers http.Header) {
+	for _, connectionValue := range headers.Values("Connection") {
+		for _, name := range strings.Split(connectionValue, ",") {
+			headers.Del(strings.TrimSpace(name))
+		}
+	}
+	for _, name := range []string{
+		"Connection",
+		"Proxy-Connection",
+		"Keep-Alive",
+		"Proxy-Authenticate",
+		"Proxy-Authorization",
+		"Te",
+		"Trailer",
+		"Transfer-Encoding",
+		"Upgrade",
+	} {
+		headers.Del(name)
+	}
+}
+
+func applyRequestHeaderRewrite(request *http.Request, rule *option.SurgeHeaderRewriteLine) {
+	if strings.EqualFold(rule.Key, "Host") {
+		switch {
+		case rule.Add, rule.Replace:
+			request.Host = rule.Value
+		case rule.Delete:
+			request.Host = ""
+		case rule.ReplaceRegex:
+			request.Host = rule.Match.ReplaceAllString(request.Host, rule.Value)
+		}
+		return
+	}
+	applyHeaderRewrite(request.Header, rule)
+}
+
+func applyHeaderRewrite(headers http.Header, rule *option.SurgeHeaderRewriteLine) {
+	switch {
+	case rule.Add:
+		headers.Add(rule.Key, rule.Value)
+	case rule.Delete:
+		headers.Del(rule.Key)
+	case rule.Replace:
+		if headers.Get(rule.Key) != "" {
+			headers.Set(rule.Key, rule.Value)
+		}
+	case rule.ReplaceRegex:
+		if values, loaded := headers[http.CanonicalHeaderKey(rule.Key)]; loaded {
+			for index, value := range values {
+				values[index] = rule.Match.ReplaceAllString(value, rule.Value)
+			}
+			headers[http.CanonicalHeaderKey(rule.Key)] = values
+		}
+	}
+}
+
+func applyJQBodyRewrite(ctx context.Context, body []byte, rule *option.SurgeBodyRewriteLine, limit int64) ([]byte, error) {
+	if rule.JQCode == nil {
+		return nil, fmt.Errorf("jq expression is not compiled")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	decoder.UseNumber()
+	var input any
+	if err := decoder.Decode(&input); err != nil {
+		return nil, fmt.Errorf("decode JSON body: %w", err)
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return nil, fmt.Errorf("JSON body contains multiple values")
+		}
+		return nil, fmt.Errorf("decode trailing JSON body: %w", err)
+	}
+
+	iterator := rule.JQCode.RunWithContext(ctx, input)
+	result, loaded := iterator.Next()
+	if !loaded {
+		return nil, fmt.Errorf("jq expression produced no result")
+	}
+	if runErr, isError := result.(error); isError {
+		return nil, fmt.Errorf("execute jq expression: %w", runErr)
+	}
+	if extra, hasExtra := iterator.Next(); hasExtra {
+		if runErr, isError := extra.(error); isError {
+			return nil, fmt.Errorf("execute jq expression: %w", runErr)
+		}
+		return nil, fmt.Errorf("jq expression produced multiple results")
+	}
+	rewritten, err := json.Marshal(result)
+	if err != nil {
+		return nil, fmt.Errorf("encode jq result: %w", err)
+	}
+	if int64(len(rewritten)) > limit {
+		return nil, fmt.Errorf("jq result exceeds limit: %d > %d", len(rewritten), limit)
+	}
+	return rewritten, nil
+}
