--- /dev/null
+++ b/mitm/upstream_test.go
@@ -0,0 +1,301 @@
+package mitm
+
+import (
+	"context"
+	"crypto/tls"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type countingDialer struct {
+	dials atomic.Int32
+}
+
+func (d *countingDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	d.dials.Add(1)
+	return (&net.Dialer{}).DialContext(ctx, N.NetworkTCP, destination.String())
+}
+
+func (d *countingDialer) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	return nil, net.ErrClosed
+}
+
+type valueDialer struct {
+	name []string
+}
+
+func (d valueDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	return nil, net.ErrClosed
+}
+
+func (d valueDialer) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	return nil, net.ErrClosed
+}
+
+func TestUpstreamKeyForDialerIdentity(t *testing.T) {
+	tlsConfig := &tls.Config{ServerName: "example.com", MinVersion: tls.VersionTLS12, MaxVersion: tls.VersionTLS13}
+	destination := M.ParseSocksaddr("203.0.113.7:443")
+	key, poolable := upstreamKeyFor(valueDialer{}, destination, tlsConfig, true)
+	if poolable {
+		t.Fatal("a non-pointer dialer has no stable identity and must not be pooled")
+	}
+	if !key.tls || key.serverName != "example.com" || !key.http2 {
+		t.Fatalf("unpooled key must still carry TLS settings: %+v", key)
+	}
+	pointerDialer := &countingDialer{}
+	first, poolable := upstreamKeyFor(pointerDialer, destination, tlsConfig, true)
+	if !poolable {
+		t.Fatal("pointer dialer must be poolable")
+	}
+	second, _ := upstreamKeyFor(pointerDialer, destination, tlsConfig.Clone(), true)
+	if first != second {
+		t.Fatal("equal settings must map to one key")
+	}
+	elsewhere, _ := upstreamKeyFor(pointerDialer, M.ParseSocksaddr("198.51.100.9:443"), tlsConfig, true)
+	if elsewhere == first {
+		t.Fatal("requests routed to another address must not share connections")
+	}
+	plain, _ := upstreamKeyFor(pointerDialer, destination, nil, true)
+	if plain.tls || plain.http2 {
+		t.Fatalf("plain HTTP key must not use TLS or HTTP/2: %+v", plain)
+	}
+}
+
+func newTestHTTP2Server(t *testing.T, handler http.HandlerFunc) (*httptest.Server, *tls.Config) {
+	t.Helper()
+	server := httptest.NewUnstartedServer(handler)
+	server.EnableHTTP2 = true
+	server.StartTLS()
+	t.Cleanup(server.Close)
+	clientConfig := server.Client().Transport.(*http.Transport).TLSClientConfig
+	return server, clientConfig
+}
+
+func poolRequest(t *testing.T, pool *upstreamPool, dialer N.Dialer, server *httptest.Server, roots *tls.Config, path string) (*http.Response, func()) {
+	t.Helper()
+	key, _ := upstreamKeyFor(dialer, M.ParseSocksaddr(server.Listener.Addr().String()), &tls.Config{ServerName: "example.com"}, true)
+	upstream, err := pool.acquire(key, dialer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if upstream.transport.TLSClientConfig.RootCAs != roots.RootCAs {
+		upstream.transport.TLSClientConfig.RootCAs = roots.RootCAs
+	}
+	metadata := &adapter.InboundContext{Destination: M.ParseSocksaddr(server.Listener.Addr().String())}
+	ctx := adapter.WithContext(context.Background(), metadata)
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, "https://example.com"+path, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client := &http.Client{Transport: upstream.transport}
+	response, err := client.Do(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return response, func() { pool.release(upstream) }
+}
+
+func TestUpstreamPoolReusesOneHTTP2Connection(t *testing.T) {
+	server, roots := newTestHTTP2Server(t, func(writer http.ResponseWriter, request *http.Request) {
+		if request.ProtoMajor != 2 {
+			http.Error(writer, "want HTTP/2", http.StatusHTTPVersionNotSupported)
+			return
+		}
+		_, _ = io.WriteString(writer, "ok")
+	})
+	limits := platformLimits()
+	pool := newUpstreamPool(&limits)
+	defer pool.close()
+	dialer := &countingDialer{}
+	for range 5 {
+		response, release := poolRequest(t, pool, dialer, server, roots, "/")
+		body, _ := io.ReadAll(response.Body)
+		_ = response.Body.Close()
+		release()
+		if response.StatusCode != http.StatusOK || string(body) != "ok" {
+			t.Fatalf("status %d body %q", response.StatusCode, body)
+		}
+	}
+	if dials := dialer.dials.Load(); dials != 1 {
+		t.Fatalf("5 requests dialed %d upstream connections, want 1", dials)
+	}
+	if pool.size() != 1 {
+		t.Fatalf("pool holds %d transports, want 1", pool.size())
+	}
+}
+
+func TestUpstreamPoolBoundsSlowStreamBuffering(t *testing.T) {
+	const chunk = 16 * 1024
+	var written atomic.Int64
+	server, roots := newTestHTTP2Server(t, func(writer http.ResponseWriter, request *http.Request) {
+		buffer := make([]byte, chunk)
+		for range 256 { // 4 MiB, more than any sane window
+			if _, err := writer.Write(buffer); err != nil {
+				return
+			}
+			written.Add(chunk)
+			writer.(http.Flusher).Flush()
+		}
+	})
+	limits := platformLimits()
+	limits.upstreamStreamWindow = 64 * 1024
+	limits.upstreamConnectionWindow = 128 * 1024
+	pool := newUpstreamPool(&limits)
+	defer pool.close()
+	response, release := poolRequest(t, pool, &countingDialer{}, server, roots, "/big")
+	defer release()
+	defer response.Body.Close()
+	// A slow client: nothing is read for a while.
+	time.Sleep(500 * time.Millisecond)
+	buffered := written.Load()
+	if buffered > int64(limits.upstreamStreamWindow)+4*chunk {
+		t.Fatalf("upstream pushed %d bytes into a stream nobody reads (window %d)", buffered, limits.upstreamStreamWindow)
+	}
+	// Reading drains the stream and flow control lets the rest through.
+	n, err := io.Copy(io.Discard, response.Body)
+	if err != nil || n != 256*chunk {
+		t.Fatalf("read %d bytes: %v", n, err)
+	}
+}
+
+func TestUpstreamPoolCleanupDropsIdleTransports(t *testing.T) {
+	limits := platformLimits()
+	limits.upstreamTransportIdle = time.Minute
+	pool := newUpstreamPool(&limits)
+	now := time.Now()
+	pool.timeFunc = func() time.Time { return now }
+	dialer := &countingDialer{}
+	key, _ := upstreamKeyFor(dialer, M.Socksaddr{}, &tls.Config{ServerName: "idle.example"}, true)
+	upstream, err := pool.acquire(key, dialer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now = now.Add(2 * time.Minute)
+	pool.cleanup()
+	if pool.size() != 1 {
+		t.Fatal("transport with an in-flight request was dropped")
+	}
+	pool.release(upstream)
+	now = now.Add(2 * time.Minute)
+	pool.cleanup()
+	if pool.size() != 0 {
+		t.Fatal("idle transport was not dropped")
+	}
+}
+
+// TestUpstreamPoolStalledStreamsDoNotBlockOthers: clients share upstream
+// connections, so a few streams nobody reads (a paused video) must leave
+// enough connection window for everyone else.
+func TestUpstreamPoolStalledStreamsDoNotBlockOthers(t *testing.T) {
+	const chunk = 16 * 1024
+	server, roots := newTestHTTP2Server(t, func(writer http.ResponseWriter, request *http.Request) {
+		if request.URL.Path == "/small" {
+			_, _ = writer.Write([]byte("ok"))
+			return
+		}
+		buffer := make([]byte, chunk)
+		for range 256 {
+			if _, err := writer.Write(buffer); err != nil {
+				return
+			}
+			writer.(http.Flusher).Flush()
+		}
+	})
+	production := platformLimits()
+	limits := production
+	// Scaled down, but with the production ratio of connection to stream window.
+	limits.upstreamStreamWindow = 64 * 1024
+	limits.upstreamConnectionWindow = limits.upstreamStreamWindow * (production.upstreamConnectionWindow / production.upstreamStreamWindow)
+	pool := newUpstreamPool(&limits)
+	defer pool.close()
+	dialer := &countingDialer{}
+	for range 6 {
+		response, release := poolRequest(t, pool, dialer, server, roots, "/big")
+		defer release()
+		defer response.Body.Close()
+	}
+	time.Sleep(300 * time.Millisecond)
+	done := make(chan string, 1)
+	go func() {
+		response, release := poolRequest(t, pool, dialer, server, roots, "/small")
+		defer release()
+		defer response.Body.Close()
+		content, _ := io.ReadAll(response.Body)
+		done <- string(content)
+	}()
+	select {
+	case content := <-done:
+		if content != "ok" {
+			t.Fatalf("small response %q", content)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("six stalled streams blocked the shared upstream connection")
+	}
+	if dials := dialer.dials.Load(); dials != 1 {
+		t.Fatalf("requests dialed %d upstream connections, want 1 shared", dials)
+	}
+}
+
+// TestUpstreamPoolConcurrentFirstRequestsShareOneDial: a client that opens
+// many streams at once (Spotify at launch) must not make every stream dial
+// its own upstream connection before the first one exists.
+func TestUpstreamPoolConcurrentFirstRequestsShareOneDial(t *testing.T) {
+	server, roots := newTestHTTP2Server(t, func(writer http.ResponseWriter, request *http.Request) {
+		time.Sleep(20 * time.Millisecond)
+		_, _ = writer.Write([]byte("ok"))
+	})
+	limits := platformLimits()
+	pool := newUpstreamPool(&limits)
+	defer pool.close()
+	dialer := &slowDialer{delay: 100 * time.Millisecond}
+	// Trust the test server before the requests race each other.
+	key, _ := upstreamKeyFor(dialer, M.ParseSocksaddr(server.Listener.Addr().String()), &tls.Config{ServerName: "example.com"}, true)
+	upstream, err := pool.acquire(key, dialer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	upstream.transport.TLSClientConfig.RootCAs = roots.RootCAs
+	pool.release(upstream)
+	var group sync.WaitGroup
+	for range 20 {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			response, release := poolRequest(t, pool, dialer, server, roots, "/")
+			defer release()
+			_, _ = io.Copy(io.Discard, response.Body)
+			response.Body.Close()
+		}()
+	}
+	group.Wait()
+	if dials := dialer.dials.Load(); dials > 2 {
+		t.Fatalf("20 concurrent first requests dialed %d upstream connections", dials)
+	}
+}
+
+// slowDialer makes the first connection take a while, as a proxied dial and
+// TLS handshake do, so concurrent requests pile up before it exists.
+type slowDialer struct {
+	delay time.Duration
+	dials atomic.Int32
+}
+
+func (d *slowDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	d.dials.Add(1)
+	time.Sleep(d.delay)
+	return (&net.Dialer{}).DialContext(ctx, N.NetworkTCP, destination.String())
+}
+
+func (d *slowDialer) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	return nil, net.ErrClosed
+}
