new file mode 100644
index 000000000..2947fe3ea
--- /dev/null
+++ b/script/source.go
@@ -0,0 +1,37 @@
+//go:build with_script
+
+package script
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+
+	"github.com/dop251/goja"
+)
+
+type Source interface {
+	StartContext(ctx context.Context, startContext *adapter.HTTPStartContext) error
+	PostStart() error
+	Program() *goja.Program
+	// Text returns the source code and a fingerprint of it, without copying.
+	Text() (source string, fingerprint string)
+	// uncompiledLength is the source length if goja still has to compile it.
+	uncompiledLength() int
+	Close() error
+}
+
+func NewSource(ctx context.Context, logger logger.ContextLogger, options option.Script) (Source, error) {
+	switch options.Source {
+	case C.ScriptSourceTypeLocal:
+		return NewLocalSource(ctx, logger, options)
+	case C.ScriptSourceTypeRemote:
+		return NewRemoteSource(ctx, logger, options)
+	default:
+		return nil, E.New("unknown source type: ", options.Source)
+	}
+}
diff --git a/script/source_local.go b/script/source_local.go
new file mode 100644
index 000000000..8006ebc0b
--- /dev/null
+++ b/script/source_local.go
@@ -0,0 +1,108 @@
+//go:build with_script
+
+package script
+
+import (
+	"context"
+	"os"
+
+	"github.com/sagernet/fswatch"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+	"github.com/sagernet/sing/service/filemanager"
+
+	"github.com/dop251/goja"
+)
+
+var _ Source = (*LocalSource)(nil)
+
+type LocalSource struct {
+	ctx     context.Context
+	logger  logger.ContextLogger
+	tag     string
+	program *lazyProgram
+	watcher *fswatch.Watcher
+}
+
+func NewLocalSource(ctx context.Context, logger logger.ContextLogger, options option.Script) (*LocalSource, error) {
+	script := &LocalSource{
+		ctx:     ctx,
+		logger:  logger,
+		tag:     options.Tag,
+		program: newLazyProgram("script:"+options.Tag, logger),
+	}
+	filePath := filemanager.BasePath(ctx, options.LocalOptions.Path)
+	err := script.reloadFile(filePath)
+	if err != nil {
+		return nil, err
+	}
+	watcher, err := fswatch.NewWatcher(fswatch.Options{
+		Path: []string{filePath},
+		Callback: func(path string) {
+			uErr := script.reloadFile(path)
+			if uErr != nil {
+				logger.Error(E.Cause(uErr, "reload script ", path))
+			}
+		},
+	})
+	if err != nil {
+		return nil, err
+	}
+	script.watcher = watcher
+	return script, nil
+}
+
+func (s *LocalSource) StartContext(ctx context.Context, startContext *adapter.HTTPStartContext) error {
+	if s.watcher != nil {
+		err := s.watcher.Start()
+		if err != nil {
+			s.logger.Error(E.Cause(err, "watch script file"))
+		}
+	}
+	return nil
+}
+
+// reloadFile validates the file before using it: a broken script fails at
+// startup, and a broken edit keeps the previous version running. The
+// compiled program is kept until it idles out.
+func (s *LocalSource) reloadFile(path string) error {
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	program, err := compileScript("script:"+s.tag, string(content))
+	if err != nil {
+		return E.Cause(err, "compile ", path)
+	}
+	reloaded := s.program.hasContent()
+	s.program.setCompiled(content, program)
+	if reloaded {
+		s.logger.Info("reloaded from ", path)
+	}
+	return nil
+}
+
+func (s *LocalSource) PostStart() error {
+	return nil
+}
+
+// Program returns the compiled script, compiling it again if it idled out;
+// see lazyProgram.
+func (s *LocalSource) Program() *goja.Program {
+	return s.program.Program()
+}
+
+func (s *LocalSource) Text() (string, string) {
+	return s.program.Text()
+}
+
+func (s *LocalSource) uncompiledLength() int {
+	return s.program.uncompiledLength()
+}
+
+func (s *LocalSource) Close() error {
+	s.program.close()
+	return s.watcher.Close()
+}
diff --git a/script/source_local_test.go b/script/source_local_test.go
