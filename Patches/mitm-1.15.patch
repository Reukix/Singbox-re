+		merged.Script = append(merged.Script[:0:0], next.Script...)
+		merged.SurgeURLRewrite = append(merged.SurgeURLRewrite[:0:0], next.SurgeURLRewrite...)
+		merged.SurgeHeaderRewrite = append(merged.SurgeHeaderRewrite[:0:0], next.SurgeHeaderRewrite...)
+		merged.SurgeBodyRewrite = append(merged.SurgeBodyRewrite[:0:0], next.SurgeBodyRewrite...)
+		merged.SurgeMapLocal = append(merged.SurgeMapLocal[:0:0], next.SurgeMapLocal...)
+		return &merged
+	}
+	merged := *current
+	merged.Enabled = current.Enabled || next.Enabled
+	merged.Print = current.Print || next.Print
+	merged.Script = append(append(merged.Script[:0:0], current.Script...), next.Script...)
+	merged.SurgeURLRewrite = append(append(merged.SurgeURLRewrite[:0:0], current.SurgeURLRewrite...), next.SurgeURLRewrite...)
+	merged.SurgeHeaderRewrite = append(append(merged.SurgeHeaderRewrite[:0:0], current.SurgeHeaderRewrite...), next.SurgeHeaderRewrite...)
+	merged.SurgeBodyRewrite = append(append(merged.SurgeBodyRewrite[:0:0], current.SurgeBodyRewrite...), next.SurgeBodyRewrite...)
+	merged.SurgeMapLocal = append(append(merged.SurgeMapLocal[:0:0], current.SurgeMapLocal...), next.SurgeMapLocal...)
+	return &merged
+}
+
