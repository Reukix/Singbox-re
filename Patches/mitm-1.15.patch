+)
+
+const bodyBufferAcquireWait = 5 * time.Second
+
+func surgePatternMatches(pattern *regexp.Regexp, requestURL, host, connectionHost string) bool {
+	if pattern.MatchString(requestURL) {
+		return true
+	}
+	if host != "" {
+		if parsed, err := url.Parse(requestURL); err == nil {
+			parsed.Host = host
+			if pattern.MatchString(parsed.String()) {
+				return true
+			}
+		}
+	}
+	if connectionHost != "" {
+		if parsed, err := url.Parse(requestURL); err == nil {
+			parsed.Host = connectionHost
+			return pattern.MatchString(parsed.String())
+		}
+	}
+	return false
+}
+
+func surgeConnectionHost(metadata adapter.InboundContext) string {
+	if metadata.ClientHello != nil {
+		return metadata.ClientHello.ServerName
+	}
+	return metadata.Domain
+}
+
+var _ adapter.MITMEngine = (*Engine)(nil)
+
+type Engine struct {
+	ctx          context.Context
+	logger       logger.ContextLogger
+	connection   adapter.ConnectionManager
+	certificate  adapter.CertificateStore
+	script       adapter.ScriptManager
+	timeFunc     func() time.Time
+	http2Enabled bool
+	limits       engineLimits
+	leaves       *leafCache
+	bodyBuffer   *semaphore.Weighted
+	upstream     *upstreamPool
+	sessions     sessionTracker
+	pressure     func() tun.MemoryPressure
+	lastSkipLog  atomic.Int64
+	done         chan struct{}
+	closeOnce    sync.Once
+}
+
+func NewEngine(ctx context.Context, logger logger.ContextLogger, options option.MITMOptions) (*Engine, error) {
+	engine := &Engine{
+		ctx:          ctx,
+		logger:       logger,
+		http2Enabled: options.HTTP2Enabled,
+		limits:       platformLimits(),
+		leaves:       newLeafCache(),
+		done:         make(chan struct{}),
+	}
+	engine.bodyBuffer = semaphore.NewWeighted(engine.limits.bodyBudget)
+	engine.upstream = newUpstreamPool(&engine.limits)
+	return engine, nil
+}
+
+// bufferBody buffers and decodes a body for rewriting, charging every retained
+// byte to the engine's body budget. denied means the budget or the memory
+// headroom refused it: the caller must forward replay untouched (fail open).
+func (e *Engine) bufferBody(ctx context.Context, hold *bodyBufferHold, body io.ReadCloser, contentLength int64, headers http.Header, limit int64) (content []byte, replay io.ReadCloser, available bool, decoded bool, denied bool, err error) {
+	if body == nil || body == http.NoBody || contentLength == 0 {
+		return []byte{}, http.NoBody, true, false, false, nil
+	}
+	if limit <= 0 {
+		limit = responseRewriteBodyLimit
+	}
+	if e.limits.maxBody > 0 {
+		limit = min(limit, e.limits.maxBody)
+	}
+	if contentLength > limit {
+		return nil, body, false, false, false, nil
+	}
+	if hold.budget == nil {
+		hold.budget = e.bodyBuffer
+	}
+	initial := initialBodyCapacity(contentLength, limit)
+	// Reading and decoding need about twice the wire size at their peak.
+	if !memguard.Admit(uint64(initial) * 2) {
+		return nil, body, false, false, true, nil
+	}
+	if !hold.acquire(ctx, initial, bodyBufferAcquireWait) {
+		return nil, body, false, false, true, nil
+	}
+	content, replay, available, decoded, denied, err = bufferHTTPBodyBudgeted(body, contentLength, headers, limit, hold, initial)
+	return content, replay, available, decoded, denied, err
+}
+
+func (e *Engine) releaseBodyBuffer(hold *bodyBufferHold) {
+	if hold.budget == nil {
+		hold.budget = e.bodyBuffer
+	}
+	hold.releaseAll()
+}
+
+func (e *Engine) Start(stage adapter.StartStage) error {
+	switch stage {
+	case adapter.StartStateInitialize:
+		e.connection = service.FromContext[adapter.ConnectionManager](e.ctx)
+		e.certificate = service.FromContext[adapter.CertificateStore](e.ctx)
+		e.script = service.FromContext[adapter.ScriptManager](e.ctx)
+		e.timeFunc = ntp.TimeFuncFromContext(e.ctx)
+		if e.timeFunc == nil {
+			e.timeFunc = time.Now
+		}
+		e.upstream.timeFunc = e.timeFunc
+		e.pressure = oomkiller.MemoryPressure(e.ctx)
+	case adapter.StartStateStart:
+		go e.loopMaintenance()
+	}
+	return nil
+}
+
+func (e *Engine) Close() error {
+	e.closeOnce.Do(func() {
+		close(e.done)
+	})
+	e.upstream.close()
+	e.sessions.closeAll()
+	e.leaves.clear()
+	return nil
+}
+
+func (e *Engine) memoryPressure() tun.MemoryPressure {
+	if e.pressure == nil {
+		return tun.MemoryPressureNone
+	}
+	return e.pressure()
+}
+
+// loopMaintenance reacts to memory pressure before the OOM killer resets the
+// whole network: at warning level idle upstream connections are dropped, at
+// critical level idle intercepted sessions too.
+func (e *Engine) loopMaintenance() {
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	var ticks int
+	lastPressure := tun.MemoryPressureNone
+	for {
+		select {
+		case <-e.done:
+			return
+		case <-e.ctx.Done():
+			return
+		case <-ticker.C:
+		}
+		ticks++
+		pressure := e.maintenancePressure()
+		if pressure != tun.MemoryPressureNone && pressure != lastPressure {
+			e.upstream.closeIdle()
+			if pressure == tun.MemoryPressureCritical {
+				closed := e.sessions.closeIdle()
+				e.logger.Warn("memory pressure critical: closed ", closed, " idle MITM sessions and idle upstream connections")
+			} else {
+				e.logger.Info("memory pressure warning: closed idle MITM upstream connections")
+			}
+		}
+		lastPressure = pressure
+		if ticks%30 == 0 {
+			e.upstream.cleanup()
+		}
+	}
+}
+
+const (
+	maintenanceWarningHeadroom  = 14 * 1024 * 1024
+	maintenanceCriticalHeadroom = 8 * 1024 * 1024
+)
+
+// maintenancePressure combines the OOM killer state with the kernel headroom.
+// The OOM killer raises critical pressure only briefly after a forced
+// release, so the headroom is what keeps this loop from missing it.
+func (e *Engine) maintenancePressure() tun.MemoryPressure {
+	pressure := e.memoryPressure()
+	if headroom, known := memguard.Headroom(); known {
+		switch {
+		case headroom < maintenanceCriticalHeadroom:
+			pressure = tun.MemoryPressureCritical
+		case headroom < maintenanceWarningHeadroom && pressure == tun.MemoryPressureNone:
+			pressure = tun.MemoryPressureWarning
+		}
+	}
+	return pressure
+}
+
+// admitSession decides whether a new connection may be intercepted. Refused
+// connections are proxied untouched: MITM features are skipped for them, but
+// the connection works and the extension stays alive.
+func (e *Engine) admitSession() (bool, string) {
+	if e.sessions.count.Load() >= e.limits.maxSessions {
+		return false, "too many MITM sessions"
+	}
+	switch e.memoryPressure() {
+	case tun.MemoryPressureWarning, tun.MemoryPressureCritical:
+		return false, "memory pressure"
+	}
+	if e.limits.sessionHeadroom > 0 && !memguard.AdmitWithHeadroom(0, e.limits.sessionHeadroom) {
+		return false, "low memory headroom"
+	}
+	return true, ""
+}
+
+func (e *Engine) logSkip(ctx context.Context, reason string) {
+	now := time.Now().UnixNano()
+	last := e.lastSkipLog.Load()
+	if now-last < int64(5*time.Second) || !e.lastSkipLog.CompareAndSwap(last, now) {
+		e.logger.DebugContext(ctx, "MITM skipped (", reason, "), passing through")
+		return
+	}
+	e.logger.WarnContext(ctx, "MITM skipped (", reason, "), passing through")
+}
+
+func (e *Engine) NewConnection(ctx context.Context, this N.Dialer, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	interceptTLS := e.certificate != nil && e.certificate.TLSDecryptionEnabled() && metadata.ClientHello != nil
+	if !interceptTLS && metadata.HTTPRequest == nil {
+		e.logger.DebugContext(ctx, "HTTP and TLS not detected, skipped")
+		e.passthrough(ctx, this, conn, metadata, onClose)
+		return
+	}
+	if interceptTLS {
+		if reason := tlsPassthroughReason(e.http2Enabled, metadata); reason != "" {
+			e.logger.DebugContext(ctx, reason)
+			e.passthrough(ctx, this, conn, metadata, onClose)
+			return
+		}
+	}
+	if admitted, reason := e.admitSession(); !admitted {
+		e.logSkip(ctx, reason)
+		e.passthrough(ctx, this, conn, metadata, onClose)
+		return
+	}
+	session := e.sessions.add(conn)
+	var err error
+	if interceptTLS {
+		err = e.newTLS(ctx, this, conn, metadata, session)
+	} else {
+		err = e.newHTTP1(ctx, this, conn, nil, metadata, session)
+	}
+	e.sessions.remove(session)
+	if err != nil {
+		e.logger.ErrorContext(ctx, err)
+	} else {
+		e.logger.DebugContext(ctx, "connection closed")
+	}
+	if onClose != nil {
+		onClose(err)
+	}
+}
+
+// passthrough proxies the connection without interception. The connection
+// manager owns it (and onClose) from here on.
+func (e *Engine) passthrough(ctx context.Context, this N.Dialer, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	metadata.MITM = nil
+	e.connection.NewConnection(ctx, this, conn, metadata, onClose)
+}
+
+// tlsPassthroughReason reports why a TLS connection cannot be intercepted,
+// decided before the handshake so the connection can still pass through.
+func tlsPassthroughReason(http2Enabled bool, metadata adapter.InboundContext) string {
+	acceptHTTP := len(metadata.ClientHello.SupportedProtos) == 0 || common.Contains(metadata.ClientHello.SupportedProtos, "http/1.1")
+	acceptH2 := http2Enabled && common.Contains(metadata.ClientHello.SupportedProtos, "h2")
+	if !acceptHTTP && !acceptH2 {
+		return "MITM skipped, unsupported application protocol: " + strings.Join(metadata.ClientHello.SupportedProtos, ",")
+	}
+	if metadata.ClientHello.ServerName == "" && metadata.Destination.AddrString() == "" {
+		return "MITM skipped because TLS server name is unavailable"
+	}
+	return ""
+}
+
+func (e *Engine) newTLS(ctx context.Context, this N.Dialer, conn net.Conn, metadata adapter.InboundContext, session *mitmSession) error {
+	acceptHTTP := len(metadata.ClientHello.SupportedProtos) == 0 || common.Contains(metadata.ClientHello.SupportedProtos, "http/1.1")
+	acceptH2 := e.http2Enabled && common.Contains(metadata.ClientHello.SupportedProtos, "h2")
+	var nextProtos []string
+	if acceptH2 {
+		nextProtos = append(nextProtos, "h2")
+	}
+	if acceptHTTP {
+		nextProtos = append(nextProtos, "http/1.1")
+	}
+	var (
+		maxVersion uint16
+		minVersion uint16
+	)
+	for _, version := range metadata.ClientHello.SupportedVersions {
+		maxVersion = common.Max(maxVersion, version)
+		if minVersion == 0 || version < minVersion {
+			minVersion = version
+		}
+	}
+	serverName := metadata.ClientHello.ServerName
+	if serverName == "" {
+		serverName = metadata.Destination.AddrString()
+	}
+	serverTLSConfig := &tls.Config{
+		Time:       e.timeFunc,
+		NextProtos: nextProtos,
+		MinVersion: minVersion,
+		MaxVersion: maxVersion,
+		GetCertificate: func(info *tls.ClientHelloInfo) (*tls.Certificate, error) {
+			certificateName := info.ServerName
+			if certificateName == "" {
+				certificateName = serverName
+			}
+			return e.leafCertificate(certificateName)
+		},
+	}
+	tlsConn := tls.Server(conn, serverTLSConfig)
+	err := tlsConn.HandshakeContext(ctx)
+	if err != nil {
+		return E.Cause(err, "TLS handshake failed for ", metadata.ClientHello.ServerName, ", ", strings.Join(metadata.ClientHello.SupportedProtos, ", "))
+	}
+	upstreamTLSConfig := &tls.Config{
+		Time:       e.timeFunc,
+		ServerName: serverName,
+		MinVersion: minVersion,
+		MaxVersion: maxVersion,
+	}
+	if tlsConn.ConnectionState().NegotiatedProtocol == "h2" {
+		return e.newHTTP2(ctx, this, tlsConn, upstreamTLSConfig, metadata, session)
+	} else {
+		return e.newHTTP1(ctx, this, tlsConn, upstreamTLSConfig, metadata, session)
+	}
+}
+
+func (e *Engine) leafCertificate(serverName string) (*tls.Certificate, error) {
+	return e.leaves.get(serverName, e.timeFunc(), e.certificate.TLSDecryptionCertificate(), e.certificate.TLSDecryptionPrivateKey())
+}
+
+// rewriteBody applies one body_rewrite rule, charging the rewritten copies to
+// hold. It returns false when the rule was skipped; the body then stays as is.
+func (e *Engine) rewriteBody(ctx context.Context, hold *bodyBufferHold, body []byte, rule *option.SurgeBodyRewriteLine, limit int64, kind string) ([]byte, bool) {
+	if rule.JQ {
+		// Decoding JSON into a tree costs several times the text size.
+		working := int64(len(body)) * jqWorkingSetFactor
+		if !memguard.Admit(uint64(working)) || !hold.tryGrow(working) {
+			e.logger.WarnContext(ctx, "jq body rewrite skipped: body buffer budget exhausted")
+			return body, false
+		}
+		rewrittenBody, jqErr := applyJQBodyRewrite(ctx, body, rule, limit)
+		hold.releasePart(working)
+		if jqErr != nil {
+			e.logger.WarnContext(ctx, "jq body rewrite skipped: ", jqErr)
+			return body, false
+		}
+		if !hold.tryGrow(int64(cap(rewrittenBody))) {
+			e.logger.WarnContext(ctx, "jq body rewrite skipped: body buffer budget exhausted")
+			return body, false
+		}
+		hold.releasePart(int64(cap(body)))
+		return rewrittenBody, true
+	}
+	if !utf8.Valid(body) {
+		e.logger.WarnContext(ctx, "body replace skipped because ", kind, " body is not valid UTF-8")
+		return body, false
+	}
+	for mi := 0; mi < len(rule.Match); mi++ {
+		estimate := int64(len(body)) + int64(len(rule.Replace[mi])) + 4096
+		if !hold.tryGrow(estimate) {
+			e.logger.WarnContext(ctx, "body replace skipped: body buffer budget exhausted")
+			return body, mi > 0
+		}
+		rewrittenBody := rule.Match[mi].ReplaceAll(body, []byte(rule.Replace[mi]))
+		if extra := int64(cap(rewrittenBody)) - estimate; extra > 0 {
+			if !hold.tryGrow(extra) {
+				hold.releasePart(estimate)
+				e.logger.WarnContext(ctx, "body replace skipped: body buffer budget exhausted")
+				return body, mi > 0
+			}
+		} else {
+			hold.releasePart(-extra)
+		}
+		hold.releasePart(int64(cap(body)))
+		body = rewrittenBody
+	}
+	return body, true
+}
+
+// jqWorkingSetFactor approximates gojq's decoded tree size per body byte.
+const jqWorkingSetFactor = 8
+
+var errHTTP1KeepAlive = errors.New("continue HTTP/1 connection")
+
+// exchange sends request upstream through the shared transport for this
+// dialer and TLS configuration. release must be called after the response
+// body is closed.
+func (e *Engine) exchange(ctx context.Context, this N.Dialer, tlsConfig *tls.Config, http2Allowed bool, request *http.Request) (*http.Response, func(), error) {
+	var destination M.Socksaddr
+	if metadata := adapter.ContextFrom(ctx); metadata != nil {
+		destination = metadata.Destination
+	}
+	key, poolable := upstreamKeyFor(this, destination, tlsConfig, http2Allowed)
+	var (
+		transport *http.Transport
+		release   func()
+	)
+	if poolable {
+		pooled, err := e.upstream.acquire(key, this)
+		if err != nil {
+			return nil, nil, E.Cause(err, "prepare upstream transport")
+		}
+		transport = pooled.transport
+		release = func() { e.upstream.release(pooled) }
+	} else {
+		oneOff, err := e.upstream.newTransport(key, this)
+		if err != nil {
+			return nil, nil, E.Cause(err, "prepare upstream transport")
+		}
+		transport = oneOff
+		release = oneOff.CloseIdleConnections
+	}
+	client := &http.Client{
+		Transport: transport,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+	response, err := client.Do(request.WithContext(ctx))
+	if err != nil {
+		release()
+		return nil, nil, E.Cause(err, "exchange request")
+	}
+	return response, release, nil
+}
+
+func (e *Engine) newHTTP1(ctx context.Context, this N.Dialer, conn net.Conn, tlsConfig *tls.Config, metadata adapter.InboundContext, session *mitmSession) error {
+	defer conn.Close()
+	reader := bufio.NewReader(conn)
+	for {
+		requestTLSConfig := tlsConfig
+		if requestTLSConfig != nil {
+			requestTLSConfig = requestTLSConfig.Clone()
+		}
+		err := e.handleHTTP1(ctx, this, conn, reader, requestTLSConfig, metadata, session)
+		switch {
+		case errors.Is(err, errHTTP1KeepAlive):
+			continue
+		case errors.Is(err, io.EOF), errors.Is(err, net.ErrClosed):
+			return nil
+		default:
+			return err
+		}
+	}
+}
+
+func (e *Engine) handleHTTP1(ctx context.Context, this N.Dialer, conn net.Conn, reader *bufio.Reader, tlsConfig *tls.Config, metadata adapter.InboundContext, session *mitmSession) error {
+	options := metadata.MITM
+	// Bound the wait for the next keep-alive request so parked connections
+	// release their TLS and read buffers.
+	if e.limits.http1IdleTimeout > 0 {
+		_ = conn.SetReadDeadline(time.Now().Add(e.limits.http1IdleTimeout))
+	}
+	request, err := badhttp.ReadRequest(reader)
+	if err != nil {
