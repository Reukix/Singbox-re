--- /dev/null
+++ b/script/source_local.go
@@ -0,0 +1,98 @@
+//go:build with_script
+
+package script
+
+import (
+	"context"
+	"os"
+	"sync"
+
+	"github.com/sagernet/fswatch"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+	"github.com/sagernet/sing/service/filemanager"
+
+	"github.com/dop251/goja"
+)
+
+var _ Source = (*LocalSource)(nil)
+
+type LocalSource struct {
+	ctx     context.Context
+	logger  logger.ContextLogger
+	tag     string
+	program *goja.Program
+	watcher *fswatch.Watcher
+	access  sync.RWMutex
+}
+
+func NewLocalSource(ctx context.Context, logger logger.ContextLogger, options option.Script) (*LocalSource, error) {
+	script := &LocalSource{
+		ctx:    ctx,
+		logger: logger,
+		tag:    options.Tag,
+	}
+	filePath := filemanager.BasePath(ctx, options.LocalOptions.Path)
+	err := script.reloadFile(filePath)
+	if err != nil {
+		return nil, err
+	}
+	watcher, err := fswatch.NewWatcher(fswatch.Options{
+		Path: []string{filePath},
+		Callback: func(path string) {
+			uErr := script.reloadFile(path)
+			if uErr != nil {
+				logger.Error(E.Cause(uErr, "reload script ", path))
+			}
+		},
+	})
+	if err != nil {
+		return nil, err
+	}
+	script.watcher = watcher
+	return script, nil
+}
+
+func (s *LocalSource) StartContext(ctx context.Context, startContext *adapter.HTTPStartContext) error {
+	if s.watcher != nil {
+		err := s.watcher.Start()
+		if err != nil {
+			s.logger.Error(E.Cause(err, "watch script file"))
+		}
+	}
+	return nil
+}
+
+func (s *LocalSource) reloadFile(path string) error {
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	program, err := compileScript("script:"+s.tag, string(content))
+	if err != nil {
+		return E.Cause(err, "compile ", path)
+	}
+	s.access.Lock()
+	defer s.access.Unlock()
+	if s.program != nil {
+		s.logger.Info("reloaded from ", path)
+	}
+	s.program = program
+	return nil
+}
+
+func (s *LocalSource) PostStart() error {
+	return nil
+}
+
+func (s *LocalSource) Program() *goja.Program {
+	s.access.RLock()
+	defer s.access.RUnlock()
+	return s.program
+}
+
+func (s *LocalSource) Close() error {
+	return s.watcher.Close()
+}
diff --git a/script/source_remote.go b/script/source_remote.go
new file mode 100644
index 000000000..29233c744
--- /dev/null
+++ b/script/source_remote.go
@@ -0,0 +1,299 @@
+//go:build with_script
+
+package script
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+	"runtime"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/experimental/deprecated"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	F "github.com/sagernet/sing/common/format"
+	"github.com/sagernet/sing/common/logger"
+	"github.com/sagernet/sing/service"
+	"github.com/sagernet/sing/service/pause"
+
+	"github.com/dop251/goja"
+)
+
+var _ Source = (*RemoteSource)(nil)
+
+type RemoteSource struct {
+	ctx            context.Context
+	cancel         context.CancelFunc
+	logger         logger.ContextLogger
+	options        option.Script
+	updateInterval time.Duration
+	httpClient     *http.Client
+	program        *goja.Program
+	content        []byte
+	programTimer   *time.Timer
+	compileAccess  sync.Mutex
+	lastUpdated    time.Time
+	lastEtag       string
+	updateTicker   *time.Ticker
+	cacheFile      adapter.CacheFile
+	pauseManager   pause.Manager
+	access         sync.RWMutex
+}
+
+func NewRemoteSource(ctx context.Context, logger logger.ContextLogger, options option.Script) (*RemoteSource, error) {
+	ctx, cancel := context.WithCancel(ctx)
+	var updateInterval time.Duration
+	if options.RemoteOptions.UpdateInterval > 0 {
+		updateInterval = time.Duration(options.RemoteOptions.UpdateInterval)
+	} else {
+		updateInterval = 24 * time.Hour
+	}
+	return &RemoteSource{
+		ctx:            ctx,
+		cancel:         cancel,
+		logger:         logger,
+		options:        options,
+		updateInterval: updateInterval,
+		pauseManager:   service.FromContext[pause.Manager](ctx),
+	}, nil
+}
+
+func (s *RemoteSource) StartContext(ctx context.Context, startContext *adapter.HTTPStartContext) error {
+	s.cacheFile = service.FromContext[adapter.CacheFile](s.ctx)
+	if s.cacheFile != nil {
+		if savedSet := s.cacheFile.LoadScript(s.options.Tag); savedSet != nil {
+			err := s.loadBytes(savedSet.Content)
+			if err != nil {
+				s.logger.Error(E.Cause(err, "restore cached script; fetching a fresh copy"))
+			} else {
+				s.lastUpdated = savedSet.LastUpdated
+				s.lastEtag = savedSet.LastEtag
+			}
+		}
+	}
+	transport, err := s.resolveTransport()
+	if err != nil {
+		s.logger.Error(E.Cause(err, "create script http client; remote script disabled until restart"))
+		s.updateTicker = time.NewTicker(s.updateInterval)
+		return nil
+	}
+	startContext.Register(transport)
+	s.httpClient = &http.Client{Transport: transport}
+	if s.lastUpdated.IsZero() {
+		err := s.fetchOnce(ctx)
+		if err != nil {
+			s.logger.Error(E.Cause(err, "initial script fetch failed open: ", s.options.Tag))
+		}
+	}
+	s.updateTicker = time.NewTicker(s.updateInterval)
+	return nil
+}
+
+func (s *RemoteSource) PostStart() error {
+	go s.loopUpdate()
+	return nil
+}
+
+func (s *RemoteSource) Program() *goja.Program {
+	s.access.RLock()
+	program := s.program
+	content := bytes.Clone(s.content)
+	s.access.RUnlock()
+	if program != nil {
+		s.armProgramExpiry(program)
+		return program
+	}
+	if len(content) == 0 {
+		return nil
+	}
+
+	// Remote scripts are often large (Script Hub's frontend is hundreds of
+	// KiB). Compile only when the rule is actually hit, then evict the Program
+	// after an idle period so inactive scripts do not consume the 50 MiB
+	// Network Extension budget forever.
+	s.compileAccess.Lock()
+	defer s.compileAccess.Unlock()
+	s.access.RLock()
+	program = s.program
+	s.access.RUnlock()
+	if program != nil {
+		s.armProgramExpiry(program)
+		return program
+	}
+	program, err := compileScript(F.ToString("script:", s.options.Tag), string(content))
+	if err != nil {
+		s.logger.Error(E.Cause(err, "compile remote script ", s.options.Tag))
+		return nil
+	}
+	s.access.Lock()
+	if bytes.Equal(content, s.content) {
+		s.program = program
+	}
+	s.access.Unlock()
+	s.armProgramExpiry(program)
+	return program
+}
+
+func (s *RemoteSource) loadBytes(content []byte) error {
+	s.access.Lock()
+	if s.programTimer != nil {
+		s.programTimer.Stop()
+		s.programTimer = nil
+	}
+	s.content = bytes.Clone(content)
+	s.program = nil
+	s.access.Unlock()
+	return nil
+}
+
+const remoteProgramIdleDuration = 5 * time.Minute
+
+func (s *RemoteSource) armProgramExpiry(program *goja.Program) {
+	s.access.Lock()
+	if s.program != program {
+		s.access.Unlock()
+		return
+	}
+	if s.programTimer != nil {
+		s.programTimer.Stop()
+	}
+	s.programTimer = time.AfterFunc(remoteProgramIdleDuration, func() {
+		s.access.Lock()
+		if s.program == program {
+			s.program = nil
+		}
+		s.programTimer = nil
+		s.access.Unlock()
+		runtime.GC()
+	})
+	s.access.Unlock()
+}
+
+func (s *RemoteSource) loopUpdate() {
+	if time.Since(s.lastUpdated) > s.updateInterval {
+		err := s.fetchOnce(s.ctx)
+		if err != nil {
+			s.logger.Error("fetch rule-set ", s.options.Tag, ": ", err)
+		}
+	}
+	for {
+		runtime.GC()
+		select {
+		case <-s.ctx.Done():
+			return
+		case <-s.updateTicker.C:
+			if s.pauseManager != nil {
+				s.pauseManager.WaitActive()
+			}
+			err := s.fetchOnce(s.ctx)
+			if err != nil {
+				s.logger.Error("fetch rule-set ", s.options.Tag, ": ", err)
+			}
+		}
+	}
+}
+
+func (s *RemoteSource) resolveTransport() (adapter.HTTPTransport, error) {
+	httpClientManager := service.FromContext[adapter.HTTPClientManager](s.ctx)
+	if s.options.RemoteOptions.DownloadDetour != "" { //nolint:staticcheck
+		deprecated.Report(s.ctx, deprecated.OptionLegacyRuleSetDownloadDetour)
+		return httpClientManager.ResolveTransport(s.ctx, s.logger, option.HTTPClientOptions{
+			DialerOptions: option.DialerOptions{
+				Detour: s.options.RemoteOptions.DownloadDetour, //nolint:staticcheck
+			},
+			DisableEmptyDirectCheck: true,
+		})
+	}
+	defaultTransport := httpClientManager.DefaultTransport()
+	if defaultTransport == nil {
+		return nil, E.New("default http client transport is not initialized")
+	}
+	return defaultTransport, nil
+}
+
+func (s *RemoteSource) fetchOnce(ctx context.Context) error {
+	s.logger.Debug("updating script ", s.options.Tag, " from URL: ", s.options.RemoteOptions.URL)
+	httpClient := s.httpClient
+	if httpClient == nil {
+		return E.New("script HTTP client is unavailable")
+	}
+	request, err := http.NewRequest("GET", s.options.RemoteOptions.URL, nil)
+	if err != nil {
+		return err
+	}
+	if s.lastEtag != "" {
+		request.Header.Set("If-None-Match", s.lastEtag)
+	}
+	request.Header.Set("User-Agent", "sing-box Script Loader")
+	request.Header.Set("Accept", "application/javascript, text/javascript, text/plain, */*")
+	response, err := httpClient.Do(request.WithContext(ctx))
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close()
+	switch response.StatusCode {
+	case http.StatusOK:
+	case http.StatusNotModified:
+		s.lastUpdated = time.Now()
+		if s.cacheFile != nil {
+			savedRuleSet := s.cacheFile.LoadScript(s.options.Tag)
+			if savedRuleSet != nil {
+				savedRuleSet.LastUpdated = s.lastUpdated
+				err = s.cacheFile.SaveScript(s.options.Tag, savedRuleSet)
+				if err != nil {
+					s.logger.Error("save script updated time: ", err)
+					return nil
+				}
+			}
+		}
+		s.logger.Info("update script ", s.options.Tag, ": not modified")
+		return nil
+	default:
+		return E.New("unexpected status: ", response.Status)
+	}
+	content, err := io.ReadAll(response.Body)
+	if err != nil {
+		return err
+	}
+	err = s.loadBytes(content)
+	if err != nil {
+		return err
+	}
+	eTagHeader := response.Header.Get("Etag")
+	if eTagHeader != "" {
+		s.lastEtag = eTagHeader
+	}
+	s.lastUpdated = time.Now()
+	if s.cacheFile != nil {
+		err = s.cacheFile.SaveScript(s.options.Tag, &adapter.SavedBinary{
+			LastUpdated: s.lastUpdated,
+			Content:     content,
+			LastEtag:    s.lastEtag,
+		})
+		if err != nil {
+			s.logger.Error("save script cache: ", err)
+		}
+	}
+	s.logger.Info("updated script ", s.options.Tag)
+	return nil
+}
+
+func (s *RemoteSource) Close() error {
+	if s.updateTicker != nil {
+		s.updateTicker.Stop()
+	}
+	s.access.Lock()
+	if s.programTimer != nil {
+		s.programTimer.Stop()
+		s.programTimer = nil
+	}
+	s.program = nil
+	s.content = nil
+	s.access.Unlock()
+	s.cancel()
+	return nil
+}
