diff --git a/script/memory.go b/script/memory.go
new file mode 100644
index 000000000..11c30db82
--- /dev/null
+++ b/script/memory.go
@@ -0,0 +1,54 @@
+//go:build with_script
+
+package script
+
+import (
+	"context"
+	"runtime/debug"
+
+	"github.com/sagernet/sing-box/common/memguard"
+	C "github.com/sagernet/sing-box/constant"
+)
+
+// Measured goja costs (arm64, GOGC=50 with a 40 MiB soft limit, as in the iOS
+// Network Extension): JSON.parse, a filter and JSON.stringify on a body peak
+// at 16-35 times its size (1 MiB -> +20.6 MiB); a fresh runtime that
+// re-initializes a bundled library such as protobufjs costs about 2.7 MiB.
+// Compiling costs about as much per source byte: Spotify-proto.js (396 KiB,
+// bundles protobufjs) peaked at +8 MiB.
+const (
+	gojaBaseCost          uint64 = 4 * 1024 * 1024
+	gojaBodyCostFactor    uint64 = 20
+	gojaCompileCostFactor uint64 = 20
+	largeScriptBodyLength        = 256 * 1024
+)
+
+// surgeScriptConcurrency bounds parallel goja runs. A run holds its slot while
+// it waits for $httpClient, so one slot would make every other scripted
+// request wait behind it; the memory of parallel runs is bounded by the
+// per-run admission instead (two runs on 1 MiB bodies would need 33 MiB).
+func surgeScriptConcurrency() int {
+	return 2
+}
+
+// gojaScriptCost estimates a run on bodyLength bytes; compileLength is the
+// source length when the script still has to be compiled.
+func gojaScriptCost(bodyLength int, compileLength int) uint64 {
+	return gojaBaseCost + uint64(bodyLength)*gojaBodyCostFactor + uint64(compileLength)*gojaCompileCostFactor
+}
+
+// acquireGojaScript admits a goja run on bodyLength bytes and reserves its
+// memory until release; parallel runs wait for each other instead of all
+// counting on the same headroom. A refused script is skipped and the message
+// forwarded unchanged instead of risking a jetsam kill.
+func acquireGojaScript(ctx context.Context, bodyLength int, compileLength int) (release func(), ok bool) {
+	return memguard.Acquire(ctx, gojaScriptCost(bodyLength, compileLength))
+}
+
+// releaseScriptMemory hands a large run's garbage back to the OS right away,
+// so the footprint does not stay at the run's high-water mark on iOS.
+func releaseScriptMemory(bodyLength int) {
+	if C.IsIos && bodyLength >= largeScriptBodyLength {
+		debug.FreeOSMemory()
+	}
+}
diff --git a/script/memory_test.go b/script/memory_test.go
new file mode 100644
index 000000000..815c16b24
--- /dev/null
+++ b/script/memory_test.go
@@ -0,0 +1,77 @@
+//go:build with_script
+
+package script
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/common/memguard"
+	"github.com/sagernet/sing-box/log"
+)
+
+func TestSurgeResponseScriptSkippedWithoutHeadroom(t *testing.T) {
+	script := newTestSurgeScript(t, `$done({ body: "changed" });`)
+	request, err := http.NewRequest(http.MethodGet, "https://example.com/feed", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body := bytes.Repeat([]byte("a"), 512*1024)
+	response := &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(bytes.NewReader(body))}
+
+	// 512 KiB needs ~14 MiB of goja memory plus the reserve; 12 MiB is not enough.
+	memguard.SetHeadroomFunc(func() (uint64, bool) { return 12 * 1024 * 1024, true })
+	defer memguard.SetHeadroomFunc(nil)
+	result, err := script.ExecuteHTTPResponse(context.Background(), time.Second, request, response, body, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Body != nil {
+		t.Fatal("script ran without enough memory headroom")
+	}
+
+	memguard.SetHeadroomFunc(func() (uint64, bool) { return 64 * 1024 * 1024, true })
+	result, err = script.ExecuteHTTPResponse(context.Background(), time.Second, request, response, body, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(result.Body) != "changed" {
+		t.Fatalf("script did not run with enough headroom: %q", result.Body)
+	}
+}
+
+func TestGojaAdmissionCountsCompileCost(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	logger := log.NewNOPFactory().NewLogger("test")
+	source := &RemoteSource{ctx: ctx, cancel: cancel, logger: logger, program: newLazyProgram("big.js", logger)}
+	defer source.Close()
+	// A large bundle that is not compiled yet, like Spotify-proto.js.
+	padding := "/*" + strings.Repeat("x", 400*1024) + "*/"
+	_ = source.loadBytes([]byte(padding + `$done({ body: "ran" });`))
+	script := &SurgeScript{tag: "big", logger: logger, source: source}
+	request, _ := http.NewRequest(http.MethodGet, "https://example.com/feed", nil)
+	body := []byte(`{}`)
+	response := &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(bytes.NewReader(body))}
+
+	// Enough to run on the body, not enough to compile 400 KiB first.
+	memguard.SetHeadroomFunc(func() (uint64, bool) { return memguard.Reserve + gojaScriptCost(len(body), 0) + 1024*1024, true })
+	defer memguard.SetHeadroomFunc(nil)
+	result, err := script.ExecuteHTTPResponse(context.Background(), time.Second, request, response, body, false, false, nil)
+	if err != nil || result.Body != nil {
+		t.Fatalf("compiled a large script without room for it: %q %v", result.Body, err)
+	}
+	memguard.SetHeadroomFunc(func() (uint64, bool) { return 64 * 1024 * 1024, true })
+	result, err = script.ExecuteHTTPResponse(context.Background(), time.Second, request, response, body, false, false, nil)
+	if err != nil || string(result.Body) != "ran" {
+		t.Fatalf("script did not run with enough headroom: %q %v", result.Body, err)
+	}
+	if source.uncompiledLength() != 0 {
+		t.Fatal("compiled program not kept")
+	}
+}
