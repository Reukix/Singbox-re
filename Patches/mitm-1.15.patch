+}
+
+func (r *logRing) dropOldest() {
+	oldest := r.entries[r.head]
+	r.entries[r.head] = nil
+	r.head = (r.head + 1) % r.maxLines
+	r.count--
+	if oldest != nil {
+		r.bytes -= len(oldest.Message)
