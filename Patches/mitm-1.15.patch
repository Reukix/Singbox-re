new file mode 100644
index 000000000..019f165ff
--- /dev/null
+++ b/script/source_remote_test.go
@@ -0,0 +1,87 @@
+//go:build with_script
+
+package script
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+)
+
+func newTestRemoteSource(t *testing.T, url string, client *http.Client) *RemoteSource {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	logger := log.NewNOPFactory().NewLogger("test")
+	var options option.Script
+	options.Tag = "remote"
+	options.RemoteOptions.URL = url
+	source := &RemoteSource{
+		ctx:            ctx,
+		cancel:         cancel,
+		logger:         logger,
+		options:        options,
+		updateInterval: 24 * time.Hour,
+		httpClient:     client,
+		program:        newLazyProgram("remote.js", logger),
+	}
+	t.Cleanup(func() { _ = source.Close() })
+	return source
+}
+
+func TestRemoteSourcesShareOneDownload(t *testing.T) {
+	var requests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		requests.Add(1)
+		time.Sleep(100 * time.Millisecond)
+		_, _ = writer.Write([]byte(`$done({});`))
+	}))
+	defer server.Close()
+	sources := make([]*RemoteSource, 12)
+	for index := range sources {
+		sources[index] = newTestRemoteSource(t, server.URL+"/shared.js", server.Client())
+	}
+	var group sync.WaitGroup
+	for _, source := range sources {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			if err := source.fetchOnce(context.Background()); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	group.Wait()
+	if requests.Load() != 1 {
+		t.Fatalf("12 entries of one URL made %d downloads", requests.Load())
+	}
+	for _, source := range sources {
+		if text, _ := source.Text(); text != `$done({});` {
+			t.Fatalf("entry missing the shared script: %q", text)
+		}
+	}
+}
+
+func TestRemoteSourceDoesNotRefetchRightAfterFailure(t *testing.T) {
+	var requests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		requests.Add(1)
+		writer.WriteHeader(http.StatusForbidden)
+	}))
+	defer server.Close()
+	source := newTestRemoteSource(t, server.URL+"/blocked.js", server.Client())
+	if err := source.fetchOnce(context.Background()); err == nil {
+		t.Fatal("403 accepted")
+	}
+	go source.loopUpdate()
+	time.Sleep(200 * time.Millisecond)
+	if requests.Load() != 1 {
+		t.Fatalf("failed script downloaded %d times right after the start", requests.Load())
+	}
+}
diff --git a/service/oomkiller/network_extension.go b/service/oomkiller/network_extension.go
new file mode 100644
index 000000000..a53af6d8e
--- /dev/null
+++ b/service/oomkiller/network_extension.go
@@ -0,0 +1,142 @@
+package oomkiller
+
+import (
+	"math"
+	runtimeDebug "runtime/debug"
+	"runtime/metrics"
+	"time"
+)
+
+const (
+	// networkExtensionMaxInterval replaces the 10 s idle poll: a single MITM
+	// script run can add 20 MiB within milliseconds, and one footprint sample
+	// per second costs next to nothing.
+	networkExtensionMaxInterval = time.Second
+	// growthReleaseInterval spaces out forced releases during sustained growth.
+	growthReleaseInterval = 2 * time.Second
+	// growthFastPollDuration keeps sampling at the minimum interval after a
+	// growth burst was detected.
+	growthFastPollDuration = 3 * time.Second
+	runtimeLimitFloor      = 16 * 1024 * 1024
+	runtimeLimitStep       = 1024 * 1024
+)
+
+// extensionTuner holds the Network Extension specific state of the timer.
+type extensionTuner struct {
+	previous       memorySample
+	previousAt     time.Time
+	lastRelease    time.Time
+	fastPollUntil  time.Time
+	runtimeLimit   int64
+	runtimeSamples []metrics.Sample
+}
+
+// normalizeNetworkExtensionSample derives usage from the kernel's remaining
+// headroom when that implies more usage than phys_footprint does. The jetsam
+// limit is per device model and may be below the assumed 50 MiB; the kernel
+// headroom always reflects the real one.
+func normalizeNetworkExtensionSample(sample memorySample, memoryLimit uint64) memorySample {
+	if !sample.availableKnown || sample.available == 0 || memoryLimit == 0 {
+		return sample
+	}
+	if sample.available < memoryLimit {
+		implied := memoryLimit - sample.available
+		if implied > sample.usage {
+			sample.usage = implied
+		}
+	} else {
+		// More headroom than the whole assumed limit: usage stays as measured.
+		return sample
+	}
+	return sample
+}
+
+// growthCritical reports whether the growth since the previous sample would
+// cross trigger within lookahead. It runs on every poll, not only after a
+// pressure notification, because the notification arrives once at 80%.
+func (x *extensionTuner) growthCritical(sample memorySample, now time.Time, trigger uint64, lookahead time.Duration) bool {
+	previous, previousAt := x.previous, x.previousAt
+	x.previous, x.previousAt = sample, now
+	if previousAt.IsZero() || trigger == 0 || sample.usage >= trigger || sample.usage <= previous.usage {
+		return false
+	}
+	elapsed := now.Sub(previousAt).Seconds()
+	if elapsed <= 0 {
+		return false
+	}
+	ratePerSecond := float64(sample.usage-previous.usage) / elapsed
+	secondsUntilTrigger := float64(trigger-sample.usage) / ratePerSecond
+	return secondsUntilTrigger < lookahead.Seconds()
+}
+
+func (x *extensionTuner) startFastPolling(now time.Time) {
+	x.fastPollUntil = now.Add(growthFastPollDuration)
+}
+
+func (x *extensionTuner) fastPolling(now time.Time) bool {
+	return now.Before(x.fastPollUntil)
+}
+
+func (x *extensionTuner) shouldRelease(now time.Time) bool {
+	if now.Sub(x.lastRelease) < growthReleaseInterval {
+		return false
+	}
+	x.lastRelease = now
+	return true
+}
+
+// tuneRuntimeLimit keeps the Go soft limit plus everything Go does not manage
+// (Swift, Network Extension frameworks, WebKit client objects, C
+// allocations) at ceiling. A fixed GOMEMLIMIT only covers Go's own memory, so
+// the process could reach ceiling + non-Go memory before the Go collector
+// reacted at all.
+func (x *extensionTuner) tuneRuntimeLimit(sample memorySample, ceiling uint64) {
+	if ceiling == 0 || sample.usage == 0 {
+		return
+	}
+	if x.runtimeSamples == nil {
+		x.runtimeSamples = []metrics.Sample{
+			{Name: "/memory/classes/total:bytes"},
+			{Name: "/memory/classes/heap/released:bytes"},
+		}
+	}
+	metrics.Read(x.runtimeSamples)
+	if x.runtimeSamples[0].Value.Kind() != metrics.KindUint64 || x.runtimeSamples[1].Value.Kind() != metrics.KindUint64 {
+		return
+	}
+	goMapped := x.runtimeSamples[0].Value.Uint64() - x.runtimeSamples[1].Value.Uint64()
+	var nonGo uint64
+	if sample.usage > goMapped {
+		nonGo = sample.usage - goMapped
+	}
+	target := int64(runtimeLimitFloor)
+	if ceiling > nonGo {
+		target = max(int64(ceiling-nonGo), runtimeLimitFloor)
+	}
+	target = min(target, int64(ceiling))
+	if x.runtimeLimit != 0 && absInt64(target-x.runtimeLimit) < runtimeLimitStep {
+		return
+	}
+	runtimeDebug.SetMemoryLimit(target)
+	x.runtimeLimit = target
+}
+
+// restoreRuntimeLimit puts back the static limit set at setup.
+func (x *extensionTuner) restoreRuntimeLimit(ceiling uint64) {
+	if x.runtimeLimit == 0 {
+		return
+	}
+	if ceiling == 0 {
+		runtimeDebug.SetMemoryLimit(math.MaxInt64)
+	} else {
+		runtimeDebug.SetMemoryLimit(int64(ceiling))
+	}
+	x.runtimeLimit = 0
+}
+
+func absInt64(value int64) int64 {
+	if value < 0 {
+		return -value
+	}
+	return value
+}
diff --git a/service/oomkiller/network_extension_test.go b/service/oomkiller/network_extension_test.go
new file mode 100644
index 000000000..885eaca4d
--- /dev/null
+++ b/service/oomkiller/network_extension_test.go
@@ -0,0 +1,80 @@
+package oomkiller
+
+import (
+	"math"
+	runtimeDebug "runtime/debug"
+	"testing"
+	"time"
+)
+
+const mib = 1024 * 1024
+
+func TestNormalizeNetworkExtensionSample(t *testing.T) {
+	sample := normalizeNetworkExtensionSample(memorySample{usage: 20 * mib, available: 20 * mib, availableKnown: true}, 50*mib)
+	if sample.usage != 30*mib {
+		t.Fatalf("a lower real limit must raise usage to 30 MiB, got %d", sample.usage/mib)
+	}
+	sample = normalizeNetworkExtensionSample(memorySample{usage: 20 * mib, available: 35 * mib, availableKnown: true}, 50*mib)
+	if sample.usage != 20*mib {
+		t.Fatalf("usage must never drop below phys_footprint, got %d", sample.usage/mib)
+	}
+	sample = normalizeNetworkExtensionSample(memorySample{usage: 20 * mib}, 50*mib)
+	if sample.usage != 20*mib {
+		t.Fatal("unknown headroom changed usage")
+	}
+}
+
+func TestGrowthCritical(t *testing.T) {
+	var tuner extensionTuner
+	now := time.Now()
+	if tuner.growthCritical(memorySample{usage: 30 * mib}, now, 45*mib, time.Second) {
+		t.Fatal("first sample has no rate")
+	}
+	// +10 MiB in 500 ms: 5 MiB left at 20 MiB/s crosses within the second.
+	if !tuner.growthCritical(memorySample{usage: 40 * mib}, now.Add(500*time.Millisecond), 45*mib, time.Second) {
+		t.Fatal("fast growth not detected")
+	}
+	// +1 MiB per second with 4 MiB left: fine.
+	if tuner.growthCritical(memorySample{usage: 41 * mib}, now.Add(1500*time.Millisecond), 45*mib, time.Second) {
+		t.Fatal("slow growth flagged")
+	}
+	if !tuner.shouldRelease(now) || tuner.shouldRelease(now.Add(time.Second)) || !tuner.shouldRelease(now.Add(3*time.Second)) {
+		t.Fatal("release spacing not applied")
+	}
+}
+
+func TestTuneRuntimeLimitSubtractsNonGoMemory(t *testing.T) {
+	previous := runtimeDebug.SetMemoryLimit(-1)
+	defer runtimeDebug.SetMemoryLimit(previous)
+	var tuner extensionTuner
+	// A footprint far above what Go maps means lots of non-Go memory, so Go
+	// gets the floor.
+	tuner.tuneRuntimeLimit(memorySample{usage: 1 << 40}, 40*mib)
+	if limit := runtimeDebug.SetMemoryLimit(-1); limit != runtimeLimitFloor {
+		t.Fatalf("limit %d MiB, want the floor", limit/mib)
+	}
+	// A footprint below Go's own mapping means no non-Go memory: the ceiling.
+	tuner.tuneRuntimeLimit(memorySample{usage: 1}, 40*mib)
+	if limit := runtimeDebug.SetMemoryLimit(-1); limit != 40*mib {
+		t.Fatalf("limit %d MiB, want 40", limit/mib)
+	}
+	tuner.restoreRuntimeLimit(0)
+	if limit := runtimeDebug.SetMemoryLimit(-1); limit != math.MaxInt64 {
+		t.Fatal("restore did not reset the limit")
+	}
+}
+
+func TestFastPollingWindow(t *testing.T) {
+	var tuner extensionTuner
+	now := time.Now()
+	if tuner.fastPolling(now) {
+		t.Fatal("fast polling before any growth burst")
