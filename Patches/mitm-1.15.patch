+		t.Fatalf("unexpected timer result: %q", result.Body)
+	}
+}
+
+func TestSurgeScriptHTTPClient(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		_, _ = writer.Write([]byte("async-ok"))
+	}))
+	defer server.Close()
+
+	script := newTestSurgeScript(t, `$httpClient.get({ url: "`+server.URL+`" }, (error, response, body) => {
+		if (error) throw new Error(error);
+		$done({ body });
+	});`)
+	request, err := http.NewRequest(http.MethodGet, "https://example.com/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := script.ExecuteHTTPRequest(context.Background(), 3*time.Second, request, nil, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(result.Body) != "async-ok" {
+		t.Fatalf("unexpected HTTP client result: %q", result.Body)
+	}
+}
+
+func TestSurgeScriptBodyBytesResult(t *testing.T) {
+	script := newTestSurgeScript(t, `$done({ bodyBytes: new Uint8Array([1, 2, 3]) });`)
+	request, err := http.NewRequest(http.MethodGet, "https://example.com/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := script.ExecuteHTTPRequest(context.Background(), time.Second, request, nil, true, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(result.Body) != 3 || result.Body[0] != 1 || result.Body[2] != 3 {
+		t.Fatalf("unexpected bodyBytes result: %v", result.Body)
+	}
+}
+
+func TestSurgeBareDoneContinuesUntouched(t *testing.T) {
+	script := newTestSurgeScript(t, `$done();`)
+	request, err := http.NewRequest(http.MethodGet, "https://example.com/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := script.ExecuteHTTPRequest(context.Background(), time.Second, request, nil, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Abort || result.Response != nil || result.URL != "" || result.Headers != nil || result.Body != nil {
+		t.Fatalf("bare $done changed the request: %+v", result)
+	}
+}
+
+func TestUnavailableSurgeScriptFailsOpen(t *testing.T) {
+	script := &SurgeScript{
+		tag:    "unavailable",
+		logger: log.NewNOPFactory().NewLogger("test"),
+		source: &testScriptSource{},
+	}
+	request, err := http.NewRequest(http.MethodGet, "https://example.com/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	requestResult, err := script.ExecuteHTTPRequest(context.Background(), time.Second, request, nil, false, false, nil)
+	if err != nil || requestResult == nil || requestResult.Abort || requestResult.Response != nil {
+		t.Fatalf("request script did not fail open: result=%+v err=%v", requestResult, err)
+	}
+	response := &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: http.NoBody}
+	responseResult, err := script.ExecuteHTTPResponse(context.Background(), time.Second, request, response, nil, false, false, nil)
+	if err != nil || responseResult == nil || responseResult.Abort || responseResult.Body != nil {
+		t.Fatalf("response script did not fail open: result=%+v err=%v", responseResult, err)
+	}
+}
+
+func TestRemoteSourceCompilesLazily(t *testing.T) {
+	program, err := compileScript("lazy.js", `$done({ body: "lazy" });`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	logger := log.NewNOPFactory().NewLogger("test")
+	source := &RemoteSource{
+		ctx:     ctx,
+		cancel:  cancel,
+		logger:  logger,
+		options: option.Script{},
+		program: newLazyProgram("lazy.js", logger),
+	}
+	_ = source.loadBytes([]byte(`$done({ body: "lazy" });`))
+	if source.program.program != nil {
+		t.Fatal("remote source retained a program before first use")
+	}
+	if text, fingerprint := source.Text(); text != `$done({ body: "lazy" });` || fingerprint == "" {
+		t.Fatalf("remote source text %q fingerprint %q", text, fingerprint)
+	}
+	loaded := source.Program()
+	if loaded == nil || program == nil {
+		t.Fatal("remote source did not compile on demand")
+	}
+	if source.Program() != loaded {
+		t.Fatal("compiled program not cached")
+	}
+	source.Close()
+}
+
+func TestSurgeRequestIncludesHostHeader(t *testing.T) {
+	script := newTestSurgeScript(t, `$done({ body: $request.headers.Host || $request.headers.host });`)
+	request, err := http.NewRequest(http.MethodGet, "https://example.com/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request.Host = "logical.example"
+	result, err := script.ExecuteHTTPRequest(context.Background(), time.Second, request, nil, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(result.Body) != "logical.example" {
+		t.Fatalf("unexpected Host header: %q", result.Body)
+	}
+}
+
+func TestScriptHubCompatibility(t *testing.T) {
+	scriptHubDirectory := os.Getenv("SCRIPT_HUB_DIRECTORY")
+	if scriptHubDirectory == "" {
+		t.Skip("SCRIPT_HUB_DIRECTORY is not set")
+	}
+	frontEndContent, err := os.ReadFile(filepath.Join(scriptHubDirectory, "script-hub.js"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	frontEnd := newTestSurgeScript(t, string(frontEndContent))
+	request, err := http.NewRequest(http.MethodGet, "https://script.hub/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := frontEnd.ExecuteHTTPRequest(context.Background(), 10*time.Second, request, nil, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Response == nil || result.Response.Status != http.StatusOK || !bytes.Contains(result.Response.Body, []byte("Script Hub")) {
+		t.Fatalf("unexpected Script Hub frontend response: %+v", result.Response)
+	}
+
+	sourceServer := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		writer.Header().Set("Content-Type", "application/javascript")
+		_, _ = writer.Write([]byte(`$done({ body: "converted" });`))
+	}))
+	defer sourceServer.Close()
+	converterContent, err := os.ReadFile(filepath.Join(scriptHubDirectory, "script-converter.js"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	converter := newTestSurgeScript(t, string(converterContent))
+	converterURL := "https://script.hub/convert/_start_/" + sourceServer.URL + "/_end_/converted.js?type=qx-script"
+	request, err = http.NewRequest(http.MethodGet, converterURL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Preserve the embedded source URL exactly as Script Hub's virtual endpoint does.
+	request.URL, err = url.Parse(converterURL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err = converter.ExecuteHTTPRequest(context.Background(), 15*time.Second, request, nil, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Response == nil || result.Response.Status != http.StatusOK || !bytes.Contains(result.Response.Body, []byte("_scriptSonverterCompatibilityDone")) {
+		t.Fatalf("unexpected Script Hub converter response: %+v", result.Response)
+	}
+}
+
+func TestSurgeHTTPAPICompatibilityStub(t *testing.T) {
+	script := newTestSurgeScript(t, `$httpAPI("POST", "/v1/profiles/reload", {}, result => $done({ body: String(result.success) + ":" + result.error }));`)
