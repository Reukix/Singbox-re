+func TestConcurrentPlatformRunsShareHeadroom(t *testing.T) {
+	const mib = 1024 * 1024
+	script := newTestSurgeScript(t, `$done({});`)
+	var running, peak, runs atomic.Int32
+	withPlatformEngine(t, &fakePlatformEngine{execute: func(invocation platformInvocation, host PlatformHost) string {
+		current := running.Add(1)
+		for {
+			observed := peak.Load()
+			if current <= observed || peak.CompareAndSwap(observed, current) {
+				break
+			}
+		}
+		runs.Add(1)
+		time.Sleep(100 * time.Millisecond)
+		running.Add(-1)
+		return outcomeJSON(t, platformOutcome{Status: platformStatusDone, Value: &platformDone{Body: &platformBody{Encoding: platformBodyUTF8, Data: "changed"}}})
+	}})
+	body := bytes.Repeat([]byte("a"), mib)
+	cost := platformScriptCost(len(body))
+	runFour := func() []string {
+		results := make([]string, 4)
+		var group sync.WaitGroup
+		for index := range results {
+			group.Add(1)
+			go func() {
+				defer group.Done()
+				request, _ := http.NewRequest(http.MethodGet, "https://example.com/feed", nil)
+				result, err := script.ExecuteHTTPResponse(context.Background(), 5*time.Second, request, testResponse(body), body, false, false, nil)
+				if err == nil {
+					results[index] = string(result.Body)
+				}
+			}()
+		}
+		group.Wait()
+		return results
+	}
+
+	// Room for two runs next to the reserve: the other two wait, none is lost.
+	memguard.SetHeadroomFunc(func() (uint64, bool) { return memguard.Reserve + 2*cost + mib, true })
+	defer memguard.SetHeadroomFunc(nil)
+	for index, result := range runFour() {
+		if result != "changed" {
+			t.Fatalf("run %d skipped although memory frees up: %q", index, result)
+		}
+	}
+	if peak.Load() != 2 {
+		t.Fatalf("%d runs executed at once, the headroom holds 2", peak.Load())
+	}
+
+	// Room for none: every run is skipped at once instead of queueing.
+	runs.Store(0)
+	memguard.SetHeadroomFunc(func() (uint64, bool) { return memguard.Reserve + cost - 1, true })
+	started := time.Now()
+	for index, result := range runFour() {
+		if result != "" {
+			t.Fatalf("run %d executed without headroom: %q", index, result)
+		}
+	}
+	if runs.Load() != 0 || time.Since(started) > time.Second {
+		t.Fatalf("%d runs executed, took %v", runs.Load(), time.Since(started))
+	}
+}
