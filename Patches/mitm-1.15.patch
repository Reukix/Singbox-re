@@ -0,0 +1,27 @@
+package libbox
+
+import (
+	"encoding/base64"
+	"testing"
+)
+
+func TestGenerateMITMCertificate(t *testing.T) {
+	generated, err := GenerateMITMCertificate("Test MITM Root")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if generated.KeyPair == "" || generated.Password == "" || generated.Certificate == "" {
+		t.Fatal("generated certificate is incomplete")
+	}
+	exported, err := ExportMITMCertificate(generated.KeyPair, generated.Password)
+	if err != nil {
+		t.Fatal(err)
+	}
+	certificateDER, err := base64.StdEncoding.DecodeString(exported.Value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(certificateDER) == 0 || exported.Value != generated.Certificate {
+		t.Fatal("exported certificate does not match generated certificate")
+	}
+}
