+package route
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type recordPacketDialer struct {
+	listenCalled bool
+}
+
+func (d *recordPacketDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return nil, errors.New("unexpected dial")
+}
+
+func (d *recordPacketDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	d.listenCalled = true
+	return nil, errors.New("listen not available in test")
+}
+
+type testPacketConn struct {
+	listen *net.UDPConn
+	closed bool
+}
+
+func newTestPacketConn(t *testing.T) *testPacketConn {
+	t.Helper()
+	listen, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &testPacketConn{listen: listen}
+}
+
+func (c *testPacketConn) ReadPacket(*buf.Buffer) (M.Socksaddr, error) {
+	return M.Socksaddr{}, errors.New("not implemented")
+}
+
+func (c *testPacketConn) WritePacket(buffer *buf.Buffer, destination M.Socksaddr) error {
+	return errors.New("not implemented")
+}
+
+func (c *testPacketConn) Close() error {
+	c.closed = true
+	return c.listen.Close()
+}
+
+func (c *testPacketConn) LocalAddr() net.Addr                { return c.listen.LocalAddr() }
+func (c *testPacketConn) SetDeadline(t time.Time) error      { return c.listen.SetDeadline(t) }
+func (c *testPacketConn) SetReadDeadline(t time.Time) error  { return c.listen.SetReadDeadline(t) }
+func (c *testPacketConn) SetWriteDeadline(t time.Time) error { return c.listen.SetWriteDeadline(t) }
+
+func TestPacketConnectionRejectsQUICWhenMITM(t *testing.T) {
+	manager := NewConnectionManager(context.Background(), log.NewNOPFactory().NewLogger("test"))
+	dialer := &recordPacketDialer{}
+	conn := newTestPacketConn(t)
+	metadata := adapter.InboundContext{
+		Network:     N.NetworkUDP,
+		Destination: M.ParseSocksaddrHostPort("example.com", 443),
+		MITM:        &option.MITMRouteOptions{Enabled: true},
+	}
+	manager.NewPacketConnection(context.Background(), dialer, conn, metadata, nil)
+	if dialer.listenCalled {
+		t.Fatal("QUIC connection to MITM domain was not rejected")
+	}
+	if !conn.closed {
+		t.Fatal("QUIC connection was not closed")
+	}
+}
+
+func TestPacketConnectionAllowsNonQUICWhenMITM(t *testing.T) {
+	manager := NewConnectionManager(context.Background(), log.NewNOPFactory().NewLogger("test"))
+	dialer := &recordPacketDialer{}
+	conn := newTestPacketConn(t)
+	defer conn.Close()
+	metadata := adapter.InboundContext{
+		Network:     N.NetworkUDP,
+		Destination: M.ParseSocksaddrHostPort("example.com", 4433),
+		MITM:        &option.MITMRouteOptions{Enabled: true},
+	}
+	manager.NewPacketConnection(context.Background(), dialer, conn, metadata, nil)
+	if !dialer.listenCalled {
+		t.Fatal("non-QUIC UDP connection was unexpectedly rejected")
+	}
+}
