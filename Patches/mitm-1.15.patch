+package route
+
+import (
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestMergeMITMRouteOptions(t *testing.T) {
+	first := &option.MITMRouteOptions{
+		Enabled:            true,
+		SurgeHeaderRewrite: []option.SurgeHeaderRewriteLine{{Key: "X-First"}},
+	}
+	second := &option.MITMRouteOptions{
+		Enabled:          true,
+		Print:            true,
+		SurgeBodyRewrite: []option.SurgeBodyRewriteLine{{}},
+	}
+	merged := mergeMITMRouteOptions(first, second)
+	if !merged.Enabled || !merged.Print || len(merged.SurgeHeaderRewrite) != 1 || len(merged.SurgeBodyRewrite) != 1 {
+		t.Fatalf("unexpected merged MITM options: %+v", merged)
+	}
+	merged.SurgeHeaderRewrite[0].Key = "changed"
+	if first.SurgeHeaderRewrite[0].Key != "X-First" {
+		t.Fatal("merge reused the input backing array")
+	}
+}
