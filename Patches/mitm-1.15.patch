+
+myURL = new URL("https://example.org:8888");
+assert.sameValue(myURL.port, "8888");
+
+function testSetPort(port, expected) {
+  const url = new URL("https://example.org:8888");
+  url.port = port;
+  assert.sameValue(url.port, expected);
+}
+
+testSetPort(0, "0");
+testSetPort(-0, "0");
+
+// Default ports are automatically transformed to the empty string
+// (HTTPS protocol's default port is 443)
+testSetPort("443", "");
+testSetPort(443, "");
+
+// Empty string is the same as default port
+testSetPort("", "");
+
+// Completely invalid port strings are ignored
+testSetPort("abcd", "8888");
+testSetPort("-123", "");
+testSetPort(-123, "");
+testSetPort(-123.45, "");
+testSetPort(undefined, "8888");
+testSetPort(null, "8888");
+testSetPort(+Infinity, "8888");
+testSetPort(-Infinity, "8888");
+testSetPort(NaN, "8888");
+
+// Leading numbers are treated as a port number
+testSetPort("5678abcd", "5678");
+testSetPort("a5678abcd", "");
+
+// Non-integers are truncated
+testSetPort(1234.5678, "1234");
+
+// Out-of-range numbers which are not represented in scientific notation
+// will be ignored.
+testSetPort(1e10, "8888");
+testSetPort("123456", "8888");
+testSetPort(123456, "8888");
+testSetPort(4.567e21, "4");
+
+// toString() takes precedence over valueOf(), even if it returns a valid integer
+testSetPort(
+  {
+    toString() {
+      return "2";
+    },
+    valueOf() {
+      return 1;
+    },
+  },
+  "2"
+);
+
+// Protocol
+function testSetProtocol(url, protocol, expected) {
+  url.protocol = protocol;
+  assert.sameValue(url.protocol, expected);
+}
+testSetProtocol(new URL("https://example.org"), "ftp", "ftp:");
+testSetProtocol(new URL("https://example.org"), "ftp:", "ftp:");
+testSetProtocol(new URL("https://example.org"), "FTP:", "ftp:");
+testSetProtocol(new URL("https://example.org"), "ftp: blah", "ftp:");
+// special to non-special
+testSetProtocol(new URL("https://example.org"), "foo", "https:");
+// non-special to special
+testSetProtocol(new URL("fish://example.org"), "https", "fish:");
+
+// Search
+myURL = new URL("https://example.org/abc?123");
+myURL.search = "abc=xyz";
+assert.sameValue(myURL.href, "https://example.org/abc?abc=xyz");
+
+myURL.search = "a=1 2";
+assert.sameValue(myURL.href, "https://example.org/abc?a=1%202");
+
+myURL.search = "á=ú";
+assert.sameValue(myURL.search, "?%C3%A1=%C3%BA");
+assert.sameValue(myURL.href, "https://example.org/abc?%C3%A1=%C3%BA");
+
+myURL.hash = "hash";
+myURL.search = "a=#b";
+assert.sameValue(myURL.href, "https://example.org/abc?a=%23b#hash");
+assert.sameValue(myURL.search, "?a=%23b");
+assert.sameValue(myURL.hash, "#hash");
+
+// Username
+myURL = new URL("https://abc:xyz@example.com/");
+myURL.username = "123";
+assert.sameValue(myURL.href, "https://123:xyz@example.com/");
+
+// Origin, read-only
+assert.throws(() => {
+  myURL.origin = "abc";
+}, TypeError);
+
+// href
+myURL = new URL("https://example.org");
+myURL.href = "https://example.com";
+assert.sameValue(myURL.href, "https://example.com/");
+
+assert.throws(() => {
+  myURL.href = "test";
+}, TypeError);
+
+// Search Params
+myURL = new URL("https://example.com/");
+myURL.searchParams.append("user", "abc");
+assert.sameValue(myURL.toString(), "https://example.com/?user=abc");
+myURL.searchParams.append("first", "one");
+assert.sameValue(myURL.toString(), "https://example.com/?user=abc&first=one");
+myURL.searchParams.delete("user");
+assert.sameValue(myURL.toString(), "https://example.com/?first=one");
+
+{
+    const url = require("url");
+
+    assert.sameValue(url.domainToASCII('español.com'), "xn--espaol-zwa.com");
+    assert.sameValue(url.domainToASCII('中文.com'), "xn--fiq228c.com");
+    assert.sameValue(url.domainToASCII('xn--iñvalid.com'), "");
+
+    assert.sameValue(url.domainToUnicode('xn--espaol-zwa.com'), "español.com");
+    assert.sameValue(url.domainToUnicode('xn--fiq228c.com'), "中文.com");
+    assert.sameValue(url.domainToUnicode('xn--iñvalid.com'), "");
+}
diff --git a/script/modules/url/url.go b/script/modules/url/url.go
new file mode 100644
index 000000000..7b442ded7
--- /dev/null
+++ b/script/modules/url/url.go
@@ -0,0 +1,315 @@
+package url
+
+import (
+	"net"
+	"net/url"
+	"strings"
+
+	"github.com/sagernet/sing-box/script/jsc"
+	E "github.com/sagernet/sing/common/exceptions"
+
+	"github.com/dop251/goja"
+	"golang.org/x/net/idna"
+)
+
+type URL struct {
+	class       jsc.Class[*Module, *URL]
+	url         *url.URL
+	params      *URLSearchParams
+	paramsValue goja.Value
+}
+
+func newURL(c jsc.Class[*Module, *URL], call goja.ConstructorCall) *URL {
+	var (
+		u, base *url.URL
+		err     error
+	)
+	switch argURL := call.Argument(0).Export().(type) {
+	case *URL:
+		u = argURL.url
+	default:
+		u, err = parseURL(call.Argument(0).String())
+		if err != nil {
+			panic(c.Runtime().NewGoError(E.Cause(err, "parse URL")))
+		}
+	}
+	if len(call.Arguments) == 2 {
+		switch argBaseURL := call.Argument(1).Export().(type) {
+		case *URL:
+			base = argBaseURL.url
+		default:
+			base, err = parseURL(call.Argument(1).String())
+			if err != nil {
+				panic(c.Runtime().NewGoError(E.Cause(err, "parse base URL")))
+			}
+		}
+	}
+	if base != nil {
+		u = base.ResolveReference(u)
+	}
+	return &URL{class: c, url: u}
+}
+
+func createURL(module *Module) jsc.Class[*Module, *URL] {
+	class := jsc.NewClass[*Module, *URL](module)
+	class.DefineConstructor(newURL)
+	class.DefineField("hash", (*URL).getHash, (*URL).setHash)
+	class.DefineField("host", (*URL).getHost, (*URL).setHost)
+	class.DefineField("hostname", (*URL).getHostName, (*URL).setHostName)
+	class.DefineField("href", (*URL).getHref, (*URL).setHref)
+	class.DefineField("origin", (*URL).getOrigin, nil)
+	class.DefineField("password", (*URL).getPassword, (*URL).setPassword)
+	class.DefineField("pathname", (*URL).getPathname, (*URL).setPathname)
+	class.DefineField("port", (*URL).getPort, (*URL).setPort)
+	class.DefineField("protocol", (*URL).getProtocol, (*URL).setProtocol)
+	class.DefineField("search", (*URL).getSearch, (*URL).setSearch)
+	class.DefineField("searchParams", (*URL).getSearchParams, (*URL).setSearchParams)
+	class.DefineField("username", (*URL).getUsername, (*URL).setUsername)
+	class.DefineMethod("toString", (*URL).toString)
+	class.DefineMethod("toJSON", (*URL).toJSON)
+	class.DefineStaticMethod("canParse", canParse)
+	// class.DefineStaticMethod("createObjectURL", createObjectURL)
+	class.DefineStaticMethod("parse", parse)
+	// class.DefineStaticMethod("revokeObjectURL", revokeObjectURL)
+	return class
+}
+
+func canParse(class jsc.Class[*Module, *URL], call goja.FunctionCall) any {
+	switch call.Argument(0).Export().(type) {
+	case *URL:
+	default:
+		_, err := parseURL(call.Argument(0).String())
+		if err != nil {
+			return false
+		}
+	}
+	if len(call.Arguments) == 2 {
+		switch call.Argument(1).Export().(type) {
+		case *URL:
+		default:
+			_, err := parseURL(call.Argument(1).String())
+			if err != nil {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func parse(class jsc.Class[*Module, *URL], call goja.FunctionCall) any {
+	var (
+		u, base *url.URL
+		err     error
+	)
+	switch argURL := call.Argument(0).Export().(type) {
+	case *URL:
+		u = argURL.url
+	default:
+		u, err = parseURL(call.Argument(0).String())
+		if err != nil {
+			return goja.Null()
+		}
+	}
+	if len(call.Arguments) == 2 {
+		switch argBaseURL := call.Argument(1).Export().(type) {
+		case *URL:
+			base = argBaseURL.url
+		default:
+			base, err = parseURL(call.Argument(1).String())
+			if err != nil {
+				return goja.Null()
+			}
+		}
+	}
+	if base != nil {
+		u = base.ResolveReference(u)
+	}
+	return &URL{class: class, url: u}
+}
+
+func (r *URL) getHash() any {
+	if r.url.Fragment != "" {
+		return "#" + r.url.EscapedFragment()
+	}
+	return ""
+}
+
+func (r *URL) setHash(value goja.Value) {
+	r.url.RawFragment = strings.TrimPrefix(value.String(), "#")
+}
+
+func (r *URL) getHost() any {
+	return r.url.Host
+}
+
+func (r *URL) setHost(value goja.Value) {
+	r.url.Host = strings.TrimSuffix(value.String(), ":")
+}
+
+func (r *URL) getHostName() any {
+	return r.url.Hostname()
+}
+
+func (r *URL) setHostName(value goja.Value) {
+	r.url.Host = joinHostPort(value.String(), r.url.Port())
+}
+
+func (r *URL) getHref() any {
+	return r.url.String()
+}
+
+func (r *URL) setHref(value goja.Value) {
+	newURL, err := url.Parse(value.String())
+	if err != nil {
+		panic(r.class.Runtime().NewGoError(err))
+	}
+	r.url = newURL
+	r.params = nil
+}
+
+func (r *URL) getOrigin() any {
+	return r.url.Scheme + "://" + r.url.Host
+}
+
+func (r *URL) getPassword() any {
+	if r.url.User != nil {
+		password, _ := r.url.User.Password()
+		return password
+	}
+	return ""
+}
+
+func (r *URL) setPassword(value goja.Value) {
+	if r.url.User == nil {
+		r.url.User = url.UserPassword("", value.String())
+	} else {
+		r.url.User = url.UserPassword(r.url.User.Username(), value.String())
+	}
+}
+
+func (r *URL) getPathname() any {
+	return r.url.EscapedPath()
+}
+
+func (r *URL) setPathname(value goja.Value) {
+	r.url.RawPath = value.String()
+}
+
+func (r *URL) getPort() any {
+	return r.url.Port()
+}
+
+func (r *URL) setPort(value goja.Value) {
+	r.url.Host = joinHostPort(r.url.Hostname(), value.String())
+}
+
+func (r *URL) getProtocol() any {
+	return r.url.Scheme + ":"
+}
+
+func (r *URL) setProtocol(value goja.Value) {
+	r.url.Scheme = strings.TrimSuffix(value.String(), ":")
+}
+
+func (r *URL) getSearch() any {
+	if r.params != nil {
+		if len(r.params.params) > 0 {
+			return "?" + generateQuery(r.params.params)
+		}
+	} else if r.url.RawQuery != "" {
+		return "?" + r.url.RawQuery
+	}
+	return ""
+}
+
+func (r *URL) setSearch(value goja.Value) {
+	params, err := parseQuery(value.String())
+	if err == nil {
+		if r.params != nil {
+			r.params.params = params
+		} else {
+			r.url.RawQuery = generateQuery(params)
+		}
+	}
+}
+
+func (r *URL) getSearchParams() any {
+	var params []searchParam
+	if r.url.RawQuery != "" {
+		params, _ = parseQuery(r.url.RawQuery)
+	}
+	if r.params == nil {
+		r.params = &URLSearchParams{
+			class:  r.class.Module().classURLSearchParams,
+			params: params,
+		}
+		r.paramsValue = r.class.Module().classURLSearchParams.New(r.params)
+	}
+	return r.paramsValue
+}
+
+func (r *URL) setSearchParams(value goja.Value) {
+	if params, ok := value.Export().(*URLSearchParams); ok {
+		r.params = params
+		r.paramsValue = value
+	}
+}
+
+func (r *URL) getUsername() any {
+	if r.url.User != nil {
+		return r.url.User.Username()
+	}
+	return ""
+}
+
+func (r *URL) setUsername(value goja.Value) {
+	if r.url.User == nil {
+		r.url.User = url.User(value.String())
+	} else {
+		password, _ := r.url.User.Password()
+		r.url.User = url.UserPassword(value.String(), password)
+	}
+}
+
+func (r *URL) toString(call goja.FunctionCall) any {
+	if r.params != nil {
+		r.url.RawQuery = generateQuery(r.params.params)
+	}
+	return r.url.String()
+}
+
+func (r *URL) toJSON(call goja.FunctionCall) any {
+	return r.toString(call)
+}
+
+func parseURL(s string) (*url.URL, error) {
+	u, err := url.Parse(s)
+	if err != nil {
+		return nil, E.Cause(err, "invalid URL")
+	}
+	switch u.Scheme {
+	case "https", "http", "ftp", "wss", "ws":
+		if u.Path == "" {
+			u.Path = "/"
+		}
+		hostname := u.Hostname()
+		asciiHostname, err := idna.Punycode.ToASCII(strings.ToLower(hostname))
+		if err != nil {
+			return nil, E.Cause(err, "invalid hostname")
+		}
+		if asciiHostname != hostname {
+			u.Host = joinHostPort(asciiHostname, u.Port())
+		}
+	}
+	if u.RawQuery != "" {
+		u.RawQuery = escape(u.RawQuery, &tblEscapeURLQuery, false)
+	}
+	return u, nil
+}
+
+func joinHostPort(hostname, port string) string {
+	if port == "" {
+		return hostname
+	}
+	return net.JoinHostPort(hostname, port)
+}
diff --git a/script/modules/url/url_search_params.go b/script/modules/url/url_search_params.go
new file mode 100644
index 000000000..945f076f2
--- /dev/null
+++ b/script/modules/url/url_search_params.go
@@ -0,0 +1,244 @@
+package url
+
+import (
+	"fmt"
+	"net/url"
+	"sort"
+	"strings"
+
+	"github.com/sagernet/sing-box/script/jsc"
+	F "github.com/sagernet/sing/common/format"
+
+	"github.com/dop251/goja"
+)
+
+type URLSearchParams struct {
+	class  jsc.Class[*Module, *URLSearchParams]
+	params []searchParam
+}
+
+func createURLSearchParams(module *Module) jsc.Class[*Module, *URLSearchParams] {
+	class := jsc.NewClass[*Module, *URLSearchParams](module)
+	class.DefineConstructor(newURLSearchParams)
+	class.DefineField("size", (*URLSearchParams).getSize, nil)
+	class.DefineMethod("append", (*URLSearchParams).append)
+	class.DefineMethod("delete", (*URLSearchParams).delete)
+	class.DefineMethod("entries", (*URLSearchParams).entries)
+	class.DefineMethod("forEach", (*URLSearchParams).forEach)
+	class.DefineMethod("get", (*URLSearchParams).get)
+	class.DefineMethod("getAll", (*URLSearchParams).getAll)
+	class.DefineMethod("has", (*URLSearchParams).has)
+	class.DefineMethod("keys", (*URLSearchParams).keys)
+	class.DefineMethod("set", (*URLSearchParams).set)
+	class.DefineMethod("sort", (*URLSearchParams).sort)
+	class.DefineMethod("toString", (*URLSearchParams).toString)
+	class.DefineMethod("values", (*URLSearchParams).values)
+	return class
+}
+
+func newURLSearchParams(class jsc.Class[*Module, *URLSearchParams], call goja.ConstructorCall) *URLSearchParams {
+	var (
+		params []searchParam
+		err    error
+	)
+	switch argInit := call.Argument(0).Export().(type) {
+	case *URLSearchParams:
+		params = argInit.params
+	case string:
+		params, err = parseQuery(argInit)
+		if err != nil {
+			panic(class.Runtime().NewGoError(err))
+		}
+	case [][]string:
+		for _, pair := range argInit {
+			if len(pair) != 2 {
+				panic(class.Runtime().NewTypeError("Each query pair must be an iterable [name, value] tuple"))
+			}
+			params = append(params, searchParam{pair[0], pair[1]})
+		}
+	case map[string]any:
+		for name, value := range argInit {
+			stringValue, isString := value.(string)
+			if !isString {
+				panic(class.Runtime().NewTypeError("Invalid query value"))
+			}
+			params = append(params, searchParam{name, stringValue})
+		}
+	}
+	return &URLSearchParams{class, params}
+}
+
+func (s *URLSearchParams) getSize() any {
+	return len(s.params)
+}
+
+func (s *URLSearchParams) append(call goja.FunctionCall) any {
+	name := jsc.AssertString(s.class.Runtime(), call.Argument(0), "name", false)
+	value := call.Argument(1).String()
+	s.params = append(s.params, searchParam{name, value})
+	return goja.Undefined()
+}
+
+func (s *URLSearchParams) delete(call goja.FunctionCall) any {
+	name := jsc.AssertString(s.class.Runtime(), call.Argument(0), "name", false)
+	argValue := call.Argument(1)
+	if !jsc.IsNil(argValue) {
+		value := argValue.String()
+		for i, param := range s.params {
+			if param.Key == name && param.Value == value {
+				s.params = append(s.params[:i], s.params[i+1:]...)
+				break
+			}
+		}
+	} else {
+		for i, param := range s.params {
+			if param.Key == name {
+				s.params = append(s.params[:i], s.params[i+1:]...)
+				break
+			}
+		}
+	}
+	return goja.Undefined()
+}
+
+func (s *URLSearchParams) entries(call goja.FunctionCall) any {
+	return jsc.NewIterator[*Module, searchParam](s.class.Module().classURLSearchParamsIterator, s.params, func(this searchParam) any {
+		return s.class.Runtime().NewArray(this.Key, this.Value)
+	})
+}
+
+func (s *URLSearchParams) forEach(call goja.FunctionCall) any {
+	callback := jsc.AssertFunction(s.class.Runtime(), call.Argument(0), "callbackFn")
+	thisValue := call.Argument(1)
+	for _, param := range s.params {
+		for _, value := range param.Value {
+			_, err := callback(thisValue, s.class.Runtime().ToValue(value), s.class.Runtime().ToValue(param.Key), call.This)
+			if err != nil {
+				panic(s.class.Runtime().NewGoError(err))
+			}
+		}
+	}
+	return goja.Undefined()
+}
+
+func (s *URLSearchParams) get(call goja.FunctionCall) any {
+	name := jsc.AssertString(s.class.Runtime(), call.Argument(0), "name", false)
+	for _, param := range s.params {
+		if param.Key == name {
+			return param.Value
+		}
+	}
+	return goja.Null()
+}
+
+func (s *URLSearchParams) getAll(call goja.FunctionCall) any {
+	name := jsc.AssertString(s.class.Runtime(), call.Argument(0), "name", false)
+	var values []any
+	for _, param := range s.params {
+		if param.Key == name {
+			values = append(values, param.Value)
+		}
+	}
+	return s.class.Runtime().NewArray(values...)
+}
+
+func (s *URLSearchParams) has(call goja.FunctionCall) any {
+	name := jsc.AssertString(s.class.Runtime(), call.Argument(0), "name", false)
+	argValue := call.Argument(1)
+	if !jsc.IsNil(argValue) {
+		value := argValue.String()
+		for _, param := range s.params {
+			if param.Key == name && param.Value == value {
+				return true
+			}
+		}
+	} else {
+		for _, param := range s.params {
+			if param.Key == name {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (s *URLSearchParams) keys(call goja.FunctionCall) any {
+	return jsc.NewIterator[*Module, searchParam](s.class.Module().classURLSearchParamsIterator, s.params, func(this searchParam) any {
+		return this.Key
+	})
+}
+
+func (s *URLSearchParams) set(call goja.FunctionCall) any {
+	name := jsc.AssertString(s.class.Runtime(), call.Argument(0), "name", false)
+	value := call.Argument(1).String()
+	for i, param := range s.params {
+		if param.Key == name {
+			s.params[i].Value = value
+			return goja.Undefined()
+		}
+	}
+	s.params = append(s.params, searchParam{name, value})
+	return goja.Undefined()
+}
+
+func (s *URLSearchParams) sort(call goja.FunctionCall) any {
+	sort.SliceStable(s.params, func(i, j int) bool {
+		return s.params[i].Key < s.params[j].Key
+	})
+	return goja.Undefined()
+}
+
+func (s *URLSearchParams) toString(call goja.FunctionCall) any {
+	return generateQuery(s.params)
+}
+
+func (s *URLSearchParams) values(call goja.FunctionCall) any {
+	return jsc.NewIterator[*Module, searchParam](s.class.Module().classURLSearchParamsIterator, s.params, func(this searchParam) any {
+		return this.Value
+	})
+}
+
+type searchParam struct {
+	Key   string
+	Value string
+}
+
+func parseQuery(query string) (params []searchParam, err error) {
+	query = strings.TrimPrefix(query, "?")
+	for query != "" {
+		var key string
+		key, query, _ = strings.Cut(query, "&")
+		if strings.Contains(key, ";") {
+			err = fmt.Errorf("invalid semicolon separator in query")
+			continue
+		}
+		if key == "" {
+			continue
+		}
+		key, value, _ := strings.Cut(key, "=")
+		key, err1 := url.QueryUnescape(key)
+		if err1 != nil {
+			if err == nil {
+				err = err1
+			}
+			continue
+		}
+		value, err1 = url.QueryUnescape(value)
+		if err1 != nil {
+			if err == nil {
+				err = err1
+			}
+			continue
+		}
+		params = append(params, searchParam{key, value})
+	}
+	return
+}
+
+func generateQuery(params []searchParam) string {
+	var parts []string
+	for _, param := range params {
+		parts = append(parts, F.ToString(param.Key, "=", url.QueryEscape(param.Value)))
+	}
+	return strings.Join(parts, "&")
+}
diff --git a/script/platform.go b/script/platform.go
new file mode 100644
index 000000000..fb19b2fc1
--- /dev/null
+++ b/script/platform.go
@@ -0,0 +1,52 @@
+package script
+
+import "sync/atomic"
+
+// PlatformEngine runs Surge scripts outside the Go runtime. On iOS the
+// Network Extension provides one backed by WebKit: the JavaScript runs in a
+// separate WebContent process, so script memory no longer counts against the
+// extension's 50 MiB limit. goja stays the fallback.
+//
+// Execute blocks until the run finishes. scriptID names the script source
+// (tag and content fingerprint) so the engine can cache the compiled script
+// and only ask host for the source when the ID is new; timeout is the script
+// timeout in milliseconds. invocation carries the run as JSON (see
+// platformInvocation) and body the data of its message body; the result is
+// a platformOutcome JSON document, optionally followed by a framed body.
+// Execute must not fail: problems are reported through the outcome status.
+type PlatformEngine interface {
+	Execute(scriptID string, timeout int64, invocation string, body string, host PlatformHost) string
+}
+
+// PlatformHost serves a script running in a platform engine.
+type PlatformHost interface {
+	// Source returns the script source.
+	Source() string
+	// Call serves one API call such as $httpClient or $persistentStore.
+	// arguments and the result are JSON objects; failures are reported as
+	// {"error": "..."}.
+	Call(method string, arguments string) string
+}
+
+type platformEngineBox struct {
+	engine PlatformEngine
+}
+
+var platformEngine atomic.Pointer[platformEngineBox]
+
+// SetPlatformEngine installs the platform engine; nil removes it.
+func SetPlatformEngine(engine PlatformEngine) {
+	if engine == nil {
+		platformEngine.Store(nil)
+		return
+	}
+	platformEngine.Store(&platformEngineBox{engine: engine})
+}
+
+func loadPlatformEngine() PlatformEngine {
+	box := platformEngine.Load()
+	if box == nil {
+		return nil
+	}
+	return box.engine
+}
diff --git a/script/platform_surge.go b/script/platform_surge.go
new file mode 100644
index 000000000..d5dd4a7e1
--- /dev/null
+++ b/script/platform_surge.go
@@ -0,0 +1,690 @@
+//go:build with_script
+
+package script
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+	"unicode/utf8"
+	"unsafe"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/memguard"
+	"github.com/sagernet/sing-box/script/modules/surge"
+	E "github.com/sagernet/sing/common/exceptions"
+	F "github.com/sagernet/sing/common/format"
+	"github.com/sagernet/sing/common/logger"
+)
+
+// A platform engine run costs the extension only the copies needed to hand
+// the body over and back: the platform string and WebKit's IPC buffers, then
+// the same for the result. Measured with gomobile's string conversions on
+// Chinese JSON: 4.4-5.1 times the body outside Go plus the result string in
+// Go on a first run.
+const (
+	platformScriptConcurrency        = 3
+	platformBaseCost          uint64 = 1024 * 1024
+	platformBodyCostFactor    uint64 = 6
+	// A result may be larger than the body it replaces, or be a synthesized
+	// response, but the extension receives it whole, so it is bounded too.
+	platformMinResultLimit = 1024 * 1024
+	platformMaxResultLimit = 8 * 1024 * 1024
+)
+
+const (
+	platformBodyUTF8   = "utf8"
+	platformBodyBase64 = "base64"
+	// platformBodySame marks a result body identical to the input body, so
+	// an unchanged body is not copied back across the process boundary.
+	platformBodySame = "same"
+)
+
+// platformGrace is how long past the script timeout the engine may take to
+// report back before the run fails open.
+var platformGrace = 3 * time.Second
+
+// Only "unavailable" (the engine cannot run scripts at all) falls back to
+// goja; "skipped" means the engine had no memory to spare, where goja would
+// need even more.
+const (
+	platformStatusDone        = "done"
+	platformStatusError       = "error"
+	platformStatusTimeout     = "timeout"
+	platformStatusUnavailable = "unavailable"
+	platformStatusSkipped     = "skipped"
+)
+
+// Starting the platform engine loads WebKit's client side into the extension
+// for good (about 10 MiB, measured on macOS), while a small goja run costs a
+// few MiB only while it runs. So small scripts on small bodies stay in goja
+// until a run needs the platform engine; from then on its cost is paid and
+// every run goes there.
+const (
+	platformPreferBodySize   = 128 * 1024
+	platformPreferSourceSize = 128 * 1024
+	// platformStartCost is reserved for the run that starts the engine.
+	platformStartCost uint64 = 10 * 1024 * 1024
+)
+
+var (
+	platformSlots        = make(chan struct{}, platformScriptConcurrency)
+	platformInvocationID atomic.Uint64
+	platformEngaged      atomic.Bool
+)
+
+// platformEngineFor returns the platform engine if this run should use it.
+func (s *SurgeScript) platformEngineFor(bodyLength int) PlatformEngine {
+	engine := loadPlatformEngine()
+	if engine == nil {
+		return nil
+	}
+	if platformEngaged.Load() || bodyLength >= platformPreferBodySize {
+		return engine
+	}
+	if source, _ := s.source.Text(); len(source) >= platformPreferSourceSize {
+		return engine
+	}
+	return nil
+}
+
+// platformInvocation is the JSON handed to PlatformEngine.Execute. The
+// message body is not part of it: its platformBody only names the encoding,
+// and the data travels as Execute's body argument, so it is neither escaped
+// nor copied into the JSON.
+type platformInvocation struct {
+	ID             string            `json:"id"`
+	Script         string            `json:"script"`
+	Tag            string            `json:"tag"`
+	Type           string            `json:"type"`
+	Timeout        int64             `json:"timeout"`
+	Argument       string            `json:"argument"`
+	Arguments      []string          `json:"arguments"`
+	BinaryBodyMode bool              `json:"binaryBodyMode"`
+	FullHeaderMode bool              `json:"fullHeaderMode"`
+	CronExpression string            `json:"cronExpression,omitempty"`
+	ResultLimit    int               `json:"resultLimit"`
+	StartedAt      int64             `json:"startedAt"`
+	SessionID      string            `json:"sessionID"`
+	Environment    map[string]string `json:"environment"`
+	Request        *platformMessage  `json:"request,omitempty"`
+	Response       *platformMessage  `json:"response,omitempty"`
+}
+
+type platformMessage struct {
+	URL     string        `json:"url,omitempty"`
+	Method  string        `json:"method,omitempty"`
+	ID      string        `json:"id,omitempty"`
+	Status  int           `json:"status,omitempty"`
+	Headers [][2]string   `json:"headers"`
+	Body    *platformBody `json:"body,omitempty"`
+}
+
+// platformBody carries valid UTF-8 as is and other data as base64; the
+// script sees the exact bytes either way.
+type platformBody struct {
+	Encoding string `json:"encoding"`
+	Data     string `json:"data"`
+}
+
+// platformOutcome is the JSON returned by PlatformEngine.Execute. When Framed
+// is set, the data of Value.Body follows the JSON after a newline instead of
+// being inside it; JSON never contains a raw newline.
+type platformOutcome struct {
+	Status string        `json:"status"`
+	Error  string        `json:"error,omitempty"`
+	Value  *platformDone `json:"value,omitempty"`
+	Framed bool          `json:"framed,omitempty"`
+}
+
+// platformDone is the serialized $done argument.
+type platformDone struct {
+	Abort      bool          `json:"abort,omitempty"`
+	URL        string        `json:"url,omitempty"`
+	Status     int           `json:"status,omitempty"`
+	StatusCode int           `json:"statusCode,omitempty"`
+	Headers    *[][2]string  `json:"headers,omitempty"`
+	Body       *platformBody `json:"body,omitempty"`
+	Response   *platformDone `json:"response,omitempty"`
+}
+
+func newPlatformBody(content []byte) *platformBody {
+	if len(content) == 0 {
+		return nil
+	}
+	if utf8.Valid(content) {
+		return &platformBody{Encoding: platformBodyUTF8, Data: unsafe.String(unsafe.SliceData(content), len(content))}
+	}
+	return &platformBody{Encoding: platformBodyBase64, Data: base64.StdEncoding.EncodeToString(content)}
+}
+
+// detachedPlatformBody describes content for an invocation and returns its
+// data separately, for Execute's body argument.
+func detachedPlatformBody(content []byte) (*platformBody, string) {
+	body := newPlatformBody(content)
+	if body == nil {
+		return nil, ""
+	}
+	data := body.Data
+	body.Data = ""
+	return body, data
+}
+
+// parsePlatformOutcome decodes an Execute result, attaching a framed body
+// without copying it.
+func parsePlatformOutcome(output string) (*platformOutcome, error) {
+	header, frame, _ := strings.Cut(output, "\n")
+	var outcome platformOutcome
+	if err := unmarshalPlatform(header, &outcome); err != nil {
+		return nil, err
+	}
+	if outcome.Framed {
+		if outcome.Value == nil || outcome.Value.Body == nil {
+			return nil, E.New("framed script result without a body")
+		}
+		outcome.Value.Body.Data = frame
+	}
+	return &outcome, nil
+}
+
+// decode returns the body bytes; original is what a "same" body refers to.
+// A text body shares the memory of the decoded JSON string instead of being
+// copied again: bodies are only ever read after this point.
+func (b *platformBody) decode(original []byte) ([]byte, error) {
+	if b == nil {
+		return nil, nil
+	}
+	switch b.Encoding {
+	case platformBodyBase64:
+		return base64.StdEncoding.DecodeString(b.Data)
+	case platformBodyUTF8, "":
+		if b.Data == "" {
+			return []byte{}, nil
+		}
+		return unsafe.Slice(unsafe.StringData(b.Data), len(b.Data)), nil
+	case platformBodySame:
+		return original, nil
+	default:
+		return nil, E.New("unknown body encoding: ", b.Encoding)
+	}
+}
+
+func headerList(headers http.Header) [][2]string {
+	list := make([][2]string, 0, len(headers))
+	for key, values := range headers {
+		for _, value := range values {
+			list = append(list, [2]string{key, value})
+		}
+	}
+	return list
+}
+
+func headersFromList(list *[][2]string) http.Header {
+	if list == nil {
+		return nil
+	}
+	headers := make(http.Header, len(*list))
+	for _, entry := range *list {
+		headers.Add(entry[0], entry[1])
+	}
+	return headers
+}
+
+func (d *platformDone) status() int {
+	if d.Status != 0 {
+		return d.Status
+	}
+	return d.StatusCode
+}
+
+func platformScriptCost(bodyLength int) uint64 {
+	return platformBaseCost + uint64(bodyLength)*platformBodyCostFactor
+}
+
+func platformResultLimit(bodyLength int) int {
+	return min(max(2*bodyLength, platformMinResultLimit), platformMaxResultLimit)
+}
+
+func (s *SurgeScript) newPlatformInvocation(scriptType string, timeout time.Duration, arguments []string, binaryBodyMode bool, fullHeaderMode bool) *platformInvocation {
+	startedAt := time.Now()
+	if arguments == nil {
+		arguments = []string{}
+	}
+	argument := ""
+	for index, value := range arguments {
+		if index > 0 {
+			argument += "&"
+		}
+		argument += value
+	}
+	return &platformInvocation{
+		ID:             strconv.FormatUint(platformInvocationID.Add(1), 10),
+		Tag:            s.tag,
+		Type:           scriptType,
+		Timeout:        timeout.Milliseconds(),
+		Argument:       argument,
+		Arguments:      arguments,
+		BinaryBodyMode: binaryBodyMode,
+		FullHeaderMode: fullHeaderMode,
+		StartedAt:      startedAt.UnixMilli(),
+		SessionID:      strconv.FormatInt(startedAt.UnixNano(), 16),
+		Environment:    surge.EnvironmentValues(),
+	}
+}
+
+// runPlatform runs invocation in engine. handled is false only when the
+// engine cannot run scripts at all, so the caller falls back to goja; script
+// errors, timeouts and refused admission are handled by failing open.
+func (s *SurgeScript) runPlatform(ctx context.Context, engine PlatformEngine, invocation *platformInvocation, body string, bodyLength int, timeout time.Duration) (value *platformDone, handled bool) {
+	source, fingerprint := s.source.Text()
+	if source == "" {
+		s.logger.Warn(invocation.Type, " script skipped because source is unavailable")
+		return nil, true
+	}
+	scriptID := s.tag + "@" + fingerprint
+	invocation.Script = scriptID
+	invocation.ResultLimit = platformResultLimit(bodyLength)
+	admissionCtx, cancelAdmission := context.WithTimeout(ctx, timeout)
+	select {
+	case platformSlots <- struct{}{}:
+	case <-admissionCtx.Done():
+		cancelAdmission()
+		s.logger.Error(E.Cause(admissionCtx.Err(), invocation.Type, " script skipped"))
+		return nil, true
+	}
+	defer func() { <-platformSlots }()
+	cost := platformScriptCost(bodyLength)
+	if !platformEngaged.Load() {
+		cost += platformStartCost
+	}
+	releaseMemory, admitted := memguard.Acquire(admissionCtx, cost)
+	cancelAdmission()
+	if !admitted {
+		s.logger.Warn(invocation.Type, " script skipped: insufficient memory headroom for a ", bodyLength, " byte body")
+		return nil, true
+	}
+	defer releaseMemory()
+	// The run's deadline starts with the run, so waiting for a slot or for
+	// memory does not make Go give up on a run the engine is still executing.
+	ctx, cancel := context.WithTimeout(ctx, timeout+platformGrace)
+	defer cancel()
+	var payload bytes.Buffer
+	encoder := json.NewEncoder(&payload)
+	encoder.SetEscapeHTML(false)
+	if err := encoder.Encode(invocation); err != nil {
+		s.logger.Error(E.Cause(err, "encode script invocation"))
+		return nil, true
+	}
+	invocation.Request, invocation.Response = nil, nil
+	host := &platformHost{ctx: ctx, logger: s.logger, tag: s.tag, source: s.source}
+	defer host.close()
+	done := make(chan string, 1)
+	invocationJSON := payload.String()
+	go func() {
+		done <- engine.Execute(scriptID, timeout.Milliseconds(), invocationJSON, body, host)
+	}()
+	var output string
+	select {
+	case output = <-done:
+	case <-ctx.Done():
+		s.logger.Error(invocation.Type, " script timed out in the platform engine, failed open")
+		return nil, true
+	}
+	outcome, err := parsePlatformOutcome(output)
+	if err != nil {
+		s.logger.Error(E.Cause(err, "decode platform script result"))
+		return nil, true
+	}
+	switch outcome.Status {
+	case platformStatusDone, platformStatusError, platformStatusTimeout:
+		platformEngaged.Store(true)
+	}
+	switch outcome.Status {
+	case platformStatusDone:
+		return outcome.Value, true
+	case platformStatusUnavailable:
+		s.logger.Warn("platform script engine unavailable, falling back: ", outcome.Error)
+		return nil, false
+	case platformStatusSkipped:
+		s.logger.Warn(invocation.Type, " script skipped: ", outcome.Error)
+		return nil, true
+	case platformStatusTimeout:
+		s.logger.Error(invocation.Type, " script timed out, failed open")
+		return nil, true
+	default:
+		s.logger.Error(invocation.Type, " script failed open: ", outcome.Error)
+		return nil, true
+	}
+}
+
+func (s *SurgeScript) executePlatformHTTPRequest(ctx context.Context, engine PlatformEngine, timeout time.Duration, request *http.Request, body []byte, binaryBody bool, fullHeaderMode bool, arguments []string) (*adapter.HTTPRequestScriptResult, bool) {
+	invocation := s.newPlatformInvocation("http-request", timeout, arguments, binaryBody, fullHeaderMode)
+	invocation.Request = &platformMessage{
+		URL:     request.URL.String(),
+		Method:  request.Method,
+		ID:      F.ToString(uintptr(unsafe.Pointer(request))),
+		Headers: headerList(surgeRequestHeaders(request)),
+	}
+	var bodyData string
+	invocation.Request.Body, bodyData = detachedPlatformBody(body)
+	value, handled := s.runPlatform(ctx, engine, invocation, bodyData, len(body), timeout)
+	if !handled {
+		return nil, false
+	}
+	result := &adapter.HTTPRequestScriptResult{}
+	if value == nil {
+		return result, true
+	}
+	resultBody, err := value.Body.decode(body)
+	if err != nil {
+		s.logger.Error(E.Cause(err, "HTTP request script failed open"))
+		return &adapter.HTTPRequestScriptResult{}, true
+	}
+	result.Abort = value.Abort
+	result.URL = value.URL
+	result.Headers = headersFromList(value.Headers)
+	result.Body = resultBody
+	if value.Response != nil {
+		responseBody, err := value.Response.Body.decode(nil)
+		if err != nil {
+			s.logger.Error(E.Cause(err, "HTTP request script failed open"))
+			return &adapter.HTTPRequestScriptResult{}, true
+		}
+		result.Response = &adapter.HTTPRequestScriptResponse{
+			Status:  value.Response.status(),
+			Headers: headersFromList(value.Response.Headers),
+			Body:    responseBody,
+		}
+	}
+	return result, true
+}
+
+func (s *SurgeScript) executePlatformHTTPResponse(ctx context.Context, engine PlatformEngine, timeout time.Duration, request *http.Request, response *http.Response, body []byte, binaryBody bool, fullHeaderMode bool, arguments []string) (*adapter.HTTPResponseScriptResult, bool) {
+	invocation := s.newPlatformInvocation("http-response", timeout, arguments, binaryBody, fullHeaderMode)
+	invocation.Request = &platformMessage{
+		URL:     request.URL.String(),
+		Method:  request.Method,
+		ID:      F.ToString(uintptr(unsafe.Pointer(request))),
+		Headers: headerList(surgeRequestHeaders(request)),
+	}
+	invocation.Response = &platformMessage{
+		Status:  response.StatusCode,
+		Headers: headerList(response.Header),
+	}
+	var bodyData string
+	invocation.Response.Body, bodyData = detachedPlatformBody(body)
+	value, handled := s.runPlatform(ctx, engine, invocation, bodyData, len(body), timeout)
+	if !handled {
+		return nil, false
+	}
+	result := &adapter.HTTPResponseScriptResult{}
+	if value == nil {
+		return result, true
+	}
+	resultBody, err := value.Body.decode(body)
+	if err != nil {
+		s.logger.Error(E.Cause(err, "HTTP response script failed open"))
+		return &adapter.HTTPResponseScriptResult{}, true
+	}
+	result.Status = value.status()
+	result.Abort = value.Abort
+	result.Headers = headersFromList(value.Headers)
+	result.Body = resultBody
+	return result, true
+}
+
+// executePlatformGeneric runs cron and other body-less events.
+func (s *SurgeScript) executePlatformGeneric(ctx context.Context, engine PlatformEngine, scriptType string, timeout time.Duration, arguments []string) bool {
+	invocation := s.newPlatformInvocation(scriptType, timeout, arguments, false, false)
+	if scriptType == "cron" {
+		invocation.CronExpression = s.cronExpression
+	}
+	_, handled := s.runPlatform(ctx, engine, invocation, "", 0, timeout)
+	return handled
+}
+
+// platformHost serves one platform run. Calls arrive from platform threads,
+// possibly after the run ended (a callback the script left pending).
+type platformHost struct {
+	ctx        context.Context
+	logger     logger.ContextLogger
+	tag        string
+	source     Source
+	closed     atomic.Bool
+	httpAccess sync.Mutex
+	httpClient *surge.HTTPClient
+}
+
+func (h *platformHost) Source() string {
+	text, _ := h.source.Text()
+	return text
+}
+
+func (h *platformHost) close() {
+	h.closed.Store(true)
+	h.httpAccess.Lock()
+	h.httpClient = nil
+	h.httpAccess.Unlock()
+}
+
+func (h *platformHost) client() *surge.HTTPClient {
+	h.httpAccess.Lock()
+	defer h.httpAccess.Unlock()
+	if h.httpClient == nil {
+		h.httpClient = surge.NewHTTPClient(h.ctx, h.logger)
+	}
+	return h.httpClient
+}
+
+type platformHTTPOptions struct {
+	Method       string        `json:"method"`
+	URL          string        `json:"url"`
+	Headers      [][2]string   `json:"headers"`
+	Body         *platformBody `json:"body"`
+	Timeout      float64       `json:"timeout"`
+	Insecure     bool          `json:"insecure"`
+	AutoCookie   *bool         `json:"autoCookie"`
+	AutoRedirect *bool         `json:"autoRedirect"`
+}
+
+type platformHTTPResult struct {
+	Error   string        `json:"error,omitempty"`
+	Status  int           `json:"status,omitempty"`
+	Headers [][2]string   `json:"headers,omitempty"`
+	Body    *platformBody `json:"body,omitempty"`
+}
+
+type platformNotification struct {
+	Title    string `json:"title"`
+	Subtitle string `json:"subtitle"`
+	Body     string `json:"body"`
+	Options  *struct {
+		Action          string `json:"action"`
+		URL             string `json:"url"`
+		Text            string `json:"text"`
+		MediaURL        string `json:"media-url"`
+		MediaBase64     string `json:"media-base64"`
+		MediaBase64MIME string `json:"media-base64-mime"`
+		AutoDismiss     int    `json:"auto-dismiss"`
+	} `json:"options"`
+}
+
+func (h *platformHost) Call(method string, arguments string) string {
+	if h.closed.Load() {
+		return platformError(E.New("script run already finished"))
+	}
+	if int64(len(arguments)) > surge.ScriptDataLimit()*2 {
+		return platformError(E.New(method, ": arguments exceed ", surge.ScriptDataLimit()*2, " bytes"))
+	}
+	output, err := h.call(method, arguments)
+	if err != nil {
+		return platformError(err)
+	}
+	return output
+}
+
+func (h *platformHost) call(method string, arguments string) (string, error) {
+	switch method {
+	case "persistentStore.read":
+		var request struct {
+			Key string `json:"key"`
+		}
+		if err := unmarshalPlatform(arguments, &request); err != nil {
+			return "", err
+		}
+		value, loaded := surge.PersistentStoreRead(h.ctx, h.tag, request.Key)
+		if !loaded {
+			return `{"value":null}`, nil
+		}
+		return marshalPlatform(map[string]string{"value": value})
+	case "persistentStore.write":
+		var request struct {
+			Key   string `json:"key"`
+			Value string `json:"value"`
+		}
+		if err := unmarshalPlatform(arguments, &request); err != nil {
+			return "", err
+		}
+		if err := surge.PersistentStoreWrite(h.ctx, h.tag, request.Key, request.Value); err != nil {
+			return "", err
+		}
+		return `{"ok":true}`, nil
+	case "http":
+		return h.callHTTP(arguments)
+	case "notification":
+		var request platformNotification
+		if err := unmarshalPlatform(arguments, &request); err != nil {
+			return "", err
+		}
+		notification := surge.NotificationRequest{Title: request.Title, Subtitle: request.Subtitle, Body: request.Body}
+		if options := request.Options; options != nil {
+			switch options.Action {
+			case "open-url":
+				notification.OpenURL = options.URL
+			case "clipboard":
+				notification.Clipboard = options.Text
+			}
+			notification.MediaURL = options.MediaURL
+			if options.MediaBase64 != "" {
+				mediaData, err := base64.StdEncoding.DecodeString(options.MediaBase64)
+				if err != nil {
+					return "", E.Cause(err, "decode media-base64")
+				}
+				notification.MediaData = mediaData
+				notification.MediaType = options.MediaBase64MIME
+			}
+			notification.AutoDismiss = options.AutoDismiss
+		}
+		surge.PostNotification(h.ctx, h.logger, h.tag, notification)
+		return `{}`, nil
+	case "log":
+		var request struct {
+			Level   string `json:"level"`
+			Message string `json:"message"`
+		}
+		if err := unmarshalPlatform(arguments, &request); err != nil {
+			return "", err
+		}
+		switch request.Level {
+		case "debug", "trace":
+			h.logger.DebugContext(h.ctx, request.Message)
+		case "warn":
+			h.logger.WarnContext(h.ctx, request.Message)
+		case "error":
+			h.logger.ErrorContext(h.ctx, request.Message)
+		default:
+			h.logger.InfoContext(h.ctx, request.Message)
+		}
+		return `{}`, nil
+	case "utils.ungzip":
+		var request struct {
+			Data string `json:"data"`
+		}
+		if err := unmarshalPlatform(arguments, &request); err != nil {
+			return "", err
+		}
+		compressed, err := base64.StdEncoding.DecodeString(request.Data)
+		if err != nil {
+			return "", err
+		}
+		decoded, err := surge.Ungzip(compressed)
+		if err != nil {
+			return "", err
+		}
+		return marshalPlatform(map[string]string{"data": base64.StdEncoding.EncodeToString(decoded)})
+	default:
+		return "", E.New("unknown script host method: ", method)
+	}
+}
+
+func (h *platformHost) callHTTP(arguments string) (string, error) {
+	var request platformHTTPOptions
+	if err := unmarshalPlatform(arguments, &request); err != nil {
+		return "", err
+	}
+	body, err := request.Body.decode(nil)
+	if err != nil {
+		return "", err
+	}
+	options := surge.HTTPRequestOptions{
+		Method:       request.Method,
+		URL:          request.URL,
+		Headers:      make(http.Header, len(request.Headers)),
+		Body:         body,
+		Timeout:      5 * time.Second,
+		Insecure:     request.Insecure,
+		AutoCookie:   request.AutoCookie == nil || *request.AutoCookie,
+		AutoRedirect: request.AutoRedirect == nil || *request.AutoRedirect,
+	}
+	if options.Method == "" {
+		options.Method = http.MethodGet
+	}
+	for _, entry := range request.Headers {
+		options.Headers.Add(entry[0], entry[1])
+	}
+	if request.Timeout > 0 {
+		options.Timeout = time.Duration(request.Timeout * float64(time.Second))
+	}
+	result, err := h.client().Do(options)
+	if err != nil {
+		return marshalPlatform(platformHTTPResult{Error: err.Error()})
+	}
+	if result.Error != "" {
+		return marshalPlatform(platformHTTPResult{Error: result.Error})
+	}
+	return marshalPlatform(platformHTTPResult{
+		Status:  result.StatusCode,
+		Headers: headerList(result.Headers),
+		Body:    newPlatformBody(result.Body),
+	})
+}
+
+// unmarshalPlatform decodes JSON without copying the string first.
+func unmarshalPlatform(content string, value any) error {
+	return json.Unmarshal(unsafe.Slice(unsafe.StringData(content), len(content)), value)
+}
+
+func marshalPlatform(value any) (string, error) {
+	var output bytes.Buffer
+	encoder := json.NewEncoder(&output)
+	encoder.SetEscapeHTML(false)
+	if err := encoder.Encode(value); err != nil {
+		return "", err
+	}
+	return output.String(), nil
+}
+
+func platformError(err error) string {
+	output, marshalErr := marshalPlatform(map[string]string{"error": err.Error()})
+	if marshalErr != nil {
+		return `{"error":"internal error"}`
+	}
+	return output
+}
