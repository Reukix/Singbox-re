+// TestHTTP1RunsRequestAndResponseScripts drives a plain HTTP/1.1 exchange
+// through the engine. HTTP/1 connections used to match request scripts only,
+// so response scripts never ran for clients without HTTP/2.
+func TestHTTP1RunsRequestAndResponseScripts(t *testing.T) {
+	var upstreamHeader atomic.Value
+	upstream := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		upstreamHeader.Store(request.Header.Get("X-Script"))
+		writer.Header().Set("Content-Type", "application/json")
+		_, _ = writer.Write([]byte(`{"ad":true}`))
+	}))
+	defer upstream.Close()
+
+	requestScript := &fakeSurgeScript{tag: "tag-request", request: func(request *http.Request, body []byte) *adapter.HTTPRequestScriptResult {
+		headers := request.Header.Clone()
+		headers.Set("X-Script", "request")
+		return &adapter.HTTPRequestScriptResult{Headers: headers}
+	}}
+	responseScript := &fakeSurgeScript{tag: "strip-ads", response: func(response *http.Response, body []byte) *adapter.HTTPResponseScriptResult {
+		if string(body) != `{"ad":true}` {
+			t.Errorf("response script got body %q", body)
+		}
+		return &adapter.HTTPResponseScriptResult{Body: []byte(`{"ad":false}`)}
+	}}
+	engine := testEngine(1024 * 1024)
+	engine.timeFunc = time.Now
+	engine.upstream = newUpstreamPool(&engine.limits)
+	defer engine.upstream.close()
+	engine.script = &fakeScriptManager{scripts: map[string]adapter.Script{
+		requestScript.tag:  requestScript,
+		responseScript.tag: responseScript,
+	}}
+	metadata := adapter.InboundContext{
+		Destination: M.ParseSocksaddr(upstream.Listener.Addr().String()),
+		MITM: &option.MITMRouteOptions{
+			Enabled: true,
+			Script: []option.MITMRouteSurgeScriptOptions{
+				{Tag: requestScript.tag, Type: []string{"http-request"}, Pattern: scriptPattern(t, `^http://`)},
+				{Tag: responseScript.tag, Type: []string{"http-response"}, Pattern: scriptPattern(t, `/feed$`), RequiresBody: true},
+			},
+		},
+	}
+
+	client, server := net.Pipe()
+	defer client.Close()
+	session := engine.sessions.add(server)
+	served := make(chan error, 1)
+	go func() {
+		served <- engine.newHTTP1(context.Background(), &countingDialer{}, server, nil, metadata, session)
+	}()
+	request, err := http.NewRequest(http.MethodGet, "http://"+upstream.Listener.Addr().String()+"/feed", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request.Close = true
+	go func() { _ = request.Write(client) }()
+	_ = client.SetReadDeadline(time.Now().Add(10 * time.Second))
+	response, err := http.ReadResponse(bufio.NewReader(client), request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := io.ReadAll(response.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(body) != `{"ad":false}` {
+		t.Fatalf("response script result not applied: %q", body)
+	}
+	if requestScript.requests.Load() != 1 || responseScript.responses.Load() != 1 {
+		t.Fatalf("scripts ran %d request / %d response times", requestScript.requests.Load(), responseScript.responses.Load())
+	}
+	if header, _ := upstreamHeader.Load().(string); header != "request" {
+		t.Fatalf("request script header not forwarded: %q", header)
+	}
+	_ = client.Close()
+	select {
+	case err := <-served:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("HTTP/1 session did not end")
+	}
+}
