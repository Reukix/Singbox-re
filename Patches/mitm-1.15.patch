+func TestRemoteSourceCompilesLazily(t *testing.T) {
+	program, err := compileScript("lazy.js", `$done({ body: "lazy" });`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	source := &RemoteSource{
+		ctx:     ctx,
+		cancel:  cancel,
+		logger:  log.NewNOPFactory().NewLogger("test"),
+		options: option.Script{},
+		content: []byte(`$done({ body: "lazy" });`),
+	}
+	if source.program != nil {
+		t.Fatal("remote source retained a program before first use")
+	}
+	loaded := source.Program()
+	if loaded == nil || program == nil {
+		t.Fatal("remote source did not compile on demand")
+	}
+	source.Close()
+}
+
+func TestSurgeRequestIncludesHostHeader(t *testing.T) {
+	script := newTestSurgeScript(t, `$done({ body: $request.headers.Host || $request.headers.host });`)
+	request, err := http.NewRequest(http.MethodGet, "https://example.com/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request.Host = "logical.example"
+	result, err := script.ExecuteHTTPRequest(context.Background(), time.Second, request, nil, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(result.Body) != "logical.example" {
+		t.Fatalf("unexpected Host header: %q", result.Body)
+	}
+}
+
+func TestScriptHubCompatibility(t *testing.T) {
+	scriptHubDirectory := os.Getenv("SCRIPT_HUB_DIRECTORY")
+	if scriptHubDirectory == "" {
+		t.Skip("SCRIPT_HUB_DIRECTORY is not set")
+	}
+	frontEndContent, err := os.ReadFile(filepath.Join(scriptHubDirectory, "script-hub.js"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	frontEnd := newTestSurgeScript(t, string(frontEndContent))
+	request, err := http.NewRequest(http.MethodGet, "https://script.hub/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := frontEnd.ExecuteHTTPRequest(context.Background(), 10*time.Second, request, nil, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Response == nil || result.Response.Status != http.StatusOK || !bytes.Contains(result.Response.Body, []byte("Script Hub")) {
+		t.Fatalf("unexpected Script Hub frontend response: %+v", result.Response)
+	}
+
+	sourceServer := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		writer.Header().Set("Content-Type", "application/javascript")
+		_, _ = writer.Write([]byte(`$done({ body: "converted" });`))
+	}))
+	defer sourceServer.Close()
+	converterContent, err := os.ReadFile(filepath.Join(scriptHubDirectory, "script-converter.js"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	converter := newTestSurgeScript(t, string(converterContent))
+	converterURL := "https://script.hub/convert/_start_/" + sourceServer.URL + "/_end_/converted.js?type=qx-script"
+	request, err = http.NewRequest(http.MethodGet, converterURL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Preserve the embedded source URL exactly as Script Hub's virtual endpoint does.
+	request.URL, err = url.Parse(converterURL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err = converter.ExecuteHTTPRequest(context.Background(), 15*time.Second, request, nil, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Response == nil || result.Response.Status != http.StatusOK || !bytes.Contains(result.Response.Body, []byte("_scriptSonverterCompatibilityDone")) {
+		t.Fatalf("unexpected Script Hub converter response: %+v", result.Response)
+	}
+}
+
+func TestSurgeHTTPAPICompatibilityStub(t *testing.T) {
+	script := newTestSurgeScript(t, `$httpAPI("POST", "/v1/profiles/reload", {}, result => $done({ body: String(result.success) + ":" + result.error }));`)
+	request, err := http.NewRequest(http.MethodGet, "https://script.hub/reload", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := script.ExecuteHTTPRequest(context.Background(), time.Second, request, nil, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(string(result.Body), "false:Surge HTTP API") {
+		t.Fatalf("unexpected $httpAPI result: %q", result.Body)
+	}
+}
