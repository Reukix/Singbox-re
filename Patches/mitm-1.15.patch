+	fingerprint string
+}
+
+func TestSurgeHTTPClientMethodsAreDiscoverable(t *testing.T) {
+	script := newTestSurgeScript(t, `$done({ body: Object.getOwnPropertyNames($httpClient).join(",") });`)
+	request, err := http.NewRequest(http.MethodGet, "https://example.com/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := script.ExecuteHTTPRequest(context.Background(), time.Second, request, nil, false, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	methods := string(result.Body)
+	if !strings.Contains(methods, "get") || !strings.Contains(methods, "post") {
+		t.Fatalf("HTTP client methods are not discoverable: %q", methods)
+	}
+}
+
+func (s *testScriptSource) StartContext(context.Context, *adapter.HTTPStartContext) error { return nil }
+func (s *testScriptSource) PostStart() error                                              { return nil }
+func (s *testScriptSource) Program() *goja.Program                                        { return s.program }
+func (s *testScriptSource) Text() (string, string)                                        { return s.text, s.fingerprint }
