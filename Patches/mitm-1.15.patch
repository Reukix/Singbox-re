+			writer.WriteHeader(result.Response.Status)
+			if result.Response.Body != nil {
+				if _, writeErr := writer.Write(result.Response.Body); writeErr != nil {
+					return E.Cause(writeErr, "write fake response body")
+				}
+			}
+			return nil
+		}
+		if result.URL != "" {
+			newURL, parseErr := url.Parse(result.URL)
+			if parseErr != nil || !newURL.IsAbs() || newURL.Hostname() == "" {
+				e.logger.WarnContext(ctx, "script returned an invalid request URL, ignored: ", result.URL)
+			} else {
+				applyRequestURL(request, newURL, &metadata, tlsConfig)
+				requestURL = newURL.String()
+			}
+		}
+		replaceRequestHeaders(request, result.Headers)
+		if result.Body != nil {
+			if !requestScriptOptions.RequiresBody {
+				return E.New("request script returned a body without requires_body")
+			}
+			body = result.Body
+			setRequestBody(request, body, true)
+		}
+	}
+	{
+		for i, rule := range options.SurgeMapLocal {
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			requestMatch = true
+			e.logger.DebugContext(ctx, "match map_local[", i, "] => ", rule.String())
+			go func() {
+				io.Copy(io.Discard, request.Body)
+				request.Body.Close()
+			}()
+			var (
+				statusCode = http.StatusOK
+				headers    = make(http.Header)
+				body       []byte
+			)
+			if rule.StatusCode > 0 {
+				statusCode = rule.StatusCode
+			}
+			switch {
+			case rule.File:
+				resource, err := filemanager.ReadFile(ctx, rule.Data)
+				if err != nil {
+					return E.Cause(err, "open map local source")
+				}
+				if int64(len(resource)) > mapLocalBodyLimit {
+					return E.New("map local source exceeds limit: ", len(resource), " > ", mapLocalBodyLimit)
+				}
+				mimeType := mime.TypeByExtension(filepath.Ext(rule.Data))
+				if mimeType == "" {
+					mimeType = "application/octet-stream"
+				}
+				headers.Set("Content-Type", mimeType)
+				body = resource
+			case rule.Text:
+				headers.Set("Content-Type", "text/plain")
+				body = []byte(rule.Data)
+			case rule.TinyGif:
+				headers.Set("Content-Type", "image/gif")
+				body = surgeTinyGif()
+			case rule.Base64:
+				headers.Set("Content-Type", "application/octet-stream")
+				body = rule.Base64Data
+			}
+			for key, values := range rule.Headers {
+				headers[key] = values
+			}
+			headers = surgeSyntheticHeaders(headers, len(body))
+			for key, values := range headers {
+				writer.Header()[key] = values
+			}
+			writer.WriteHeader(statusCode)
+			_, err = writer.Write(body)
+			if err != nil {
+				return E.Cause(err, "write map local response")
+			}
+			return nil
+		}
+	}
+	requestCtx, cancel := context.WithCancel(adapter.WithContext(ctx, &metadata))
+	defer cancel()
+	normalizeRequestFraming(request)
+	response, releaseUpstream, err := e.exchange(requestCtx, e.dialer, tlsConfig, true, request)
+	if err != nil {
+		cancel()
+		return err
+	}
+	defer releaseUpstream()
+	var (
+		responseScript        adapter.SurgeScript
+		responseMatch         bool
+		responseScriptOptions option.MITMRouteSurgeScriptOptions
+	)
+	var (
+		responseBody        []byte
+		responseBodyDecoded bool
+	)
+	if options.Print && response.ContentLength > 0 && response.ContentLength <= e.limits.printBody {
+		var available bool
+		var denied bool
+		var printBody []byte
+		printBody, response.Body, available, _, denied, err = e.bufferBody(ctx, &hold, response.Body, response.ContentLength, nil, e.limits.printBody)
+		if err != nil {
+			return E.Cause(err, "read HTTP response body")
+		}
+		if available {
+			e.printResponse(ctx, request, response, printBody)
+		} else {
+			if denied {
+				e.logger.WarnContext(ctx, "print body skipped: body buffer budget exhausted")
+			}
+			e.printResponse(ctx, request, response, nil)
+		}
+	} else if options.Print {
+		e.printResponse(ctx, request, response, responseBody)
+	}
+	{
+		for i, rule := range options.SurgeHeaderRewrite {
+			if !rule.Response {
+				continue
+			}
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			responseMatch = true
+			e.logger.DebugContext(ctx, "match header_rewrite[", i, "] => ", rule.String())
+			applyHeaderRewrite(response.Header, &rule)
+		}
+		for i, rule := range options.SurgeBodyRewrite {
+			if !rule.Response {
+				continue
+			}
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			responseMatch = true
+			e.logger.DebugContext(ctx, "match body_rewrite[", i, "] => ", rule.String())
+			if responseBody == nil {
+				var (
+					available bool
+					denied    bool
+				)
+				responseBody, response.Body, available, responseBodyDecoded, denied, err = e.bufferBody(ctx, &hold, response.Body, response.ContentLength, response.Header, responseRewriteBodyLimit)
+				if err != nil {
+					return E.Cause(err, "read HTTP response body")
+				}
+				if denied {
+					e.logger.WarnContext(ctx, "response body rewrite skipped: body buffer budget exhausted")
+					break
+				}
+				if !available {
+					e.logger.WarnContext(ctx, "response body rewrite skipped because body exceeds the limit or uses an unsupported content encoding")
+					break
+				}
+			}
+			rewrittenBody, rewritten := e.rewriteBody(ctx, &hold, responseBody, &rule, responseRewriteBodyLimit, "response")
+			if !rewritten {
+				continue
+			}
+			responseBody = rewrittenBody
+			responseBodyDecoded = true
+			setResponseBody(response, responseBody, true)
+		}
+	}
+	responseScript, responseScriptOptions = e.matchSurgeScript(ctx, options, "http-response", requestURL, request.Host, metadata)
+	if responseScript != nil && responseBody == nil && responseScriptOptions.RequiresBody && response.ContentLength != 0 {
+		bodyLimit := surgeScriptBodyLimit(responseScriptOptions.MaxSize)
+		var (
+			available bool
+			denied    bool
+		)
+		responseBody, response.Body, available, responseBodyDecoded, denied, err = e.bufferBody(ctx, &hold, response.Body, response.ContentLength, response.Header, bodyLimit)
+		if err != nil {
+			return E.Cause(err, "read HTTP response body")
+		}
+		if denied || !available {
+			if denied {
+				e.logger.WarnContext(ctx, "response script skipped: body buffer budget exhausted")
+			} else {
+				e.logger.WarnContext(ctx, "response script skipped because body exceeds max-size or uses an unsupported content encoding")
+			}
+			responseScript = nil
+			responseBody = nil
+		} else {
+			setResponseBody(response, responseBody, responseBodyDecoded)
+		}
+	}
+	if responseScript != nil {
+		result, executeErr := responseScript.ExecuteHTTPResponse(ctx, time.Duration(responseScriptOptions.Timeout), request, response, responseBody, responseScriptOptions.BinaryBodyMode, responseScriptOptions.FullHeaderMode, responseScriptOptions.Arguments)
+		if executeErr != nil {
+			return E.Cause(executeErr, "execute script/", responseScript.Type(), "[", responseScript.Tag(), "]")
+		}
+		if result.Abort {
+			return E.New("response aborted by script/", responseScript.Type(), "[", responseScript.Tag(), "]")
+		}
+		responseMatch = true
+		if result.Status >= 100 && result.Status <= 599 {
+			response.Status = http.StatusText(result.Status)
+			response.StatusCode = result.Status
+		} else if result.Status != 0 {
+			e.logger.WarnContext(ctx, "script returned an invalid response status, ignored: ", result.Status)
+		}
+		replaceResponseHeaders(response, result.Headers)
+		if result.Body != nil {
+			if !responseScriptOptions.RequiresBody {
+				return E.New("response script returned a body without requires_body")
+			}
+			responseBody = result.Body
+			setResponseBody(response, responseBody, true)
+		}
+	}
+	if !options.Print && !requestMatch && !responseMatch {
+		e.logger.DebugContext(ctx, "request not modified")
+	}
+	normalizeResponseFraming(response)
+	for key, values := range response.Header {
+		writer.Header()[key] = values
+	}
+	writer.WriteHeader(response.StatusCode)
+	_, err = io.Copy(writer, response.Body)
+	response.Body.Close()
+	if err != nil {
+		return E.Cause(err, "write HTTP response")
+	}
+	return nil
+}
+
+func (e *Engine) printRequest(ctx context.Context, request *http.Request, body []byte) {
+	var builder strings.Builder
+	builder.WriteString(F.ToString(request.Proto, " ", request.Method, " ", request.URL))
+	builder.WriteString("\n")
+	if request.URL.Hostname() != "" && request.URL.Hostname() != request.Host {
+		builder.WriteString("Host: ")
+		builder.WriteString(request.Host)
+		builder.WriteString("\n")
+	}
+	for key, values := range request.Header {
+		for _, value := range values {
+			builder.WriteString(key)
+			builder.WriteString(": ")
+			builder.WriteString(value)
+			builder.WriteString("\n")
+		}
+	}
+	if len(body) > 0 {
+		builder.WriteString("\n")
+		if !bytes.ContainsFunc(body, func(r rune) bool {
+			return !unicode.IsPrint(r) && !unicode.IsSpace(r)
+		}) {
+			builder.Write(body)
+		} else {
+			builder.WriteString("(body not printable)")
+		}
+	}
+	e.logger.InfoContext(ctx, "request: ", builder.String())
+}
+
+func (e *Engine) printResponse(ctx context.Context, request *http.Request, response *http.Response, body []byte) {
+	var builder strings.Builder
+	builder.WriteString(F.ToString(response.Proto, " ", response.Status, " ", request.URL))
+	builder.WriteString("\n")
+	for key, values := range response.Header {
+		for _, value := range values {
+			builder.WriteString(key)
+			builder.WriteString(": ")
+			builder.WriteString(value)
+			builder.WriteString("\n")
+		}
+	}
+	if len(body) > 0 {
+		builder.WriteString("\n")
+		if !bytes.ContainsFunc(body, func(r rune) bool {
+			return !unicode.IsPrint(r) && !unicode.IsSpace(r)
+		}) {
+			builder.Write(body)
+		} else {
+			builder.WriteString("(body not printable)")
+		}
+	}
+	e.logger.InfoContext(ctx, "response: ", builder.String())
+}
+
+func surgeScriptBodyLimit(configured int64) int64 {
+	if configured < 0 {
+		return 32 * 1024 * 1024
+	}
+	if configured == 0 {
+		return 1024 * 1024
+	}
+	return configured
+}
+
+func applyRequestURL(request *http.Request, destination *url.URL, metadata *adapter.InboundContext, tlsConfig *tls.Config) {
+	requestDestination := *destination
+	switch strings.ToLower(requestDestination.Scheme) {
+	case "ws":
+		requestDestination.Scheme = "http"
+	case "wss":
+		requestDestination.Scheme = "https"
+	}
+	request.URL = &requestDestination
+	request.Host = destination.Host
+	newDestination := M.ParseSocksaddrHostPortStr(destination.Hostname(), destination.Port())
+	if newDestination.Port == 0 {
+		switch strings.ToLower(destination.Scheme) {
+		case "http":
+			newDestination.Port = 80
+		case "https":
+			newDestination.Port = 443
+		case "ws":
+			newDestination.Port = 80
+		case "wss":
+			newDestination.Port = 443
+		default:
+			newDestination.Port = metadata.Destination.Port
+		}
+	}
+	metadata.Destination = newDestination
+	metadata.DestinationAddresses = nil
+	if tlsConfig != nil {
+		tlsConfig.ServerName = destination.Hostname()
+	}
+}
+
+// matchSurgeScript returns the first Surge script configured for event whose
+// pattern matches the request.
+func (e *Engine) matchSurgeScript(ctx context.Context, options *option.MITMRouteOptions, event string, requestURL string, host string, metadata adapter.InboundContext) (adapter.SurgeScript, option.MITMRouteSurgeScriptOptions) {
+	connectionHost := surgeConnectionHost(metadata)
+	for _, scriptOptions := range options.Script {
+		if !surgeScriptMatchesEvent(scriptOptions, event) {
+			continue
+		}
+		matched := false
+		for _, pattern := range scriptOptions.Pattern {
+			if surgePatternMatches(pattern.Build(), requestURL, host, connectionHost) {
+				matched = true
+				break
+			}
+		}
+		if !matched {
+			continue
+		}
+		script, loaded := e.script.Script(scriptOptions.Tag)
+		if !loaded {
+			e.logger.WarnContext(ctx, "script not found: ", scriptOptions.Tag)
+			continue
+		}
+		surgeScript, isSurge := script.(adapter.SurgeScript)
+		if !isSurge {
+			e.logger.WarnContext(ctx, "specified script/", script.Type(), "[", script.Tag(), "] is not a Surge script")
+			continue
+		}
+		e.logger.DebugContext(ctx, "match script/", surgeScript.Type(), "[", surgeScript.Tag(), "]")
+		return surgeScript, scriptOptions
+	}
+	return nil, option.MITMRouteSurgeScriptOptions{}
+}
+
+func surgeScriptMatchesEvent(scriptOptions option.MITMRouteSurgeScriptOptions, event string) bool {
+	if len(scriptOptions.Type) == 0 {
+		return true
+	}
+	for _, scriptType := range scriptOptions.Type {
+		if scriptType == event {
+			return true
+		}
+	}
+	return false
+}
+
+func surgeSyntheticHeaders(source http.Header, bodyLength int) http.Header {
+	headers := source.Clone()
+	if headers == nil {
+		headers = make(http.Header)
+	}
+	headers.Del("Connection")
+	headers.Del("Proxy-Connection")
+	headers.Del("Transfer-Encoding")
+	headers.Set("Content-Length", strconv.Itoa(bodyLength))
+	return headers
+}
+
+type surgeReplayBody struct {
+	io.Reader
+	io.Closer
+}
+
+type simpleResponseWriter struct {
+	statusCode int
+	header     http.Header
+	body       bytes.Buffer
+}
+
+type trackingResponseWriter struct {
+	http.ResponseWriter
+	wroteHeader bool
+}
+
+func (w *trackingResponseWriter) WriteHeader(statusCode int) {
+	if !w.wroteHeader {
+		w.wroteHeader = true
+	}
+	w.ResponseWriter.WriteHeader(statusCode)
+}
+
+func (w *trackingResponseWriter) Write(content []byte) (int, error) {
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+	return w.ResponseWriter.Write(content)
+}
+
+func (w *simpleResponseWriter) Build(request *http.Request) *http.Response {
+	return &http.Response{
+		StatusCode: w.statusCode,
+		Status:     http.StatusText(w.statusCode),
+		Proto:      request.Proto,
+		ProtoMajor: request.ProtoMajor,
+		ProtoMinor: request.ProtoMinor,
+		Header:     w.header,
+		Body:       io.NopCloser(&w.body),
+	}
+}
+
+func (w *simpleResponseWriter) Header() http.Header {
+	if w.header == nil {
+		w.header = make(http.Header)
+	}
+	return w.header
+}
+
+func (w *simpleResponseWriter) Write(b []byte) (int, error) {
+	return w.body.Write(b)
+}
+
+func (w *simpleResponseWriter) WriteHeader(statusCode int) {
+	w.statusCode = statusCode
+}
