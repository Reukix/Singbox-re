diff --git a/mitm/body.go b/mitm/body.go
new file mode 100644
index 000000000..3b15077dd
--- /dev/null
+++ b/mitm/body.go
@@ -0,0 +1,437 @@
+package mitm
+
+import (
+	"bytes"
+	"compress/flate"
+	"compress/gzip"
+	"compress/zlib"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/andybalholm/brotli"
+	"golang.org/x/net/http/httpguts"
+)
+
+const (
+	requestRewriteBodyLimit  int64 = 32 * 1024 * 1024
+	responseRewriteBodyLimit int64 = 1024 * 1024
+	mapLocalBodyLimit        int64 = 4 * 1024 * 1024
+	printBodyLimit           int64 = 128 * 1024
+)
+
+// bufferHTTPBody returns a decoded, replayable body when it fits within limit.
+// If the body is too large, the returned replay body contains every byte read so
+// forwarding can continue without truncation.
+func bufferHTTPBody(body io.ReadCloser, contentLength int64, headers http.Header, limit int64) (content []byte, replay io.ReadCloser, available bool, decoded bool, err error) {
+	if limit <= 0 {
+		limit = responseRewriteBodyLimit
+	}
+	content, replay, available, decoded, _, err = bufferHTTPBodyBudgeted(body, contentLength, headers, limit, nil, initialBodyCapacity(contentLength, limit))
+	return
+}
+
+func initialBodyCapacity(contentLength int64, limit int64) int64 {
+	if contentLength > 0 {
+		// Known length: one exact allocation and no append growth.
+		return min(contentLength, limit)
+	}
+	return min(limit, bodyReadChunk)
+}
+
+// bufferHTTPBodyBudgeted is bufferHTTPBody with every retained byte (the wire
+// copy and each decoded layer) charged to hold. The caller has already charged
+// initial bytes. When the budget refuses more, exhausted is set, the body is
+// not rewritten, and replay still carries every byte.
+func bufferHTTPBodyBudgeted(body io.ReadCloser, contentLength int64, headers http.Header, limit int64, hold *bodyBufferHold, initial int64) (content []byte, replay io.ReadCloser, available bool, decoded bool, exhausted bool, err error) {
+	if body == nil || body == http.NoBody || contentLength == 0 {
+		hold.releasePart(initial)
+		return []byte{}, http.NoBody, true, false, false, nil
+	}
+	if contentLength > limit {
+		hold.releasePart(initial)
+		return nil, body, false, false, false, nil
+	}
+
+	wireBody, pending, complete, overLimit, budgetExhausted, readErr := readBudgeted(body, initial, limit, hold)
+	if readErr != nil {
+		hold.releasePart(int64(cap(wireBody)))
+		return nil, body, false, false, false, readErr
+	}
+	if !complete {
+		// What was read stays charged to the hold until the request ends; the
+		// remainder streams through untouched.
+		return nil, &surgeReplayBody{
+			Reader: io.MultiReader(bytes.NewReader(wireBody), bytes.NewReader(pending), body),
+			Closer: body,
+		}, false, false, budgetExhausted && !overLimit, nil
+	}
+	_ = body.Close()
+
+	contentEncoding := headers.Get("Content-Encoding")
+	if strings.TrimSpace(contentEncoding) == "" || strings.EqualFold(strings.TrimSpace(contentEncoding), "identity") {
+		return wireBody, io.NopCloser(bytes.NewReader(wireBody)), true, false, false, nil
+	}
+	decodedBody, decodeExhausted, decodeErr := decodeHTTPBodyBudgeted(wireBody, contentEncoding, limit, hold)
+	if decodeErr != nil {
+		return nil, io.NopCloser(bytes.NewReader(wireBody)), false, false, decodeExhausted, nil
+	}
+	// Only the decoded body stays referenced from here on, unless decoding
+	// was a no-op ("identity, identity") and returned the wire buffer itself.
+	if !sameBuffer(decodedBody, wireBody) {
+		hold.releasePart(int64(cap(wireBody)))
+	}
+	return decodedBody, io.NopCloser(bytes.NewReader(decodedBody)), true, true, false, nil
+}
+
+const bodyReadChunk = 32 * 1024
+
+// readBudgeted reads at most limit bytes into a buffer of initial capacity,
+// which the caller has already charged to hold. Growth is charged before it
+// is allocated. When the result is incomplete, pending holds bytes that were
+// read past data and must be replayed right after it.
+func readBudgeted(reader io.Reader, initial int64, limit int64, hold *bodyBufferHold) (data []byte, pending []byte, complete bool, overLimit bool, budgetExhausted bool, err error) {
+	data = make([]byte, 0, initial)
+	for {
+		if len(data) < cap(data) {
+			n, readErr := reader.Read(data[len(data):cap(data)])
+			data = data[:len(data)+n]
+			if readErr == io.EOF {
+				return data, nil, true, false, false, nil
+			}
+			if readErr != nil {
+				return data, nil, false, false, false, readErr
+			}
+			continue
+		}
+		// The buffer is full: probe for one more byte before paying for growth,
+		// so a body that exactly fits needs no extra budget.
+		probe := make([]byte, 1)
+		n, readErr := reader.Read(probe)
+		if n == 0 {
+			if readErr == io.EOF {
+				return data, nil, true, false, false, nil
+			}
+			if readErr != nil {
+				return data, nil, false, false, false, readErr
+			}
+			continue
+		}
+		if int64(len(data)) >= limit {
+			return data, probe, false, true, false, nil
+		}
+		grow := min(max(int64(cap(data)), bodyReadChunk), limit-int64(cap(data)))
+		if !hold.tryGrow(grow) {
+			return data, probe, false, false, true, nil
+		}
+		// The old buffer's charge carries over to the larger one.
+		next := make([]byte, len(data), int64(cap(data))+grow)
+		copy(next, data)
+		data = append(next, probe[0])
+		if readErr == io.EOF {
+			return data, nil, true, false, false, nil
+		}
+		if readErr != nil {
+			return data, nil, false, false, false, readErr
+		}
+	}
+}
+
+func decodeHTTPBody(content []byte, contentEncoding string, limit int64) ([]byte, error) {
+	decoded, _, err := decodeHTTPBodyBudgeted(content, contentEncoding, limit, nil)
+	return decoded, err
+}
+
+// decodeHTTPBodyBudgeted undoes each content coding, charging every decoded
+// layer to hold. exhausted reports that the budget, not the data, stopped it.
+func decodeHTTPBodyBudgeted(content []byte, contentEncoding string, limit int64, hold *bodyBufferHold) (decoded []byte, exhausted bool, err error) {
+	encodings := strings.Split(contentEncoding, ",")
+	decoded = content
+	for index := len(encodings) - 1; index >= 0; index-- {
+		encoding := strings.ToLower(strings.TrimSpace(encodings[index]))
+		if encoding == "" || encoding == "identity" {
+			continue
+		}
+		var reader io.ReadCloser
+		switch encoding {
+		case "gzip", "x-gzip":
+			reader, err = gzip.NewReader(bytes.NewReader(decoded))
+		case "deflate":
+			reader, err = zlib.NewReader(bytes.NewReader(decoded))
+			if err != nil {
+				reader = flate.NewReader(bytes.NewReader(decoded))
+				err = nil
+			}
+		case "br":
+			reader = io.NopCloser(brotli.NewReader(bytes.NewReader(decoded)))
+		default:
+			err = &unsupportedContentEncodingError{encoding: encoding}
+		}
+		if err != nil {
+			releaseIntermediate(hold, decoded, content)
+			return nil, false, err
+		}
+		initial := min(limit, bodyReadChunk)
+		if !hold.tryGrow(initial) {
+			_ = reader.Close()
+			releaseIntermediate(hold, decoded, content)
+			return nil, true, &bodyBudgetError{}
+		}
+		next, _, complete, overLimit, budgetExhausted, readErr := readBudgeted(reader, initial, limit, hold)
+		closeErr := reader.Close()
+		if readErr == nil {
+			readErr = closeErr
+		}
+		if !complete || readErr != nil {
+			hold.releasePart(int64(cap(next)))
+			releaseIntermediate(hold, decoded, content)
+			switch {
+			case readErr != nil:
+				return nil, false, readErr
+			case budgetExhausted:
+				return nil, true, &bodyBudgetError{}
+			case overLimit:
+				return nil, false, &bodyLimitError{limit: limit}
+			default:
+				return nil, false, &bodyLimitError{limit: limit}
+			}
+		}
+		releaseIntermediate(hold, decoded, content)
+		decoded = next
+	}
+	return decoded, false, nil
+}
+
+// releaseIntermediate returns the charge of a decoded layer that is being
+// dropped. The original wire content is released by the caller.
+func releaseIntermediate(hold *bodyBufferHold, layer []byte, original []byte) {
+	if cap(layer) == 0 || sameBuffer(layer, original) {
+		return
+	}
+	hold.releasePart(int64(cap(layer)))
+}
+
+// sameBuffer reports whether two slices share their backing array.
+func sameBuffer(a []byte, b []byte) bool {
+	return cap(a) > 0 && cap(b) > 0 && &a[:cap(a)][cap(a)-1] == &b[:cap(b)][cap(b)-1]
+}
+
+type bodyBudgetError struct{}
+
+func (e *bodyBudgetError) Error() string {
+	return "body buffer budget exhausted"
+}
+
+type unsupportedContentEncodingError struct {
+	encoding string
+}
+
+func (e *unsupportedContentEncodingError) Error() string {
+	return "unsupported content encoding: " + e.encoding
+}
+
+type bodyLimitError struct {
+	limit int64
+}
+
+func (e *bodyLimitError) Error() string {
+	return "decoded body exceeds limit: " + strconv.FormatInt(e.limit, 10)
+}
+
+func setRequestBody(request *http.Request, body []byte, decoded bool) {
+	request.Body = io.NopCloser(bytes.NewReader(body))
+	request.ContentLength = int64(len(body))
+	request.TransferEncoding = nil
+	request.Header.Del("Transfer-Encoding")
+	request.Header.Set("Content-Length", strconv.Itoa(len(body)))
+	if decoded {
+		request.Header.Del("Content-Encoding")
+	}
+}
+
+func setResponseBody(response *http.Response, body []byte, decoded bool) {
+	if response.Body != nil {
+		_ = response.Body.Close()
+	}
+	response.Body = io.NopCloser(bytes.NewReader(body))
+	response.ContentLength = int64(len(body))
+	response.TransferEncoding = nil
+	response.Uncompressed = false
+	response.Header.Del("Transfer-Encoding")
+	response.Header.Set("Content-Length", strconv.Itoa(len(body)))
+	if decoded {
+		response.Header.Del("Content-Encoding")
+	}
+}
+
+func cloneScriptHeaders(headers http.Header) http.Header {
+	if headers == nil {
+		return nil
+	}
+	cloned := headers.Clone()
+	sanitizeHeaders(cloned)
+	cloned.Del("Host")
+	return cloned
+}
+
+func replaceRequestHeaders(request *http.Request, headers http.Header) {
+	if headers == nil {
+		return
+	}
+	host := headers.Get("Host")
+	request.Header = cloneScriptHeaders(headers)
+	if host != "" {
+		request.Host = host
+	}
+}
+
+func replaceResponseHeaders(response *http.Response, headers http.Header) {
+	if headers != nil {
+		response.Header = headers.Clone()
+		sanitizeHeaders(response.Header)
+	}
+}
+
+func sanitizeHeaders(headers http.Header) {
+	for name, values := range headers {
+		if !httpguts.ValidHeaderFieldName(name) || strings.HasPrefix(name, ":") {
+			headers.Del(name)
+			continue
+		}
+		validValues := values[:0]
+		for _, value := range values {
+			if httpguts.ValidHeaderFieldValue(value) {
+				validValues = append(validValues, value)
+			}
+		}
+		if len(validValues) == 0 {
+			headers.Del(name)
+		} else {
+			headers[name] = validValues
+		}
+	}
+}
+
+func normalizeRequestFraming(request *http.Request) {
+	removeHopByHopHeaders(request.Header)
+	request.Header.Del("Content-Length")
+	request.Header.Del("Transfer-Encoding")
+	if request.ContentLength == 0 && request.Body == nil {
+		request.Body = http.NoBody
+	}
+}
+
+func normalizeResponseFraming(response *http.Response) {
+	removeHopByHopHeaders(response.Header)
+	response.Header.Del("Transfer-Encoding")
+	response.TransferEncoding = nil
+	if response.ContentLength >= 0 {
+		response.Header.Set("Content-Length", strconv.FormatInt(response.ContentLength, 10))
+	} else {
+		response.Header.Del("Content-Length")
+	}
+}
+
+func removeHopByHopHeaders(headers http.Header) {
+	for _, connectionValue := range headers.Values("Connection") {
+		for _, name := range strings.Split(connectionValue, ",") {
+			headers.Del(strings.TrimSpace(name))
+		}
+	}
+	for _, name := range []string{
+		"Connection",
+		"Proxy-Connection",
+		"Keep-Alive",
+		"Proxy-Authenticate",
+		"Proxy-Authorization",
+		"Te",
+		"Trailer",
+		"Transfer-Encoding",
+		"Upgrade",
+	} {
+		headers.Del(name)
+	}
+}
+
+func applyRequestHeaderRewrite(request *http.Request, rule *option.SurgeHeaderRewriteLine) {
+	if strings.EqualFold(rule.Key, "Host") {
+		switch {
+		case rule.Add, rule.Replace:
+			request.Host = rule.Value
+		case rule.Delete:
+			request.Host = ""
+		case rule.ReplaceRegex:
+			request.Host = rule.Match.ReplaceAllString(request.Host, rule.Value)
+		}
+		return
+	}
+	applyHeaderRewrite(request.Header, rule)
+}
+
+func applyHeaderRewrite(headers http.Header, rule *option.SurgeHeaderRewriteLine) {
+	switch {
+	case rule.Add:
+		headers.Add(rule.Key, rule.Value)
+	case rule.Delete:
+		headers.Del(rule.Key)
+	case rule.Replace:
+		if headers.Get(rule.Key) != "" {
+			headers.Set(rule.Key, rule.Value)
+		}
+	case rule.ReplaceRegex:
+		if values, loaded := headers[http.CanonicalHeaderKey(rule.Key)]; loaded {
+			for index, value := range values {
+				values[index] = rule.Match.ReplaceAllString(value, rule.Value)
+			}
+			headers[http.CanonicalHeaderKey(rule.Key)] = values
+		}
+	}
+}
+
+func applyJQBodyRewrite(ctx context.Context, body []byte, rule *option.SurgeBodyRewriteLine, limit int64) ([]byte, error) {
+	if rule.JQCode == nil {
+		return nil, fmt.Errorf("jq expression is not compiled")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	decoder.UseNumber()
+	var input any
+	if err := decoder.Decode(&input); err != nil {
+		return nil, fmt.Errorf("decode JSON body: %w", err)
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return nil, fmt.Errorf("JSON body contains multiple values")
+		}
+		return nil, fmt.Errorf("decode trailing JSON body: %w", err)
+	}
+
+	iterator := rule.JQCode.RunWithContext(ctx, input)
+	result, loaded := iterator.Next()
+	if !loaded {
+		return nil, fmt.Errorf("jq expression produced no result")
+	}
+	if runErr, isError := result.(error); isError {
+		return nil, fmt.Errorf("execute jq expression: %w", runErr)
+	}
+	if extra, hasExtra := iterator.Next(); hasExtra {
+		if runErr, isError := extra.(error); isError {
+			return nil, fmt.Errorf("execute jq expression: %w", runErr)
+		}
+		return nil, fmt.Errorf("jq expression produced multiple results")
+	}
+	rewritten, err := json.Marshal(result)
+	if err != nil {
+		return nil, fmt.Errorf("encode jq result: %w", err)
+	}
+	if int64(len(rewritten)) > limit {
+		return nil, fmt.Errorf("jq result exceeds limit: %d > %d", len(rewritten), limit)
+	}
+	return rewritten, nil
+}
