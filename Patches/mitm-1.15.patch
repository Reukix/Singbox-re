--- /dev/null
+++ b/daemon/log_ring_test.go
@@ -0,0 +1,54 @@
+package daemon
+
+import (
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/sagernet/sing-box/log"
+)
+
+func TestLogRingBoundsLinesAndBytes(t *testing.T) {
+	previous := logRingMaxBytes
+	logRingMaxBytes = 1000
+	defer func() { logRingMaxBytes = previous }()
+
+	ring := logRing{maxLines: 4}
+	for index := range 6 {
+		ring.push(&log.Entry{Message: strings.Repeat(string(rune('a'+index)), 10)})
+	}
+	entries := ring.array()
+	if len(entries) != 4 || entries[0].Message[0] != 'c' || entries[3].Message[0] != 'f' {
+		t.Fatalf("line bound broken: %d entries, first %q", len(entries), entries[0].Message)
+	}
+	ring.push(&log.Entry{Message: strings.Repeat("x", 990)})
+	entries = ring.array()
+	if ring.bytes > logRingMaxBytes {
+		t.Fatalf("ring holds %d bytes, bound %d", ring.bytes, logRingMaxBytes)
+	}
+	if entries[len(entries)-1].Message[0] != 'x' {
+		t.Fatal("newest entry was dropped")
+	}
+	ring.push(&log.Entry{Message: strings.Repeat("y", 5000)})
+	if entries = ring.array(); len(entries) != 1 {
+		t.Fatalf("an oversized entry must keep only itself, got %d entries", len(entries))
+	}
+	ring.reset()
+	if len(ring.array()) != 0 || ring.bytes != 0 {
+		t.Fatal("reset left entries behind")
+	}
+}
+
+func TestTruncateLogMessageKeepsUTF8(t *testing.T) {
+	message := strings.Repeat("日志", logEntryMaxBytes)
+	truncated := truncateLogMessage(message)
+	if !utf8.ValidString(truncated) {
+		t.Fatal("truncation split a UTF-8 sequence")
+	}
+	if len(truncated) > logEntryMaxBytes+64 {
+		t.Fatalf("truncated message still %d bytes", len(truncated))
+	}
+	if short := "short"; truncateLogMessage(short) != short {
+		t.Fatal("short message changed")
+	}
+}
