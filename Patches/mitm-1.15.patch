+	}
+}
+
+func TestSurgeDollarAliases(t *testing.T) {
+	runtime := goja.New()
+	request := runtime.NewObject()
+	request.Set("url", "https://example.com/request")
+	response := runtime.NewObject()
+	response.Set("status", 200)
+	response.Set("statusCode", 200)
+	response.Set("body", "body")
+	response.Set("bodyBytes", runtime.NewArrayBuffer([]byte{1, 2, 3}))
+
+	setSurgeRequestAliases(runtime, request)
+	setSurgeResponseAliases(runtime, response)
+	doneCalled := false
+	setSurgeDoneAliases(runtime, func(goja.FunctionCall) goja.Value {
+		doneCalled = true
+		return goja.Undefined()
+	})
+
+	_, err := runtime.RunString(`
+if ($request.url !== request.url) throw new Error("$request alias mismatch");
+if ($response.status !== 200 || $response.statusCode !== 200) throw new Error("$response status alias mismatch");
+if ($response.bodyBytes.byteLength !== 3) throw new Error("$response bodyBytes alias mismatch");
+$done({});
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !doneCalled {
+		t.Fatal("$done alias was not called")
+	}
