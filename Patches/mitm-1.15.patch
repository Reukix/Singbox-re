@@ -0,0 +1,41 @@
+package option
+
+import (
+	"testing"
+
+	"github.com/sagernet/sing/common/json"
+)
+
+func TestScriptSourceFields(t *testing.T) {
+	testCases := []struct {
+		name     string
+		content  string
+		expected string
+	}{
+		{
+			name:     "local",
+			content:  `{"type":"surge","tag":"local","source":"local","path":"script.js"}`,
+			expected: "script.js",
+		},
+		{
+			name:     "remote",
+			content:  `{"type":"surge","tag":"remote","source":"remote","url":"https://example.com/script.js","update_interval":"1d"}`,
+			expected: "https://example.com/script.js",
+		},
+	}
+	for _, testCase := range testCases {
+		t.Run(testCase.name, func(t *testing.T) {
+			var script Script
+			err := json.Unmarshal([]byte(testCase.content), &script)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if script.Source == "local" && script.LocalOptions.Path != testCase.expected {
+				t.Fatalf("unexpected local path: %s", script.LocalOptions.Path)
+			}
+			if script.Source == "remote" && script.RemoteOptions.URL != testCase.expected {
+				t.Fatalf("unexpected remote URL: %s", script.RemoteOptions.URL)
+			}
+		})
+	}
+}
