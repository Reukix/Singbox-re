diff --git a/experimental/libbox/script_engine.go b/experimental/libbox/script_engine.go
new file mode 100644
index 000000000..a1c2d7f9a
--- /dev/null
+++ b/experimental/libbox/script_engine.go
@@ -0,0 +1,45 @@
+package libbox
+
+import "github.com/sagernet/sing-box/script"
+
+// ScriptEngine runs Surge scripts outside the Go runtime. The iOS Network
+// Extension implements it with WebKit, whose JavaScript runs in a separate
+// content process and so does not count against the extension's memory
+// limit.
+//
+// Execute blocks until the run finishes and never fails: problems are
+// reported through the returned outcome JSON. scriptID changes whenever the
+// script source does, so the engine may cache the compiled script by it and
+// only call host.Source for new IDs. timeout is in milliseconds. body is the
+// data of the invocation's message body, kept out of the JSON; the outcome
+// may carry the result body after a newline the same way.
+type ScriptEngine interface {
+	Execute(scriptID string, timeout int64, invocation string, body string, host ScriptHost) string
+}
+
+// ScriptHost serves a script that runs in a ScriptEngine.
+type ScriptHost interface {
+	Source() string
+	// Call serves one API call, such as $httpClient or $persistentStore.
+	// arguments and the result are JSON objects; failures are reported as
+	// {"error": "..."}.
+	Call(method string, arguments string) string
+}
+
+// SetScriptEngine installs the platform script engine; nil removes it and
+// scripts run in goja again.
+func SetScriptEngine(engine ScriptEngine) {
+	if engine == nil {
+		script.SetPlatformEngine(nil)
+		return
+	}
+	script.SetPlatformEngine(&scriptEngineAdapter{engine: engine})
+}
+
+type scriptEngineAdapter struct {
+	engine ScriptEngine
+}
+
+func (a *scriptEngineAdapter) Execute(scriptID string, timeout int64, invocation string, body string, host script.PlatformHost) string {
+	return a.engine.Execute(scriptID, timeout, invocation, body, host)
+}
