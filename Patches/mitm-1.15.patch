+package mitm
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"regexp"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+
+	"golang.org/x/sync/semaphore"
+)
+
+func TestBufferHTTPBodyGzip(t *testing.T) {
+	var compressed bytes.Buffer
+	writer := gzip.NewWriter(&compressed)
+	_, _ = writer.Write([]byte("decoded body"))
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	headers := make(http.Header)
+	headers.Set("Content-Encoding", "gzip")
+	body, replay, available, decoded, err := bufferHTTPBody(
+		io.NopCloser(bytes.NewReader(compressed.Bytes())),
+		int64(compressed.Len()),
+		headers,
+		1024,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer replay.Close()
+	if !available || !decoded || string(body) != "decoded body" {
+		t.Fatalf("unexpected decoded body: available=%v decoded=%v body=%q", available, decoded, body)
+	}
+}
+
+func TestSurgePatternMatchesHostAndConnectionHost(t *testing.T) {
+	pattern := regexp.MustCompile(`^https://logical\.example/`)
+	if !surgePatternMatches(pattern, "https://1.2.3.4/path", "logical.example", "") {
+		t.Fatal("pattern did not match rebuilt Host URL")
+	}
+	if !surgePatternMatches(pattern, "https://1.2.3.4/path", "other.example", "logical.example") {
+		t.Fatal("pattern did not match rebuilt connection-host URL")
+	}
+}
+
+func TestBufferHTTPBodyTooLargeReplaysEverything(t *testing.T) {
+	original := []byte("0123456789")
+	_, replay, available, _, err := bufferHTTPBody(
+		io.NopCloser(bytes.NewReader(original)),
+		-1,
+		make(http.Header),
+		4,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer replay.Close()
+	if available {
+		t.Fatal("oversized body unexpectedly available")
+	}
+	replayed, err := io.ReadAll(replay)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(replayed, original) {
+		t.Fatalf("replayed body changed: %q", replayed)
+	}
+}
+
+func TestSetResponseBodyOwnsFraming(t *testing.T) {
+	response := &http.Response{
+		Header: http.Header{
+			"Content-Encoding":  []string{"gzip"},
+			"Content-Length":    []string{"999"},
+			"Transfer-Encoding": []string{"chunked"},
+		},
+		Body:             io.NopCloser(bytes.NewReader(nil)),
+		ContentLength:    999,
+		TransferEncoding: []string{"chunked"},
+	}
+	setResponseBody(response, []byte("new"), true)
+	if response.ContentLength != 3 || response.Header.Get("Content-Length") != "3" {
+		t.Fatalf("incorrect content length: %d / %s", response.ContentLength, response.Header.Get("Content-Length"))
+	}
+	if response.Header.Get("Content-Encoding") != "" || len(response.TransferEncoding) != 0 {
+		t.Fatal("stale body framing was retained")
+	}
+}
+
+func TestReplaceRequestHeadersCanDelete(t *testing.T) {
+	request, err := http.NewRequest(http.MethodGet, "https://example.com/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request.Header.Set("X-Delete", "old")
+	replaceRequestHeaders(request, http.Header{"X-Keep": []string{"new"}})
+	if request.Header.Get("X-Delete") != "" || request.Header.Get("X-Keep") != "new" {
+		t.Fatalf("headers were not replaced: %v", request.Header)
+	}
+}
+
+func TestSurgeJQBodyRewriteExamples(t *testing.T) {
+	tests := []struct {
+		name       string
+		line       string
+		input      string
+		assertions func(t *testing.T, value map[string]any)
+	}{
+		{
+			name:  "JD setpath",
+			line:  `http-response-jq ^https://api\.m\.jd\.com/ 'if (getpath(["data","JDMessage","socketmonitor"]) | has("isSocketEstablishedAhead")) then (setpath(["data","JDMessage","socketmonitor","isSocketEstablishedAhead"]; 0)) else . end'`,
+			input: `{"data":{"JDMessage":{"socketmonitor":{"isSocketEstablishedAhead":1,"keep":true}}}}`,
+			assertions: func(t *testing.T, value map[string]any) {
+				monitor := value["data"].(map[string]any)["JDMessage"].(map[string]any)["socketmonitor"].(map[string]any)
+				if monitor["isSocketEstablishedAhead"] != float64(0) || monitor["keep"] != true {
+					t.Fatalf("unexpected JD result: %#v", value)
+				}
+			},
+		},
+		{
+			name:  "Bilibili nested assignment",
+			line:  `http-response-jq ^https://api\.bilibili\.com/ '.data[][]?="stun.chat.bilibili.com:3478"'`,
+			input: `{"data":[[1,2],[3]]}`,
+			assertions: func(t *testing.T, value map[string]any) {
+				for _, group := range value["data"].([]any) {
+					for _, item := range group.([]any) {
+						if item != "stun.chat.bilibili.com:3478" {
+							t.Fatalf("unexpected Bilibili result: %#v", value)
+						}
+					}
+				}
+			},
+		},
+		{
+			name:  "Pinduoduo delpaths",
+			line:  `http-response-jq ^https://api\.pinduoduo\.com/ 'delpaths([["result","dy_module","irregular_banner_dy"]])'`,
+			input: `{"result":{"dy_module":{"irregular_banner_dy":{"ad":true},"keep":1}}}`,
+			assertions: func(t *testing.T, value map[string]any) {
+				dyModule := value["result"].(map[string]any)["dy_module"].(map[string]any)
+				if _, exists := dyModule["irregular_banner_dy"]; exists || dyModule["keep"] != float64(1) {
+					t.Fatalf("unexpected Pinduoduo result: %#v", value)
+				}
+			},
+		},
+		{
+			name:  "Goofish filters",
+			line:  `http-response-jq ^https://acs\.m\.goofish\.com/ '.data.homeTopList |= map(select(.sectionType == "kingkongDo")) | .data.sections |= map(select(.data.clickParam.args.cardType as $ct | $ct != "homeMultiBanner" and $ct != "mamaAD")) | .data.sections |= map(select((.template.name|type=="string")and(.template.name=="idlefish_home_new_commodity_card"or(.template.name|contains("fish_home_tags_item_card")))))'`,
+			input: `{"data":{"homeTopList":[{"sectionType":"kingkongDo"},{"sectionType":"other"}],"sections":[{"data":{"clickParam":{"args":{"cardType":"homeMultiBanner"}}},"template":{"name":"idlefish_home_new_commodity_card"}},{"data":{"clickParam":{"args":{"cardType":"normal"}}},"template":{"name":"idlefish_home_new_commodity_card"}},{"data":{"clickParam":{"args":{"cardType":"normal"}}},"template":{"name":"unrelated"}}]}}`,
+			assertions: func(t *testing.T, value map[string]any) {
+				data := value["data"].(map[string]any)
+				if len(data["homeTopList"].([]any)) != 1 || len(data["sections"].([]any)) != 1 {
+					t.Fatalf("unexpected Goofish result: %#v", value)
+				}
+			},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			var rule option.SurgeBodyRewriteLine
+			lineJSON, err := json.Marshal(test.line)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = json.Unmarshal(lineJSON, &rule); err != nil {
+				t.Fatal(err)
+			}
+			result, err := applyJQBodyRewrite(context.Background(), []byte(test.input), &rule, 1024*1024)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var value map[string]any
+			if err = json.Unmarshal(result, &value); err != nil {
+				t.Fatalf("invalid result %q: %v", result, err)
+			}
+			test.assertions(t, value)
+		})
+	}
+}
+
+func TestBufferBodyBudgetFailOpen(t *testing.T) {
+	engine := &Engine{bodyBuffer: semaphore.NewWeighted(64)}
+	ctx := context.Background()
+	var hold bodyBufferHold
+	payload := bytes.Repeat([]byte("a"), 64)
+	body1, replay1, available1, _, denied1, err := engine.bufferBody(ctx, &hold, io.NopCloser(bytes.NewReader(payload)), 64, nil, 64)
+	if err != nil || denied1 || !available1 || len(body1) != 64 {
+		t.Fatalf("first buffer: err=%v denied=%v available=%v len=%d", err, denied1, available1, len(body1))
+	}
+	_ = replay1.Close()
+
+	acquireCtx, cancel := context.WithCancel(ctx)
+	cancel()
+	body2, replay2, available2, _, denied2, err := engine.bufferBody(acquireCtx, &hold, io.NopCloser(bytes.NewReader(payload)), 64, nil, 64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !denied2 || available2 || body2 != nil {
+		t.Fatalf("second buffer should fail open: denied=%v available=%v len=%d", denied2, available2, len(body2))
+	}
+	left, readErr := io.ReadAll(replay2)
+	if readErr != nil || len(left) != 64 {
+		t.Fatalf("denied replay must be the untouched body: err=%v len=%d", readErr, len(left))
+	}
+
+	engine.releaseBodyBuffer(&hold)
+	_, replay3, available3, _, denied3, err := engine.bufferBody(ctx, &hold, io.NopCloser(bytes.NewReader(payload)), 64, nil, 64)
+	if err != nil || denied3 || !available3 {
+		t.Fatalf("budget must be reclaimed after release: err=%v denied=%v available=%v", err, denied3, available3)
+	}
+	_ = replay3.Close()
+	engine.releaseBodyBuffer(&hold)
+}
