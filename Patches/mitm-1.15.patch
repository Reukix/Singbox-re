+	session.begin()
+	defer session.end()
+	rawRequestURL := request.URL
+	if tlsConfig != nil {
+		rawRequestURL.Scheme = "https"
+	} else {
+		rawRequestURL.Scheme = "http"
+	}
+	if rawRequestURL.Host == "" {
+		rawRequestURL.Host = request.Host
+	}
+	requestURL := rawRequestURL.String()
+	request.RequestURI = ""
+	var (
+		requestMatch         bool
+		requestScript        adapter.SurgeScript
+		requestScriptOptions option.MITMRouteSurgeScriptOptions
+	)
+	var (
+		body        []byte
+		bodyDecoded bool
+	)
+	hold := bodyBufferHold{budget: e.bodyBuffer}
+	defer e.releaseBodyBuffer(&hold)
+	if options.Print && request.ContentLength > 0 && request.ContentLength <= e.limits.printBody {
+		var available bool
+		var denied bool
+		var printBody []byte
+		printBody, request.Body, available, _, denied, err = e.bufferBody(ctx, &hold, request.Body, request.ContentLength, nil, e.limits.printBody)
+		if err != nil {
+			return E.Cause(err, "read HTTP request body")
+		}
+		if available {
+			e.printRequest(ctx, request, printBody)
+		} else {
+			if denied {
+				e.logger.WarnContext(ctx, "print body skipped: body buffer budget exhausted")
+			}
+			e.printRequest(ctx, request, nil)
+		}
+	} else if options.Print {
+		e.printRequest(ctx, request, body)
+	}
+	{
+		for i, rule := range options.SurgeHeaderRewrite {
+			if rule.Response {
+				continue
+			}
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			requestMatch = true
+			e.logger.DebugContext(ctx, "match header_rewrite[", i, "] => ", rule.String())
+			applyRequestHeaderRewrite(request, &rule)
+		}
+		for i, rule := range options.SurgeURLRewrite {
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			e.logger.DebugContext(ctx, "match url_rewrite[", i, "] => ", rule.String())
+			if rule.Reject {
+				return E.New("request rejected by url_rewrite")
+			} else if rule.RedirectCode > 0 {
+				destination := rule.Pattern.ReplaceAllString(requestURL, rule.Destination.String())
