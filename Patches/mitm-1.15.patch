+	closeErr := response.Body.Close()
+	if err != nil {
+		return E.Cause(err, "write HTTP response")
+	} else if closeErr != nil {
+		return E.Cause(closeErr, "close HTTP response body")
+	}
+	if request.Close || response.Close {
+		return nil
+	}
+	return errHTTP1KeepAlive
+}
+
+func (e *Engine) newHTTP2(ctx context.Context, this N.Dialer, conn net.Conn, tlsConfig *tls.Config, metadata adapter.InboundContext, session *mitmSession) error {
+	handler := &engineHandler{
+		Engine:    e,
+		tlsConfig: tlsConfig,
+		dialer:    this,
+		metadata:  metadata,
+		session:   session,
+	}
+	// The client is local, so small receive windows and frames cost no
+	// throughput while bounding what one connection can make us buffer.
+	http2Server := &http2.Server{
+		MaxConcurrentStreams:         e.limits.serverMaxConcurrentStreams,
+		MaxReadFrameSize:             e.limits.serverMaxReadFrameSize,
+		MaxUploadBufferPerConnection: e.limits.serverConnectionWindow,
+		MaxUploadBufferPerStream:     e.limits.serverStreamWindow,
+		IdleTimeout:                  e.limits.serverIdleTimeout,
+	}
+	http2Server.ServeConn(conn, &http2.ServeConnOpts{
+		Context: ctx,
+		Handler: handler,
+	})
+	return nil
+}
+
+type engineHandler struct {
+	*Engine
+	tlsConfig *tls.Config
+	dialer    N.Dialer
+	metadata  adapter.InboundContext
+	session   *mitmSession
+}
+
+func (e *engineHandler) ServeHTTP(writer http.ResponseWriter, request *http.Request) {
+	e.session.begin()
+	defer e.session.end()
+	trackedWriter := &trackingResponseWriter{ResponseWriter: writer}
+	err := e.serveHTTP(request.Context(), trackedWriter, request)
+	if err != nil {
+		if E.IsClosedOrCanceled(err) {
+			e.logger.DebugContext(request.Context(), E.Cause(err, "connection closed"))
+		} else {
+			e.logger.ErrorContext(request.Context(), err)
+		}
+		if !trackedWriter.wroteHeader {
+			http.Error(trackedWriter, http.StatusText(http.StatusBadGateway), http.StatusBadGateway)
+		}
+	}
+}
+
+func (e *engineHandler) serveHTTP(ctx context.Context, writer http.ResponseWriter, request *http.Request) error {
+	metadata := e.metadata
+	tlsConfig := e.tlsConfig.Clone()
