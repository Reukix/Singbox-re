diff --git a/script/compile.go b/script/compile.go
new file mode 100644
index 000000000..1662dd7ef
--- /dev/null
+++ b/script/compile.go
@@ -0,0 +1,36 @@
+//go:build with_script
+
+package script
+
+import (
+	"regexp"
+	"strings"
+
+	"github.com/dop251/goja"
+)
+
+var surgeForAwaitPattern = regexp.MustCompile(`\bfor\s+await\s*\(`)
+
+// compileScript accepts the top-level return form used by some Surge modules.
+// Standard JavaScript rejects it, so retry in a function scope only for that
+// specific syntax error and preserve normal script semantics otherwise.
+func compileScript(name string, content string) (*goja.Program, error) {
+	// goja supports async functions and await, but not for-await syntax. Surge
+	// modules such as Script Hub use for-await with synchronous array iterators,
+	// for which a regular for-of loop has identical behavior.
+	content = surgeForAwaitPattern.ReplaceAllString(content, "for (")
+	program, err := goja.Compile(name, content, false)
+	if err == nil {
+		return program, err
+	}
+	if strings.Contains(err.Error(), "Illegal return statement") {
+		program, wrappedErr := goja.Compile(name, "(function() {\n"+content+"\n})()", false)
+		if wrappedErr == nil {
+			return program, nil
+		}
+	}
+	if strings.Contains(content, "await") {
+		return goja.Compile(name, "(async function() {\n"+content+"\n})()", false)
+	}
+	return nil, err
+}
