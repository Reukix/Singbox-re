+func (s *testScriptSource) Close() error                                                  { return nil }
+
+func newTestSurgeScript(t *testing.T, content string) *SurgeScript {
+	t.Helper()
+	program, err := compileScript("test.js", content)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &SurgeScript{
+		tag:    "test",
+		logger: log.NewNOPFactory().NewLogger("test"),
+		source: &testScriptSource{program: program, text: content, fingerprint: "test-fingerprint"},
+	}
+}
+
+func TestCompileScriptTopLevelReturn(t *testing.T) {
+	program, err := compileScript("top-level-return.js", `if (true) { return; }`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	runtime := goja.New()
+	if _, err = runtime.RunProgram(program); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCompileScriptTopLevelAwaitAndForAwait(t *testing.T) {
+	program, err := compileScript("top-level-await.js", `
