+package mitm
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/tls"
+	"errors"
+	"io"
+	"math"
+	"mime"
+	"net"
+	"net/http"
+	"net/url"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/badhttp"
+	"github.com/sagernet/sing-box/common/dialer"
+	sTLS "github.com/sagernet/sing-box/common/tls"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common"
+	"github.com/sagernet/sing/common/atomic"
+	E "github.com/sagernet/sing/common/exceptions"
+	F "github.com/sagernet/sing/common/format"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/ntp"
+	"github.com/sagernet/sing/service"
+	"github.com/sagernet/sing/service/filemanager"
+
+	"golang.org/x/net/http2"
+	"golang.org/x/sync/semaphore"
+)
+
+const (
+	bodyBufferBudgetBytes int64 = 6 * 1024 * 1024
+	bodyBufferAcquireWait       = 5 * time.Second
+)
+
+type bodyBufferHold struct {
+	claims []int64
+}
+
+func surgePatternMatches(pattern *regexp.Regexp, requestURL, host, connectionHost string) bool {
+	if pattern.MatchString(requestURL) {
+		return true
+	}
+	if host != "" {
+		if parsed, err := url.Parse(requestURL); err == nil {
+			parsed.Host = host
+			if pattern.MatchString(parsed.String()) {
+				return true
+			}
+		}
+	}
+	if connectionHost != "" {
+		if parsed, err := url.Parse(requestURL); err == nil {
+			parsed.Host = connectionHost
+			return pattern.MatchString(parsed.String())
+		}
+	}
+	return false
+}
+
+func surgeConnectionHost(metadata adapter.InboundContext) string {
+	if metadata.ClientHello != nil {
+		return metadata.ClientHello.ServerName
+	}
+	return metadata.Domain
+}
+
+var _ adapter.MITMEngine = (*Engine)(nil)
+
+type Engine struct {
+	ctx          context.Context
+	logger       logger.ContextLogger
+	connection   adapter.ConnectionManager
+	certificate  adapter.CertificateStore
+	script       adapter.ScriptManager
+	timeFunc     func() time.Time
+	http2Enabled bool
+	leafAccess   sync.Mutex
+	leafCache    map[string]cachedLeafCertificate
+	bodyBuffer   *semaphore.Weighted
+}
+
+type cachedLeafCertificate struct {
+	certificate *tls.Certificate
+	expiresAt   time.Time
+}
+
+func NewEngine(ctx context.Context, logger logger.ContextLogger, options option.MITMOptions) (*Engine, error) {
+	engine := &Engine{
+		ctx:          ctx,
+		logger:       logger,
+		http2Enabled: options.HTTP2Enabled,
+		leafCache:    make(map[string]cachedLeafCertificate),
+		bodyBuffer:   semaphore.NewWeighted(bodyBufferBudgetBytes),
+	}
+	return engine, nil
+}
+
+func (e *Engine) bufferBody(ctx context.Context, hold *bodyBufferHold, body io.ReadCloser, contentLength int64, headers http.Header, limit int64) (content []byte, replay io.ReadCloser, available bool, decoded bool, denied bool, err error) {
+	if body == nil || body == http.NoBody || contentLength == 0 {
+		return []byte{}, http.NoBody, true, false, false, nil
+	}
+	if limit <= 0 {
+		limit = responseRewriteBodyLimit
+	}
+	if contentLength > limit {
+		return nil, body, false, false, false, nil
+	}
+	claim := min(limit, bodyBufferBudgetBytes)
+	acquireCtx, cancel := context.WithTimeout(ctx, bodyBufferAcquireWait)
+	acquireErr := e.bodyBuffer.Acquire(acquireCtx, claim)
+	cancel()
+	if acquireErr != nil {
+		return nil, body, false, false, true, nil
+	}
+	hold.claims = append(hold.claims, claim)
+	content, replay, available, decoded, err = bufferHTTPBody(body, contentLength, headers, limit)
+	return content, replay, available, decoded, false, err
+}
+
+func (e *Engine) releaseBodyBuffer(hold *bodyBufferHold) {
+	for _, claim := range hold.claims {
+		e.bodyBuffer.Release(claim)
+	}
+	hold.claims = nil
+}
+
+func (e *Engine) Start(stage adapter.StartStage) error {
+	switch stage {
+	case adapter.StartStateInitialize:
+		e.connection = service.FromContext[adapter.ConnectionManager](e.ctx)
+		e.certificate = service.FromContext[adapter.CertificateStore](e.ctx)
+		e.script = service.FromContext[adapter.ScriptManager](e.ctx)
+		e.timeFunc = ntp.TimeFuncFromContext(e.ctx)
+		if e.timeFunc == nil {
+			e.timeFunc = time.Now
+		}
+	}
+	return nil
+}
+
+func (e *Engine) Close() error {
+	e.leafAccess.Lock()
+	clear(e.leafCache)
+	e.leafAccess.Unlock()
+	return nil
+}
+
+func (e *Engine) NewConnection(ctx context.Context, this N.Dialer, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	if e.certificate != nil && e.certificate.TLSDecryptionEnabled() && metadata.ClientHello != nil {
+		err := e.newTLS(ctx, this, conn, metadata, onClose)
+		if err != nil {
+			e.logger.ErrorContext(ctx, err)
+		} else {
+			e.logger.DebugContext(ctx, "connection closed")
+		}
+		if onClose != nil {
+			onClose(err)
+		}
+		return
+	} else if metadata.HTTPRequest != nil {
+		err := e.newHTTP1(ctx, this, conn, nil, metadata)
+		if err != nil {
+			e.logger.ErrorContext(ctx, err)
+		} else {
+			e.logger.DebugContext(ctx, "connection closed")
+		}
+		if onClose != nil {
+			onClose(err)
+		}
+		return
+	} else {
+		e.logger.DebugContext(ctx, "HTTP and TLS not detected, skipped")
+	}
+	metadata.MITM = nil
+	e.connection.NewConnection(ctx, this, conn, metadata, onClose)
+}
+
+func (e *Engine) newTLS(ctx context.Context, this N.Dialer, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) error {
+	acceptHTTP := len(metadata.ClientHello.SupportedProtos) == 0 || common.Contains(metadata.ClientHello.SupportedProtos, "http/1.1")
+	acceptH2 := e.http2Enabled && common.Contains(metadata.ClientHello.SupportedProtos, "h2")
+	if !acceptHTTP && !acceptH2 {
+		metadata.MITM = nil
+		e.logger.DebugContext(ctx, "unsupported application protocol: ", strings.Join(metadata.ClientHello.SupportedProtos, ","))
+		e.connection.NewConnection(ctx, this, conn, metadata, onClose)
+		return nil
+	}
+	var nextProtos []string
+	if acceptH2 {
+		nextProtos = append(nextProtos, "h2")
+	}
+	if acceptHTTP {
+		nextProtos = append(nextProtos, "http/1.1")
+	}
+	var (
+		maxVersion uint16
+		minVersion uint16
+	)
+	for _, version := range metadata.ClientHello.SupportedVersions {
+		maxVersion = common.Max(maxVersion, version)
+		if minVersion == 0 || version < minVersion {
+			minVersion = version
+		}
+	}
+	serverName := metadata.ClientHello.ServerName
+	if serverName == "" {
+		serverName = metadata.Destination.AddrString()
+	}
+	if serverName == "" {
+		metadata.MITM = nil
+		e.logger.WarnContext(ctx, "MITM skipped because TLS server name is unavailable")
+		e.connection.NewConnection(ctx, this, conn, metadata, onClose)
+		return nil
+	}
+	serverTLSConfig := &tls.Config{
+		Time:       e.timeFunc,
+		NextProtos: nextProtos,
+		MinVersion: minVersion,
+		MaxVersion: maxVersion,
+		GetCertificate: func(info *tls.ClientHelloInfo) (*tls.Certificate, error) {
+			certificateName := info.ServerName
+			if certificateName == "" {
+				certificateName = serverName
+			}
+			return e.leafCertificate(certificateName)
+		},
+	}
+	tlsConn := tls.Server(conn, serverTLSConfig)
+	err := tlsConn.HandshakeContext(ctx)
+	if err != nil {
+		return E.Cause(err, "TLS handshake failed for ", metadata.ClientHello.ServerName, ", ", strings.Join(metadata.ClientHello.SupportedProtos, ", "))
+	}
+	upstreamTLSConfig := &tls.Config{
+		Time:       e.timeFunc,
+		ServerName: serverName,
+		MinVersion: minVersion,
+		MaxVersion: maxVersion,
+	}
+	if tlsConn.ConnectionState().NegotiatedProtocol == "h2" {
+		return e.newHTTP2(ctx, this, tlsConn, upstreamTLSConfig, metadata, onClose)
+	} else {
+		return e.newHTTP1(ctx, this, tlsConn, upstreamTLSConfig, metadata)
+	}
+}
+
+func (e *Engine) leafCertificate(serverName string) (*tls.Certificate, error) {
+	now := e.timeFunc()
+	e.leafAccess.Lock()
+	defer e.leafAccess.Unlock()
+	if cached, loaded := e.leafCache[serverName]; loaded && now.Before(cached.expiresAt) {
+		return cached.certificate, nil
+	}
+	certificate, err := sTLS.GenerateKeyPair(
+		e.certificate.TLSDecryptionCertificate(),
+		e.certificate.TLSDecryptionPrivateKey(),
+		e.timeFunc,
+		serverName,
+	)
+	if err != nil {
+		return nil, err
+	}
+	if len(e.leafCache) >= 256 {
+		for name := range e.leafCache {
+			delete(e.leafCache, name)
+			break
+		}
+	}
+	e.leafCache[serverName] = cachedLeafCertificate{
+		certificate: certificate,
+		expiresAt:   now.Add(45 * time.Minute),
+	}
+	return certificate, nil
+}
+
+var errHTTP1KeepAlive = errors.New("continue HTTP/1 connection")
+
+func (e *Engine) newHTTP1(ctx context.Context, this N.Dialer, conn net.Conn, tlsConfig *tls.Config, metadata adapter.InboundContext) error {
+	defer conn.Close()
+	reader := bufio.NewReader(conn)
+	for {
+		requestTLSConfig := tlsConfig
+		if requestTLSConfig != nil {
+			requestTLSConfig = requestTLSConfig.Clone()
+		}
+		err := e.handleHTTP1(ctx, this, conn, reader, requestTLSConfig, metadata)
+		switch {
+		case errors.Is(err, errHTTP1KeepAlive):
+			continue
+		case errors.Is(err, io.EOF), errors.Is(err, net.ErrClosed):
+			return nil
+		default:
+			return err
+		}
+	}
+}
+
+func (e *Engine) handleHTTP1(ctx context.Context, this N.Dialer, conn net.Conn, reader *bufio.Reader, tlsConfig *tls.Config, metadata adapter.InboundContext) error {
+	options := metadata.MITM
+	request, err := badhttp.ReadRequest(reader)
+	if err != nil {
+		if errors.Is(err, io.EOF) {
+			return io.EOF
+		}
+		return E.Cause(err, "read HTTP request")
+	}
+	rawRequestURL := request.URL
+	if tlsConfig != nil {
+		rawRequestURL.Scheme = "https"
+	} else {
+		rawRequestURL.Scheme = "http"
+	}
+	if rawRequestURL.Host == "" {
+		rawRequestURL.Host = request.Host
+	}
+	requestURL := rawRequestURL.String()
+	request.RequestURI = ""
+	var (
+		requestMatch         bool
+		requestScript        adapter.SurgeScript
+		requestScriptOptions option.MITMRouteSurgeScriptOptions
+	)
+	var (
+		body        []byte
+		bodyDecoded bool
+	)
+	var hold bodyBufferHold
+	defer e.releaseBodyBuffer(&hold)
+	if options.Print && request.ContentLength > 0 && request.ContentLength <= printBodyLimit {
+		var available bool
+		var denied bool
+		var printBody []byte
+		printBody, request.Body, available, _, denied, err = e.bufferBody(ctx, &hold, request.Body, request.ContentLength, nil, printBodyLimit)
+		if err != nil {
+			return E.Cause(err, "read HTTP request body")
+		}
+		if available {
+			e.printRequest(ctx, request, printBody)
+		} else {
+			if denied {
+				e.logger.WarnContext(ctx, "print body skipped: body buffer budget exhausted")
+			}
+			e.printRequest(ctx, request, nil)
+		}
+	} else if options.Print {
+		e.printRequest(ctx, request, body)
+	}
+	{
+		for i, rule := range options.SurgeHeaderRewrite {
+			if rule.Response {
+				continue
+			}
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			requestMatch = true
+			e.logger.DebugContext(ctx, "match header_rewrite[", i, "] => ", rule.String())
+			applyRequestHeaderRewrite(request, &rule)
+		}
+		for i, rule := range options.SurgeURLRewrite {
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			e.logger.DebugContext(ctx, "match url_rewrite[", i, "] => ", rule.String())
+			if rule.Reject {
+				return E.New("request rejected by url_rewrite")
+			} else if rule.RedirectCode > 0 {
+				destination := rule.Pattern.ReplaceAllString(requestURL, rule.Destination.String())
+				w := new(simpleResponseWriter)
+				http.Redirect(w, request, destination, rule.RedirectCode)
+				err = w.Build(request).Write(conn)
+				if err != nil {
+					return E.Cause(err, "write url_rewrite 302 response")
+				}
+				return nil
+			}
+			rewrittenURL := rule.Pattern.ReplaceAllString(requestURL, rule.Destination.String())
+			destination, parseErr := url.Parse(rewrittenURL)
+			if parseErr != nil {
+				return E.Cause(parseErr, "parse rewritten URL")
+			}
+			requestMatch = true
+			applyRequestURL(request, destination, &metadata, tlsConfig)
+			requestURL = destination.String()
+			break
+		}
+		for i, rule := range options.SurgeBodyRewrite {
+			if rule.Response {
+				continue
+			}
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			requestMatch = true
+			e.logger.DebugContext(ctx, "match body_rewrite[", i, "] => ", rule.String())
+			if body == nil {
+				var (
+					available bool
+					denied    bool
+				)
+				body, request.Body, available, bodyDecoded, denied, err = e.bufferBody(ctx, &hold, request.Body, request.ContentLength, request.Header, requestRewriteBodyLimit)
+				if err != nil {
+					return E.Cause(err, "read HTTP request body")
+				}
+				if denied {
+					e.logger.WarnContext(ctx, "request body rewrite skipped: body buffer budget exhausted")
+					break
+				}
+				if !available {
+					return E.New("request body rewrite exceeds the limit or uses an unsupported content encoding")
+				}
+			}
+			if rule.JQ {
+				rewrittenBody, jqErr := applyJQBodyRewrite(ctx, body, &rule, requestRewriteBodyLimit)
+				if jqErr != nil {
+					e.logger.WarnContext(ctx, "jq body rewrite skipped: ", jqErr)
+					continue
+				}
+				body = rewrittenBody
+			} else {
+				if !utf8.Valid(body) {
+					e.logger.WarnContext(ctx, "body replace skipped because request body is not valid UTF-8")
+					continue
+				}
+				for mi := 0; mi < len(rule.Match); mi++ {
+					body = rule.Match[mi].ReplaceAll(body, []byte(rule.Replace[mi]))
+				}
+			}
+			bodyDecoded = true
+			setRequestBody(request, body, true)
+		}
+	}
+	for _, scriptOptions := range options.Script {
+		if !surgeScriptMatchesEvent(scriptOptions, "http-request") {
+			continue
+		}
+		script, loaded := e.script.Script(scriptOptions.Tag)
+		if !loaded {
+			e.logger.WarnContext(ctx, "script not found: ", scriptOptions.Tag)
+			continue
+		}
+		surgeScript, isSurge := script.(adapter.SurgeScript)
+		if !isSurge {
+			e.logger.WarnContext(ctx, "specified script/", script.Type(), "[", script.Tag(), "] is not a Surge script")
+			continue
+		}
+		matched := false
+		for _, pattern := range scriptOptions.Pattern {
+			if surgePatternMatches(pattern.Build(), requestURL, request.Host, surgeConnectionHost(metadata)) {
+				matched = true
+				break
+			}
+		}
+		if matched {
+			e.logger.DebugContext(ctx, "match script/", surgeScript.Type(), "[", surgeScript.Tag(), "]")
+			requestScript = surgeScript
+			requestScriptOptions = scriptOptions
+			break
+		}
+	}
+	if requestScript != nil {
+		if body == nil && requestScriptOptions.RequiresBody && request.ContentLength != 0 {
+			bodyLimit := surgeScriptBodyLimit(requestScriptOptions.MaxSize)
+			var (
+				available bool
+				denied    bool
+			)
+			body, request.Body, available, bodyDecoded, denied, err = e.bufferBody(ctx, &hold, request.Body, request.ContentLength, request.Header, bodyLimit)
+			if err != nil {
+				return E.Cause(err, "read HTTP request body")
+			}
+			if denied || !available {
+				if denied {
+					e.logger.WarnContext(ctx, "request script skipped: body buffer budget exhausted")
+				} else {
+					e.logger.WarnContext(ctx, "request script skipped because body exceeds max-size or uses an unsupported content encoding")
+				}
+				requestScript = nil
+			} else {
+				setRequestBody(request, body, bodyDecoded)
+			}
+		}
+	}
+	if requestScript != nil {
+		var result *adapter.HTTPRequestScriptResult
+		result, err = requestScript.ExecuteHTTPRequest(ctx, time.Duration(requestScriptOptions.Timeout), request, body, requestScriptOptions.BinaryBodyMode, requestScriptOptions.FullHeaderMode, requestScriptOptions.Arguments)
+		if err != nil {
+			return E.Cause(err, "execute script/", requestScript.Type(), "[", requestScript.Tag(), "]")
+		}
+		if result.Abort {
+			return E.New("request aborted by script/", requestScript.Type(), "[", requestScript.Tag(), "]")
+		}
+		requestMatch = true
+		if result.Response != nil {
+			if result.Response.Status < 100 || result.Response.Status > 599 {
+				result.Response.Status = http.StatusOK
+			}
+			responseHeaders := surgeSyntheticHeaders(result.Response.Headers, len(result.Response.Body))
+			response := &http.Response{StatusCode: result.Response.Status, Status: http.StatusText(result.Response.Status), Proto: request.Proto, ProtoMajor: request.ProtoMajor, ProtoMinor: request.ProtoMinor, Header: responseHeaders, Body: io.NopCloser(bytes.NewReader(result.Response.Body)), ContentLength: int64(len(result.Response.Body)), Close: true}
+			err = response.Write(conn)
+			if err != nil {
+				return E.Cause(err, "write fake response body")
+			}
+			return nil
+		}
+		if result.URL != "" {
+			newURL, parseErr := url.Parse(result.URL)
+			if parseErr != nil || !newURL.IsAbs() || newURL.Hostname() == "" {
+				e.logger.WarnContext(ctx, "script returned an invalid request URL, ignored: ", result.URL)
+			} else {
+				applyRequestURL(request, newURL, &metadata, tlsConfig)
+				requestURL = newURL.String()
+			}
+		}
+		replaceRequestHeaders(request, result.Headers)
+		if result.Body != nil {
+			if !requestScriptOptions.RequiresBody {
+				return E.New("request script returned a body without requires_body")
+			}
+			body = result.Body
+			setRequestBody(request, body, true)
+		}
+	}
+	{
+		for i, rule := range options.SurgeMapLocal {
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			requestMatch = true
+			e.logger.DebugContext(ctx, "match map_local[", i, "] => ", rule.String())
+			var (
+				statusCode = http.StatusOK
+				headers    = make(http.Header)
+			)
+			if rule.StatusCode > 0 {
+				statusCode = rule.StatusCode
+			}
+			switch {
+			case rule.File:
+				resource, err := filemanager.ReadFile(ctx, rule.Data)
+				if err != nil {
+					return E.Cause(err, "open map local source")
+				}
+				if int64(len(resource)) > mapLocalBodyLimit {
+					return E.New("map local source exceeds limit: ", len(resource), " > ", mapLocalBodyLimit)
+				}
+				mimeType := mime.TypeByExtension(filepath.Ext(rule.Data))
+				if mimeType == "" {
+					mimeType = "application/octet-stream"
+				}
+				headers.Set("Content-Type", mimeType)
+				body = resource
+			case rule.Text:
+				headers.Set("Content-Type", "text/plain")
+				body = []byte(rule.Data)
+			case rule.TinyGif:
+				headers.Set("Content-Type", "image/gif")
+				body = surgeTinyGif()
+			case rule.Base64:
+				headers.Set("Content-Type", "application/octet-stream")
+				body = rule.Base64Data
+			}
+			for key, values := range rule.Headers {
+				headers[key] = values
+			}
+			headers = surgeSyntheticHeaders(headers, len(body))
+			response := &http.Response{
+				StatusCode:    statusCode,
+				Status:        http.StatusText(statusCode),
+				Proto:         request.Proto,
+				ProtoMajor:    request.ProtoMajor,
+				ProtoMinor:    request.ProtoMinor,
+				Header:        headers,
+				Body:          io.NopCloser(bytes.NewReader(body)),
+				ContentLength: int64(len(body)),
+				Close:         true,
+			}
+			err = response.Write(conn)
+			if err != nil {
+				return E.Cause(err, "write map local response")
+			}
+			return nil
+		}
+	}
+	ctx = adapter.WithContext(ctx, &metadata)
+	var innerErr atomic.TypedValue[error]
+	httpClient := &http.Client{
+		Transport: &http.Transport{
+			DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+				if len(metadata.DestinationAddresses) > 0 || metadata.Destination.IsIP() {
+					return dialer.DialSerialNetwork(ctx, this, N.NetworkTCP, metadata.Destination, metadata.DestinationAddresses, metadata.NetworkStrategy, metadata.NetworkType, metadata.FallbackNetworkType, metadata.FallbackDelay)
+				} else {
+					return this.DialContext(ctx, N.NetworkTCP, metadata.Destination)
+				}
+			},
+			TLSClientConfig: tlsConfig,
+		},
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+	defer httpClient.CloseIdleConnections()
+	requestCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	normalizeRequestFraming(request)
+	response, err := httpClient.Do(request.WithContext(requestCtx))
+	if err != nil {
+		cancel()
+		return E.Errors(innerErr.Load(), err)
+	}
+	var (
+		responseScript        adapter.SurgeScript
+		responseMatch         bool
+		responseScriptOptions option.MITMRouteSurgeScriptOptions
+	)
+	var (
+		responseBody        []byte
+		responseBodyDecoded bool
+	)
+	if options.Print && response.ContentLength > 0 && response.ContentLength <= printBodyLimit {
+		var available bool
+		var denied bool
+		var printBody []byte
+		printBody, response.Body, available, _, denied, err = e.bufferBody(ctx, &hold, response.Body, response.ContentLength, nil, printBodyLimit)
+		if err != nil {
+			return E.Cause(err, "read HTTP response body")
+		}
+		if available {
+			e.printResponse(ctx, request, response, printBody)
+		} else {
+			if denied {
+				e.logger.WarnContext(ctx, "print body skipped: body buffer budget exhausted")
+			}
+			e.printResponse(ctx, request, response, nil)
+		}
+	} else if options.Print {
+		e.printResponse(ctx, request, response, responseBody)
+	}
+	{
+		for i, rule := range options.SurgeHeaderRewrite {
+			if !rule.Response {
+				continue
+			}
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			responseMatch = true
+			e.logger.DebugContext(ctx, "match header_rewrite[", i, "] => ", rule.String())
+			applyHeaderRewrite(response.Header, &rule)
+		}
+		for i, rule := range options.SurgeBodyRewrite {
+			if !rule.Response {
+				continue
+			}
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			responseMatch = true
+			e.logger.DebugContext(ctx, "match body_rewrite[", i, "] => ", rule.String())
+			if responseBody == nil {
+				var (
+					available bool
+					denied    bool
+				)
+				responseBody, response.Body, available, responseBodyDecoded, denied, err = e.bufferBody(ctx, &hold, response.Body, response.ContentLength, response.Header, responseRewriteBodyLimit)
+				if err != nil {
+					return E.Cause(err, "read HTTP response body")
+				}
+				if denied {
+					e.logger.WarnContext(ctx, "response body rewrite skipped: body buffer budget exhausted")
+					break
+				}
+				if !available {
+					e.logger.WarnContext(ctx, "body replace skipped because body exceeds the limit or uses an unsupported content encoding")
+					continue
+				}
+			}
+			if rule.JQ {
+				rewrittenBody, jqErr := applyJQBodyRewrite(ctx, responseBody, &rule, responseRewriteBodyLimit)
+				if jqErr != nil {
+					e.logger.WarnContext(ctx, "jq body rewrite skipped: ", jqErr)
+					continue
+				}
+				responseBody = rewrittenBody
+			} else {
+				if !utf8.Valid(responseBody) {
+					e.logger.WarnContext(ctx, "body replace skipped because response body is not valid UTF-8")
+					continue
+				}
+				for mi := 0; mi < len(rule.Match); mi++ {
+					responseBody = rule.Match[mi].ReplaceAll(responseBody, []byte(rule.Replace[mi]))
+				}
+			}
+			responseBodyDecoded = true
+			setResponseBody(response, responseBody, true)
+		}
+	}
+	if responseScript != nil {
+		if responseBody == nil && responseScriptOptions.RequiresBody && response.ContentLength != 0 {
+			bodyLimit := surgeScriptBodyLimit(responseScriptOptions.MaxSize)
+			var (
+				available bool
+				denied    bool
+			)
+			responseBody, response.Body, available, responseBodyDecoded, denied, err = e.bufferBody(ctx, &hold, response.Body, response.ContentLength, response.Header, bodyLimit)
+			if err != nil {
+				return E.Cause(err, "read HTTP response body")
+			}
+			if denied || !available {
+				if denied {
+					e.logger.WarnContext(ctx, "response script skipped: body buffer budget exhausted")
+				} else {
+					e.logger.WarnContext(ctx, "response script skipped because body exceeds max-size or uses an unsupported content encoding")
+				}
+				responseScript = nil
+				responseBody = nil
+			} else {
+				setResponseBody(response, responseBody, responseBodyDecoded)
+			}
+		}
+	}
+	if responseScript != nil {
+		var result *adapter.HTTPResponseScriptResult
+		result, err = responseScript.ExecuteHTTPResponse(ctx, time.Duration(responseScriptOptions.Timeout), request, response, responseBody, responseScriptOptions.BinaryBodyMode, responseScriptOptions.FullHeaderMode, responseScriptOptions.Arguments)
+		if err != nil {
+			return E.Cause(err, "execute script/", responseScript.Type(), "[", responseScript.Tag(), "]")
+		}
+		if result.Abort {
+			return E.New("response aborted by script/", responseScript.Type(), "[", responseScript.Tag(), "]")
+		}
+		responseMatch = true
+		if result.Status >= 100 && result.Status <= 599 {
+			response.Status = http.StatusText(result.Status)
+			response.StatusCode = result.Status
+		} else if result.Status != 0 {
+			e.logger.WarnContext(ctx, "script returned an invalid response status, ignored: ", result.Status)
+		}
+		replaceResponseHeaders(response, result.Headers)
+		if result.Body != nil {
+			if !responseScriptOptions.RequiresBody {
+				return E.New("response script returned a body without requires_body")
+			}
+			responseBody = result.Body
+			responseBodyDecoded = true
+			setResponseBody(response, responseBody, true)
+		}
+	}
+	if !options.Print && !requestMatch && !responseMatch {
+		e.logger.DebugContext(ctx, "request not modified")
+	}
+	normalizeResponseFraming(response)
+	err = response.Write(conn)
+	closeErr := response.Body.Close()
+	if err != nil {
+		return E.Errors(E.Cause(err, "write HTTP response"), innerErr.Load())
+	} else if closeErr != nil {
+		return E.Cause(closeErr, "close HTTP response body")
+	} else if innerErr.Load() != nil {
+		return E.Cause(innerErr.Load(), "write HTTP response")
+	}
+	if request.Close || response.Close {
+		return nil
+	}
+	return errHTTP1KeepAlive
+}
+
+func (e *Engine) newHTTP2(ctx context.Context, this N.Dialer, conn net.Conn, tlsConfig *tls.Config, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) error {
+	handler := &engineHandler{
+		Engine:    e,
+		tlsConfig: tlsConfig,
+		dialer:    this,
+		metadata:  metadata,
+	}
+	http2Server := &http2.Server{
+		MaxReadFrameSize: math.MaxUint32,
+	}
+	http2Server.ServeConn(conn, &http2.ServeConnOpts{
+		Context: ctx,
+		Handler: handler,
+	})
+	return nil
+}
+
+type engineHandler struct {
+	*Engine
+	tlsConfig *tls.Config
+	dialer    N.Dialer
+	metadata  adapter.InboundContext
+}
+
+func (e *engineHandler) ServeHTTP(writer http.ResponseWriter, request *http.Request) {
+	trackedWriter := &trackingResponseWriter{ResponseWriter: writer}
+	err := e.serveHTTP(request.Context(), trackedWriter, request)
+	if err != nil {
+		if E.IsClosedOrCanceled(err) {
+			e.logger.DebugContext(request.Context(), E.Cause(err, "connection closed"))
+		} else {
+			e.logger.ErrorContext(request.Context(), err)
+		}
+		if !trackedWriter.wroteHeader {
+			http.Error(trackedWriter, http.StatusText(http.StatusBadGateway), http.StatusBadGateway)
+		}
+	}
+}
+
+func (e *engineHandler) serveHTTP(ctx context.Context, writer http.ResponseWriter, request *http.Request) error {
+	metadata := e.metadata
+	tlsConfig := e.tlsConfig.Clone()
+	options := metadata.MITM
+	rawRequestURL := request.URL
+	rawRequestURL.Scheme = "https"
+	if rawRequestURL.Host == "" {
+		rawRequestURL.Host = request.Host
+	}
+	requestURL := rawRequestURL.String()
+	request.RequestURI = ""
+	var (
+		requestMatch         bool
+		requestScript        adapter.SurgeScript
+		requestScriptOptions option.MITMRouteSurgeScriptOptions
+	)
+	var (
+		body        []byte
+		bodyDecoded bool
+		err         error
+	)
+	var hold bodyBufferHold
+	defer e.releaseBodyBuffer(&hold)
+	if options.Print && request.ContentLength > 0 && request.ContentLength <= printBodyLimit {
+		var available bool
+		var denied bool
+		var printBody []byte
+		printBody, request.Body, available, _, denied, err = e.bufferBody(ctx, &hold, request.Body, request.ContentLength, nil, printBodyLimit)
+		if err != nil {
+			return E.Cause(err, "read HTTP request body")
+		}
+		if available {
+			e.printRequest(ctx, request, printBody)
+		} else {
+			if denied {
+				e.logger.WarnContext(ctx, "print body skipped: body buffer budget exhausted")
+			}
+			e.printRequest(ctx, request, nil)
+		}
+	} else if options.Print {
+		e.printRequest(ctx, request, body)
+	}
+	{
+		for i, rule := range options.SurgeHeaderRewrite {
+			if rule.Response {
+				continue
+			}
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			requestMatch = true
+			e.logger.DebugContext(ctx, "match header_rewrite[", i, "] => ", rule.String())
+			applyRequestHeaderRewrite(request, &rule)
+		}
+		for i, rule := range options.SurgeURLRewrite {
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			e.logger.DebugContext(ctx, "match url_rewrite[", i, "] => ", rule.String())
+			if rule.Reject {
+				return E.New("request rejected by url_rewrite")
+			} else if rule.RedirectCode > 0 {
+				destination := rule.Pattern.ReplaceAllString(requestURL, rule.Destination.String())
+				http.Redirect(writer, request, destination, rule.RedirectCode)
+				return nil
+			}
+			rewrittenURL := rule.Pattern.ReplaceAllString(requestURL, rule.Destination.String())
+			destination, parseErr := url.Parse(rewrittenURL)
+			if parseErr != nil {
+				return E.Cause(parseErr, "parse rewritten URL")
+			}
+			requestMatch = true
+			applyRequestURL(request, destination, &metadata, tlsConfig)
+			requestURL = destination.String()
+			break
+		}
+		for i, rule := range options.SurgeBodyRewrite {
+			if rule.Response {
+				continue
+			}
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			requestMatch = true
+			e.logger.DebugContext(ctx, "match body_rewrite[", i, "] => ", rule.String())
+			if body == nil {
+				var (
+					available bool
+					denied    bool
+				)
+				body, request.Body, available, bodyDecoded, denied, err = e.bufferBody(ctx, &hold, request.Body, request.ContentLength, request.Header, requestRewriteBodyLimit)
+				if err != nil {
+					return E.Cause(err, "read HTTP request body")
+				}
+				if denied {
+					e.logger.WarnContext(ctx, "request body rewrite skipped: body buffer budget exhausted")
+					break
+				}
+				if !available {
+					return E.New("request body rewrite exceeds the limit or uses an unsupported content encoding")
+				}
+			}
+			if rule.JQ {
+				rewrittenBody, jqErr := applyJQBodyRewrite(ctx, body, &rule, requestRewriteBodyLimit)
+				if jqErr != nil {
+					e.logger.WarnContext(ctx, "jq body rewrite skipped: ", jqErr)
+					continue
+				}
+				body = rewrittenBody
+			} else {
+				if !utf8.Valid(body) {
+					e.logger.WarnContext(ctx, "body replace skipped because request body is not valid UTF-8")
+					continue
+				}
+				for mi := 0; mi < len(rule.Match); mi++ {
+					body = rule.Match[mi].ReplaceAll(body, []byte(rule.Replace[mi]))
+				}
+			}
+			bodyDecoded = true
+			setRequestBody(request, body, true)
+		}
+	}
+	for _, scriptOptions := range options.Script {
+		if !surgeScriptMatchesEvent(scriptOptions, "http-request") {
+			continue
+		}
+		script, loaded := e.script.Script(scriptOptions.Tag)
+		if !loaded {
+			e.logger.WarnContext(ctx, "script not found: ", scriptOptions.Tag)
+			continue
+		}
+		surgeScript, isSurge := script.(adapter.SurgeScript)
+		if !isSurge {
+			e.logger.WarnContext(ctx, "specified script/", script.Type(), "[", script.Tag(), "] is not a Surge script")
+			continue
+		}
+		matched := false
+		for _, pattern := range scriptOptions.Pattern {
+			if surgePatternMatches(pattern.Build(), requestURL, request.Host, surgeConnectionHost(metadata)) {
+				matched = true
+				break
+			}
+		}
+		if matched {
+			e.logger.DebugContext(ctx, "match script/", surgeScript.Type(), "[", surgeScript.Tag(), "]")
+			requestScript = surgeScript
+			requestScriptOptions = scriptOptions
+			break
+		}
+	}
+	if requestScript != nil && body == nil && requestScriptOptions.RequiresBody && request.ContentLength != 0 {
+		bodyLimit := surgeScriptBodyLimit(requestScriptOptions.MaxSize)
+		var (
+			available bool
+			denied    bool
+		)
+		body, request.Body, available, bodyDecoded, denied, err = e.bufferBody(ctx, &hold, request.Body, request.ContentLength, request.Header, bodyLimit)
+		if err != nil {
+			return E.Cause(err, "read HTTP request body")
+		}
+		if denied || !available {
+			if denied {
+				e.logger.WarnContext(ctx, "request script skipped: body buffer budget exhausted")
+			} else {
+				e.logger.WarnContext(ctx, "request script skipped because body exceeds max-size or uses an unsupported content encoding")
+			}
+			requestScript = nil
+		} else {
+			setRequestBody(request, body, bodyDecoded)
+		}
+	}
+	if requestScript != nil {
+		result, executeErr := requestScript.ExecuteHTTPRequest(ctx, time.Duration(requestScriptOptions.Timeout), request, body, requestScriptOptions.BinaryBodyMode, requestScriptOptions.FullHeaderMode, requestScriptOptions.Arguments)
+		if executeErr != nil {
+			return E.Cause(executeErr, "execute script/", requestScript.Type(), "[", requestScript.Tag(), "]")
+		}
+		if result.Abort {
+			return E.New("request aborted by script/", requestScript.Type(), "[", requestScript.Tag(), "]")
+		}
+		requestMatch = true
+		if result.Response != nil {
+			if result.Response.Status < 100 || result.Response.Status > 599 {
+				result.Response.Status = http.StatusOK
+			}
+			for key, values := range surgeSyntheticHeaders(result.Response.Headers, len(result.Response.Body)) {
+				writer.Header()[key] = values
+			}
+			writer.WriteHeader(result.Response.Status)
+			if result.Response.Body != nil {
+				if _, writeErr := writer.Write(result.Response.Body); writeErr != nil {
+					return E.Cause(writeErr, "write fake response body")
+				}
+			}
+			return nil
+		}
+		if result.URL != "" {
+			newURL, parseErr := url.Parse(result.URL)
+			if parseErr != nil || !newURL.IsAbs() || newURL.Hostname() == "" {
+				e.logger.WarnContext(ctx, "script returned an invalid request URL, ignored: ", result.URL)
+			} else {
+				applyRequestURL(request, newURL, &metadata, tlsConfig)
+				requestURL = newURL.String()
+			}
+		}
+		replaceRequestHeaders(request, result.Headers)
+		if result.Body != nil {
+			if !requestScriptOptions.RequiresBody {
+				return E.New("request script returned a body without requires_body")
+			}
+			body = result.Body
+			setRequestBody(request, body, true)
+		}
+	}
+	{
+		for i, rule := range options.SurgeMapLocal {
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			requestMatch = true
+			e.logger.DebugContext(ctx, "match map_local[", i, "] => ", rule.String())
+			go func() {
+				io.Copy(io.Discard, request.Body)
+				request.Body.Close()
+			}()
+			var (
+				statusCode = http.StatusOK
+				headers    = make(http.Header)
+				body       []byte
+			)
+			if rule.StatusCode > 0 {
+				statusCode = rule.StatusCode
+			}
+			switch {
+			case rule.File:
+				resource, err := filemanager.ReadFile(ctx, rule.Data)
+				if err != nil {
+					return E.Cause(err, "open map local source")
+				}
+				if int64(len(resource)) > mapLocalBodyLimit {
+					return E.New("map local source exceeds limit: ", len(resource), " > ", mapLocalBodyLimit)
+				}
+				mimeType := mime.TypeByExtension(filepath.Ext(rule.Data))
+				if mimeType == "" {
+					mimeType = "application/octet-stream"
+				}
+				headers.Set("Content-Type", mimeType)
+				body = resource
+			case rule.Text:
+				headers.Set("Content-Type", "text/plain")
+				body = []byte(rule.Data)
+			case rule.TinyGif:
+				headers.Set("Content-Type", "image/gif")
+				body = surgeTinyGif()
+			case rule.Base64:
+				headers.Set("Content-Type", "application/octet-stream")
+				body = rule.Base64Data
+			}
+			for key, values := range rule.Headers {
+				headers[key] = values
+			}
+			headers = surgeSyntheticHeaders(headers, len(body))
+			for key, values := range headers {
+				writer.Header()[key] = values
+			}
+			writer.WriteHeader(statusCode)
+			_, err = writer.Write(body)
+			if err != nil {
+				return E.Cause(err, "write map local response")
+			}
+			return nil
+		}
+	}
+	requestCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	normalizeRequestFraming(request)
+	httpTransport := &http.Transport{
+		ForceAttemptHTTP2: true,
+		DialContext: func(dialContext context.Context, network, address string) (net.Conn, error) {
+			dialContext = adapter.WithContext(dialContext, &metadata)
+			if len(metadata.DestinationAddresses) > 0 || metadata.Destination.IsIP() {
+				return dialer.DialSerialNetwork(dialContext, e.dialer, N.NetworkTCP, metadata.Destination, metadata.DestinationAddresses, metadata.NetworkStrategy, metadata.NetworkType, metadata.FallbackNetworkType, metadata.FallbackDelay)
+			}
+			return e.dialer.DialContext(dialContext, N.NetworkTCP, metadata.Destination)
+		},
+		TLSClientConfig: tlsConfig,
+	}
+	err = http2.ConfigureTransport(httpTransport)
+	if err != nil {
+		return E.Cause(err, "configure HTTP/2 transport")
+	}
+	httpClient := &http.Client{
+		Transport: httpTransport,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+	defer httpClient.CloseIdleConnections()
+	response, err := httpClient.Do(request.WithContext(requestCtx))
+	if err != nil {
+		cancel()
+		return E.Cause(err, "exchange request")
+	}
+	var (
+		responseScript        adapter.SurgeScript
+		responseMatch         bool
+		responseScriptOptions option.MITMRouteSurgeScriptOptions
+	)
+matchResponse:
+	for _, scriptOptions := range options.Script {
+		if !surgeScriptMatchesEvent(scriptOptions, "http-response") {
+			continue
+		}
+		script, loaded := e.script.Script(scriptOptions.Tag)
+		if !loaded {
+			e.logger.WarnContext(ctx, "script not found: ", scriptOptions.Tag)
+			continue
+		}
+		surgeScript, isSurge := script.(adapter.SurgeScript)
+		if !isSurge {
+			e.logger.WarnContext(ctx, "specified script/", script.Type(), "[", script.Tag(), "] is not a Surge script")
+			continue
+		}
+		for _, pattern := range scriptOptions.Pattern {
+			if surgePatternMatches(pattern.Build(), requestURL, request.Host, surgeConnectionHost(metadata)) {
+				e.logger.DebugContext(ctx, "match script/", surgeScript.Type(), "[", surgeScript.Tag(), "]")
+				responseScript = surgeScript
+				responseScriptOptions = scriptOptions
+				break matchResponse
+			}
+		}
+	}
+	var (
+		responseBody        []byte
+		responseBodyDecoded bool
+	)
+	if options.Print && response.ContentLength > 0 && response.ContentLength <= printBodyLimit {
+		var available bool
+		var denied bool
+		var printBody []byte
+		printBody, response.Body, available, _, denied, err = e.bufferBody(ctx, &hold, response.Body, response.ContentLength, nil, printBodyLimit)
+		if err != nil {
+			return E.Cause(err, "read HTTP response body")
+		}
+		if available {
+			e.printResponse(ctx, request, response, printBody)
+		} else {
+			if denied {
+				e.logger.WarnContext(ctx, "print body skipped: body buffer budget exhausted")
+			}
+			e.printResponse(ctx, request, response, nil)
+		}
+	} else if options.Print {
+		e.printResponse(ctx, request, response, responseBody)
+	}
+	{
+		for i, rule := range options.SurgeHeaderRewrite {
+			if !rule.Response {
+				continue
+			}
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			responseMatch = true
+			e.logger.DebugContext(ctx, "match header_rewrite[", i, "] => ", rule.String())
+			applyHeaderRewrite(response.Header, &rule)
+		}
+		for i, rule := range options.SurgeBodyRewrite {
+			if !rule.Response {
+				continue
+			}
+			if !surgePatternMatches(rule.Pattern, requestURL, request.Host, surgeConnectionHost(metadata)) {
+				continue
+			}
+			responseMatch = true
+			e.logger.DebugContext(ctx, "match body_rewrite[", i, "] => ", rule.String())
+			if responseBody == nil {
+				var (
+					available bool
+					denied    bool
+				)
+				responseBody, response.Body, available, responseBodyDecoded, denied, err = e.bufferBody(ctx, &hold, response.Body, response.ContentLength, response.Header, responseRewriteBodyLimit)
+				if err != nil {
+					return E.Cause(err, "read HTTP response body")
+				}
+				if denied {
+					e.logger.WarnContext(ctx, "response body rewrite skipped: body buffer budget exhausted")
+					break
+				}
+				if !available {
+					e.logger.WarnContext(ctx, "body replace skipped because body exceeds the limit or uses an unsupported content encoding")
+					continue
+				}
+			}
+			if rule.JQ {
+				rewrittenBody, jqErr := applyJQBodyRewrite(ctx, responseBody, &rule, responseRewriteBodyLimit)
+				if jqErr != nil {
+					e.logger.WarnContext(ctx, "jq body rewrite skipped: ", jqErr)
+					continue
+				}
+				responseBody = rewrittenBody
+			} else {
+				if !utf8.Valid(responseBody) {
+					e.logger.WarnContext(ctx, "body replace skipped because response body is not valid UTF-8")
+					continue
+				}
+				for mi := 0; mi < len(rule.Match); mi++ {
+					responseBody = rule.Match[mi].ReplaceAll(responseBody, []byte(rule.Replace[mi]))
+				}
+			}
+			responseBodyDecoded = true
+			setResponseBody(response, responseBody, true)
+		}
+	}
+	for _, scriptOptions := range options.Script {
+		if !surgeScriptMatchesEvent(scriptOptions, "http-response") {
+			continue
+		}
+		script, loaded := e.script.Script(scriptOptions.Tag)
+		if !loaded {
+			e.logger.WarnContext(ctx, "script not found: ", scriptOptions.Tag)
+			continue
+		}
+		surgeScript, isSurge := script.(adapter.SurgeScript)
+		if !isSurge {
+			e.logger.WarnContext(ctx, "specified script/", script.Type(), "[", script.Tag(), "] is not a Surge script")
+			continue
+		}
+		matched := false
+		for _, pattern := range scriptOptions.Pattern {
+			if surgePatternMatches(pattern.Build(), requestURL, request.Host, surgeConnectionHost(metadata)) {
+				matched = true
+				break
+			}
+		}
+		if matched {
+			e.logger.DebugContext(ctx, "match script/", surgeScript.Type(), "[", surgeScript.Tag(), "]")
+			responseScript = surgeScript
+			responseScriptOptions = scriptOptions
+			break
+		}
+	}
+	if responseScript != nil && responseBody == nil && responseScriptOptions.RequiresBody && response.ContentLength != 0 {
+		bodyLimit := surgeScriptBodyLimit(responseScriptOptions.MaxSize)
+		var (
+			available bool
+			denied    bool
+		)
+		responseBody, response.Body, available, responseBodyDecoded, denied, err = e.bufferBody(ctx, &hold, response.Body, response.ContentLength, response.Header, bodyLimit)
+		if err != nil {
+			return E.Cause(err, "read HTTP response body")
+		}
+		if denied || !available {
+			if denied {
+				e.logger.WarnContext(ctx, "response script skipped: body buffer budget exhausted")
+			} else {
+				e.logger.WarnContext(ctx, "response script skipped because body exceeds max-size or uses an unsupported content encoding")
+			}
+			responseScript = nil
+			responseBody = nil
+		} else {
+			setResponseBody(response, responseBody, responseBodyDecoded)
+		}
+	}
+	if responseScript != nil {
+		result, executeErr := responseScript.ExecuteHTTPResponse(ctx, time.Duration(responseScriptOptions.Timeout), request, response, responseBody, responseScriptOptions.BinaryBodyMode, responseScriptOptions.FullHeaderMode, responseScriptOptions.Arguments)
+		if executeErr != nil {
+			return E.Cause(executeErr, "execute script/", responseScript.Type(), "[", responseScript.Tag(), "]")
+		}
+		if result.Abort {
+			return E.New("response aborted by script/", responseScript.Type(), "[", responseScript.Tag(), "]")
+		}
+		responseMatch = true
+		if result.Status >= 100 && result.Status <= 599 {
+			response.Status = http.StatusText(result.Status)
+			response.StatusCode = result.Status
+		} else if result.Status != 0 {
+			e.logger.WarnContext(ctx, "script returned an invalid response status, ignored: ", result.Status)
+		}
+		replaceResponseHeaders(response, result.Headers)
+		if result.Body != nil {
+			if !responseScriptOptions.RequiresBody {
+				return E.New("response script returned a body without requires_body")
+			}
+			responseBody = result.Body
+			setResponseBody(response, responseBody, true)
+		}
+	}
+	if !options.Print && !requestMatch && !responseMatch {
+		e.logger.DebugContext(ctx, "request not modified")
+	}
+	normalizeResponseFraming(response)
+	for key, values := range response.Header {
+		writer.Header()[key] = values
+	}
+	writer.WriteHeader(response.StatusCode)
+	_, err = io.Copy(writer, response.Body)
+	response.Body.Close()
+	if err != nil {
+		return E.Cause(err, "write HTTP response")
+	}
+	return nil
+}
+
+func (e *Engine) printRequest(ctx context.Context, request *http.Request, body []byte) {
+	var builder strings.Builder
+	builder.WriteString(F.ToString(request.Proto, " ", request.Method, " ", request.URL))
+	builder.WriteString("\n")
+	if request.URL.Hostname() != "" && request.URL.Hostname() != request.Host {
+		builder.WriteString("Host: ")
+		builder.WriteString(request.Host)
+		builder.WriteString("\n")
+	}
+	for key, values := range request.Header {
+		for _, value := range values {
+			builder.WriteString(key)
+			builder.WriteString(": ")
+			builder.WriteString(value)
+			builder.WriteString("\n")
+		}
+	}
+	if len(body) > 0 {
+		builder.WriteString("\n")
+		if !bytes.ContainsFunc(body, func(r rune) bool {
+			return !unicode.IsPrint(r) && !unicode.IsSpace(r)
+		}) {
+			builder.Write(body)
+		} else {
+			builder.WriteString("(body not printable)")
+		}
+	}
+	e.logger.InfoContext(ctx, "request: ", builder.String())
+}
+
+func (e *Engine) printResponse(ctx context.Context, request *http.Request, response *http.Response, body []byte) {
+	var builder strings.Builder
+	builder.WriteString(F.ToString(response.Proto, " ", response.Status, " ", request.URL))
+	builder.WriteString("\n")
+	for key, values := range response.Header {
+		for _, value := range values {
+			builder.WriteString(key)
+			builder.WriteString(": ")
+			builder.WriteString(value)
+			builder.WriteString("\n")
+		}
+	}
+	if len(body) > 0 {
+		builder.WriteString("\n")
+		if !bytes.ContainsFunc(body, func(r rune) bool {
+			return !unicode.IsPrint(r) && !unicode.IsSpace(r)
+		}) {
+			builder.Write(body)
+		} else {
+			builder.WriteString("(body not printable)")
+		}
+	}
+	e.logger.InfoContext(ctx, "response: ", builder.String())
+}
+
+func surgeScriptBodyLimit(configured int64) int64 {
+	if configured < 0 {
+		return 32 * 1024 * 1024
+	}
+	if configured == 0 {
+		return 1024 * 1024
+	}
+	return configured
+}
+
+func applyRequestURL(request *http.Request, destination *url.URL, metadata *adapter.InboundContext, tlsConfig *tls.Config) {
+	requestDestination := *destination
+	switch strings.ToLower(requestDestination.Scheme) {
+	case "ws":
+		requestDestination.Scheme = "http"
+	case "wss":
+		requestDestination.Scheme = "https"
+	}
+	request.URL = &requestDestination
+	request.Host = destination.Host
+	newDestination := M.ParseSocksaddrHostPortStr(destination.Hostname(), destination.Port())
+	if newDestination.Port == 0 {
+		switch strings.ToLower(destination.Scheme) {
+		case "http":
+			newDestination.Port = 80
+		case "https":
+			newDestination.Port = 443
+		case "ws":
+			newDestination.Port = 80
+		case "wss":
+			newDestination.Port = 443
+		default:
+			newDestination.Port = metadata.Destination.Port
+		}
+	}
+	metadata.Destination = newDestination
+	metadata.DestinationAddresses = nil
+	if tlsConfig != nil {
+		tlsConfig.ServerName = destination.Hostname()
+	}
+}
+
+func surgeScriptMatchesEvent(scriptOptions option.MITMRouteSurgeScriptOptions, event string) bool {
+	if len(scriptOptions.Type) == 0 {
+		return true
+	}
+	for _, scriptType := range scriptOptions.Type {
+		if scriptType == event {
+			return true
+		}
+	}
+	return false
+}
+
+func surgeSyntheticHeaders(source http.Header, bodyLength int) http.Header {
+	headers := source.Clone()
+	if headers == nil {
+		headers = make(http.Header)
+	}
+	headers.Del("Connection")
+	headers.Del("Proxy-Connection")
+	headers.Del("Transfer-Encoding")
+	headers.Set("Content-Length", strconv.Itoa(bodyLength))
+	return headers
+}
+
+type surgeReplayBody struct {
+	io.Reader
+	io.Closer
+}
+
+type simpleResponseWriter struct {
+	statusCode int
+	header     http.Header
+	body       bytes.Buffer
+}
+
+type trackingResponseWriter struct {
+	http.ResponseWriter
+	wroteHeader bool
+}
+
+func (w *trackingResponseWriter) WriteHeader(statusCode int) {
+	if !w.wroteHeader {
+		w.wroteHeader = true
+	}
+	w.ResponseWriter.WriteHeader(statusCode)
+}
+
+func (w *trackingResponseWriter) Write(content []byte) (int, error) {
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+	return w.ResponseWriter.Write(content)
+}
+
+func (w *simpleResponseWriter) Build(request *http.Request) *http.Response {
+	return &http.Response{
+		StatusCode: w.statusCode,
+		Status:     http.StatusText(w.statusCode),
+		Proto:      request.Proto,
+		ProtoMajor: request.ProtoMajor,
+		ProtoMinor: request.ProtoMinor,
+		Header:     w.header,
+		Body:       io.NopCloser(&w.body),
+	}
+}
+
+func (w *simpleResponseWriter) Header() http.Header {
+	if w.header == nil {
+		w.header = make(http.Header)
+	}
+	return w.header
+}
+
+func (w *simpleResponseWriter) Write(b []byte) (int, error) {
+	return w.body.Write(b)
+}
+
+func (w *simpleResponseWriter) WriteHeader(statusCode int) {
+	w.statusCode = statusCode
+}
