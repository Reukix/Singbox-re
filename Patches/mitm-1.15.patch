+
+// GenerateLeafCertificate signs a server certificate for serverName with an
+// existing leaf key. Sharing one key across hosts turns certificate issuance
+// into a single signature instead of an RSA key generation per host.
+func GenerateLeafCertificate(parent *x509.Certificate, parentKey any, leafKey crypto.Signer, notBefore time.Time, notAfter time.Time, serverName string) (*tls.Certificate, error) {
+	serialNumber, err := rand.Int(rand.Reader, new(big.Int).Lsh(big.NewInt(1), 128))
+	if err != nil {
+		return nil, err
+	}
+	keyUsage := x509.KeyUsageDigitalSignature
+	if _, isRSA := leafKey.Public().(*rsa.PublicKey); isRSA {
+		keyUsage |= x509.KeyUsageKeyEncipherment
+	}
+	template := &x509.Certificate{
+		SerialNumber:          serialNumber,
+		NotBefore:             notBefore,
+		NotAfter:              notAfter,
+		KeyUsage:              keyUsage,
+		ExtKeyUsage:           []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		BasicConstraintsValid: true,
+	}
+	if serverAddress := M.ParseAddr(serverName); serverAddress.IsValid() {
+		template.IPAddresses = []net.IP{serverAddress.AsSlice()}
+	} else {
+		template.Subject = pkix.Name{CommonName: serverName}
+		template.DNSNames = []string{serverName}
+	}
+	if parent == nil {
+		parent = template
+		parentKey = leafKey
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, parent, leafKey.Public(), parentKey)
+	if err != nil {
+		return nil, err
+	}
+	leaf, err := x509.ParseCertificate(der)
+	if err != nil {
+		return nil, err
+	}
+	return &tls.Certificate{
+		Certificate: [][]byte{der},
+		PrivateKey:  leafKey,
+		Leaf:        leaf,
+	}, nil
+}
+
+// GenerateLeafKey returns the key used for intercepted server certificates.
+// ECDSA P-256 keeps both issuance and every TLS handshake cheap.
+func GenerateLeafKey() (crypto.Signer, error) {
+	return ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+}
