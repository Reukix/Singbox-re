+				}
+				if !available {
+					e.logger.WarnContext(ctx, "response body rewrite skipped because body exceeds the limit or uses an unsupported content encoding")
+					break
+				}
+			}
+			rewrittenBody, rewritten := e.rewriteBody(ctx, &hold, responseBody, &rule, responseRewriteBodyLimit, "response")
+			if !rewritten {
+				continue
+			}
+			responseBody = rewrittenBody
+			responseBodyDecoded = true
+			setResponseBody(response, responseBody, true)
+		}
+	}
+	responseScript, responseScriptOptions = e.matchSurgeScript(ctx, options, "http-response", requestURL, request.Host, metadata)
+	if responseScript != nil {
+		if responseBody == nil && responseScriptOptions.RequiresBody && response.ContentLength != 0 {
+			bodyLimit := surgeScriptBodyLimit(responseScriptOptions.MaxSize)
+			var (
+				available bool
+				denied    bool
+			)
+			responseBody, response.Body, available, responseBodyDecoded, denied, err = e.bufferBody(ctx, &hold, response.Body, response.ContentLength, response.Header, bodyLimit)
+			if err != nil {
+				return E.Cause(err, "read HTTP response body")
+			}
+			if denied || !available {
+				if denied {
+					e.logger.WarnContext(ctx, "response script skipped: body buffer budget exhausted")
+				} else {
+					e.logger.WarnContext(ctx, "response script skipped because body exceeds max-size or uses an unsupported content encoding")
+				}
+				responseScript = nil
+				responseBody = nil
+			} else {
