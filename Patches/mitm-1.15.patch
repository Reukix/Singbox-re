+	request, _ := http.NewRequest(http.MethodGet, "https://example.com/", nil)
+	large := bytes.Repeat([]byte("a"), platformPreferBodySize)
+	result, err := script.ExecuteHTTPResponse(context.Background(), time.Second, request, testResponse(large), large, false, false, nil)
+	if err != nil || result.Body != nil {
+		t.Fatalf("a skipped run must fail open, not run in goja: body=%q err=%v", result.Body, err)
+	}
+	if platformEngaged.Load() {
+		t.Fatal("a skipped run must not count as a started engine")
+	}
+}
+
+func TestPlatformStartCostReservedOnce(t *testing.T) {
+	const mib = 1024 * 1024
+	script := newTestSurgeScript(t, `$done({});`)
+	var runs atomic.Int32
+	withPlatformEngine(t, &fakePlatformEngine{execute: func(invocation platformInvocation, host PlatformHost) string {
+		runs.Add(1)
+		return outcomeJSON(t, platformOutcome{Status: platformStatusDone, Value: &platformDone{Body: &platformBody{Encoding: platformBodyUTF8, Data: "changed"}}})
+	}})
+	body := bytes.Repeat([]byte("a"), platformPreferBodySize)
+	memguard.SetHeadroomFunc(func() (uint64, bool) { return memguard.Reserve + platformScriptCost(len(body)) + mib, true })
+	defer memguard.SetHeadroomFunc(nil)
+	request, _ := http.NewRequest(http.MethodGet, "https://example.com/", nil)
+
+	platformEngaged.Store(false)
+	result, err := script.ExecuteHTTPResponse(context.Background(), time.Second, request, testResponse(body), body, false, false, nil)
+	if err != nil || result.Body != nil || runs.Load() != 0 {
+		t.Fatalf("starting the engine without room for it: body=%q runs=%d err=%v", result.Body, runs.Load(), err)
+	}
+	platformEngaged.Store(true)
+	result, err = script.ExecuteHTTPResponse(context.Background(), time.Second, request, testResponse(body), body, false, false, nil)
+	if err != nil || string(result.Body) != "changed" || runs.Load() != 1 {
+		t.Fatalf("a started engine needs no start cost: body=%q runs=%d err=%v", result.Body, runs.Load(), err)
+	}
+}
diff --git a/script/program_cache.go b/script/program_cache.go
new file mode 100644
index 000000000..67eec886e
--- /dev/null
+++ b/script/program_cache.go
@@ -0,0 +1,179 @@
+//go:build with_script
+
+package script
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"runtime"
+	"sync"
+	"time"
+	"unsafe"
+
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+
+	"github.com/dop251/goja"
+)
+
+const programIdleDuration = 5 * time.Minute
+
+// lazyProgram holds a script's source and compiles it for goja only when goja
+// runs it. A large bundle (Script Hub, protobufjs) compiles to MiBs, so the
+// program is dropped again after an idle period; when scripts run in a
+// platform engine goja never compiles them at all.
+type lazyProgram struct {
+	name          string
+	logger        logger.ContextLogger
+	access        sync.Mutex
+	compileAccess sync.Mutex
+	content       []byte
+	fingerprint   string
+	program       *goja.Program
+	failed        bool
+	timer         *time.Timer
+	timerSequence uint64
+}
+
+func newLazyProgram(name string, logger logger.ContextLogger) *lazyProgram {
+	return &lazyProgram{name: name, logger: logger}
+}
+
+// setContent replaces the source; it is never modified in place afterwards,
+// which lets Text and the compiler share it without copies.
+func (p *lazyProgram) setContent(content []byte) {
+	cloned := make([]byte, len(content))
+	copy(cloned, content)
+	p.setSharedContent(cloned)
+}
+
+// setSharedContent is setContent for a buffer nobody writes to again, which
+// the program then keeps without copying.
+func (p *lazyProgram) setSharedContent(content []byte) {
+	sum := sha256.Sum256(content)
+	p.access.Lock()
+	p.stopTimerLocked()
+	p.content = content
+	p.fingerprint = hex.EncodeToString(sum[:16])
+	p.program = nil
+	p.failed = false
+	p.access.Unlock()
+}
+
+// setCompiled replaces the source together with its already compiled program.
+func (p *lazyProgram) setCompiled(content []byte, program *goja.Program) {
+	p.setContent(content)
+	p.access.Lock()
+	p.program = program
+	p.access.Unlock()
+	p.armExpiry(program)
+}
+
+func (p *lazyProgram) uncompiledLength() int {
+	p.access.Lock()
+	defer p.access.Unlock()
+	if p.program != nil || p.failed {
+		return 0
+	}
+	return len(p.content)
+}
+
+func (p *lazyProgram) hasContent() bool {
+	p.access.Lock()
+	defer p.access.Unlock()
+	return len(p.content) > 0
+}
+
+// Text returns the source and its fingerprint without copying.
+func (p *lazyProgram) Text() (string, string) {
+	p.access.Lock()
+	defer p.access.Unlock()
+	if len(p.content) == 0 {
+		return "", ""
+	}
+	return unsafe.String(unsafe.SliceData(p.content), len(p.content)), p.fingerprint
+}
+
+func (p *lazyProgram) Program() *goja.Program {
+	p.access.Lock()
+	program, content, failed := p.program, p.content, p.failed
+	p.access.Unlock()
+	if program != nil {
+		p.armExpiry(program)
+		return program
+	}
+	if len(content) == 0 || failed {
+		return nil
+	}
+	p.compileAccess.Lock()
+	defer p.compileAccess.Unlock()
+	p.access.Lock()
+	program, content, failed = p.program, p.content, p.failed
+	p.access.Unlock()
+	if program != nil {
+		p.armExpiry(program)
+		return program
+	}
+	if len(content) == 0 || failed {
+		return nil
+	}
+	program, err := compileScript(p.name, unsafe.String(unsafe.SliceData(content), len(content)))
+	p.access.Lock()
+	current := len(p.content) > 0 && unsafe.SliceData(p.content) == unsafe.SliceData(content)
+	if err != nil {
+		if current {
+			p.failed = true
+		}
+		p.access.Unlock()
+		p.logger.Error(E.Cause(err, "compile ", p.name))
+		return nil
+	}
+	if current {
+		p.program = program
+	}
+	p.access.Unlock()
+	p.armExpiry(program)
+	return program
+}
+
+func (p *lazyProgram) armExpiry(program *goja.Program) {
+	p.access.Lock()
+	defer p.access.Unlock()
+	if p.program != program {
+		return
+	}
+	p.stopTimerLocked()
+	p.timerSequence++
+	sequence := p.timerSequence
+	p.timer = time.AfterFunc(programIdleDuration, func() {
+		p.access.Lock()
+		// A timer that fired while it was being replaced must not drop the
+		// program its successor keeps alive.
+		dropped := p.timerSequence == sequence && p.program == program
+		if dropped {
+			p.program = nil
+			p.timer = nil
+		}
+		p.access.Unlock()
+		if dropped {
+			runtime.GC()
+		}
+	})
+}
+
+func (p *lazyProgram) stopTimerLocked() {
+	if p.timer != nil {
+		p.timer.Stop()
+		p.timer = nil
+	}
+	p.timerSequence++
+}
+
+func (p *lazyProgram) close() {
+	p.access.Lock()
+	p.stopTimerLocked()
+	p.program = nil
+	p.content = nil
+	p.fingerprint = ""
+	p.access.Unlock()
+}
diff --git a/script/runtime.go b/script/runtime.go
new file mode 100644
