diff --git a/experimental/libbox/mitm_certificate.go b/experimental/libbox/mitm_certificate.go
new file mode 100644
index 000000000..163bccb6b
--- /dev/null
+++ b/experimental/libbox/mitm_certificate.go
@@ -0,0 +1,81 @@
+package libbox
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/base64"
+	"encoding/hex"
+	"math/big"
+	"time"
+
+	E "github.com/sagernet/sing/common/exceptions"
+
+	"software.sslmate.com/src/go-pkcs12"
+)
+
+type MITMCertificate struct {
+	KeyPair     string
+	Password    string
+	Certificate string
+}
+
+func GenerateMITMCertificate(commonName string) (*MITMCertificate, error) {
+	if commonName == "" {
+		commonName = "sing-box MITM Root CA"
+	}
+	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		return nil, E.Cause(err, "generate RSA private key")
+	}
+	serialNumber, err := rand.Int(rand.Reader, new(big.Int).Lsh(big.NewInt(1), 128))
+	if err != nil {
+		return nil, E.Cause(err, "generate certificate serial number")
+	}
+	now := time.Now()
+	template := &x509.Certificate{
+		SerialNumber:          serialNumber,
+		Subject:               pkix.Name{CommonName: commonName, Organization: []string{"Local sing-box MITM"}},
+		NotBefore:             now.Add(-time.Hour),
+		NotAfter:              now.AddDate(10, 0, 0),
+		KeyUsage:              x509.KeyUsageDigitalSignature | x509.KeyUsageCertSign | x509.KeyUsageCRLSign,
+		BasicConstraintsValid: true,
+		IsCA:                  true,
+	}
+	certificateDER, err := x509.CreateCertificate(rand.Reader, template, template, &privateKey.PublicKey, privateKey)
+	if err != nil {
+		return nil, E.Cause(err, "create root certificate")
+	}
+	certificate, err := x509.ParseCertificate(certificateDER)
+	if err != nil {
+		return nil, E.Cause(err, "parse generated root certificate")
+	}
+	passwordBytes := make([]byte, 16)
+	_, err = rand.Read(passwordBytes)
+	if err != nil {
+		return nil, E.Cause(err, "generate PKCS#12 password")
+	}
+	password := hex.EncodeToString(passwordBytes)
+	keyPair, err := pkcs12.Modern2023.Encode(privateKey, certificate, nil, password)
+	if err != nil {
+		return nil, E.Cause(err, "encode PKCS#12 key pair")
+	}
+	return &MITMCertificate{
+		KeyPair:     base64.StdEncoding.EncodeToString(keyPair),
+		Password:    password,
+		Certificate: base64.StdEncoding.EncodeToString(certificateDER),
+	}, nil
+}
+
+func ExportMITMCertificate(keyPair string, password string) (*StringBox, error) {
+	keyPairBytes, err := base64.StdEncoding.DecodeString(keyPair)
+	if err != nil {
+		return nil, E.Cause(err, "decode PKCS#12 key pair")
+	}
+	_, certificate, err := pkcs12.Decode(keyPairBytes, password)
+	if err != nil {
+		return nil, E.Cause(err, "decode PKCS#12 key pair")
+	}
+	return wrapString(base64.StdEncoding.EncodeToString(certificate.Raw)), nil
+}
