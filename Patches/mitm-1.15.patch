+// serveOneHTTP1 sends request through the engine's HTTP/1 path and returns
+// the response body.
+func serveOneHTTP1(t *testing.T, engine *Engine, metadata adapter.InboundContext, request *http.Request) (*http.Response, []byte) {
+	t.Helper()
+	client, server := net.Pipe()
+	t.Cleanup(func() { _ = client.Close() })
+	session := engine.sessions.add(server)
+	served := make(chan error, 1)
+	go func() {
+		served <- engine.newHTTP1(context.Background(), &countingDialer{}, server, nil, metadata, session)
+	}()
+	request.Close = true
+	go func() { _ = request.Write(client) }()
+	_ = client.SetReadDeadline(time.Now().Add(10 * time.Second))
+	response, err := http.ReadResponse(bufio.NewReader(client), request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := io.ReadAll(response.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = client.Close()
+	select {
+	case err := <-served:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("HTTP/1 session did not end")
+	}
+	return response, body
+}
+
+// TestHTTP1OversizedRequestBodyRewritePassesThrough: a request body above the
+// platform limit must be forwarded untouched, not fail the request.
+func TestHTTP1OversizedRequestBodyRewritePassesThrough(t *testing.T) {
+	var received atomic.Value
+	upstream := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		content, _ := io.ReadAll(request.Body)
+		received.Store(content)
+		_, _ = writer.Write([]byte("ok"))
+	}))
+	defer upstream.Close()
+	engine := testEngine(1024 * 1024)
+	engine.limits.maxBody = 64 * 1024
+	engine.timeFunc = time.Now
+	engine.upstream = newUpstreamPool(&engine.limits)
+	defer engine.upstream.close()
+	engine.script = &fakeScriptManager{}
+	metadata := adapter.InboundContext{
+		Destination: M.ParseSocksaddr(upstream.Listener.Addr().String()),
+		MITM: &option.MITMRouteOptions{
+			Enabled: true,
+			SurgeBodyRewrite: []option.SurgeBodyRewriteLine{{
+				Pattern: regexp.MustCompile(`/upload$`),
+				Match:   []*regexp.Regexp{regexp.MustCompile(`secret`)},
+				Replace: []string{"public"},
+			}},
+		},
+	}
+	payload := bytes.Repeat([]byte("secret-"), 32*1024)
+	request, err := http.NewRequest(http.MethodPost, "http://"+upstream.Listener.Addr().String()+"/upload", bytes.NewReader(payload))
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, body := serveOneHTTP1(t, engine, metadata, request)
+	if response.StatusCode != http.StatusOK || string(body) != "ok" {
+		t.Fatalf("oversized request failed: %d %q", response.StatusCode, body)
+	}
+	if content, _ := received.Load().([]byte); !bytes.Equal(content, payload) {
+		t.Fatalf("upstream got %d bytes, want the original %d", len(content), len(payload))
+	}
+}
diff --git a/mitm/leaf.go b/mitm/leaf.go
new file mode 100644
index 000000000..445ffcb92
--- /dev/null
+++ b/mitm/leaf.go
@@ -0,0 +1,139 @@
+package mitm
+
+import (
+	"container/list"
+	"crypto"
+	"crypto/tls"
+	"crypto/x509"
+	"sync"
+	"time"
+
+	sTLS "github.com/sagernet/sing-box/common/tls"
+	C "github.com/sagernet/sing-box/constant"
+)
+
+const (
+	leafCertificateLifetime = time.Hour
+	leafCertificateRefresh  = 45 * time.Minute
+)
+
+// leafCache issues and caches intercepted server certificates.
+//
+// All certificates share one ECDSA key, so issuing one costs a single CA
+// signature. Issuance runs outside the cache lock and concurrent handshakes
+// for the same host wait for one result, so a burst of new hosts neither
+// serializes behind key generation nor piles up buffered handshakes.
+type leafCache struct {
+	access     sync.Mutex
+	entries    map[string]*leafEntry
+	order      *list.List
+	maxEntries int
+	keyOnce    sync.Once
+	key        crypto.Signer
+	keyErr     error
+}
+
+type leafEntry struct {
+	serverName  string
+	ready       chan struct{}
+	certificate *tls.Certificate
+	err         error
+	refreshAt   time.Time
+	element     *list.Element
+}
+
+func newLeafCache() *leafCache {
+	maxEntries := 1024
+	if C.IsIos {
+		maxEntries = 128
+	}
+	return &leafCache{
+		entries:    make(map[string]*leafEntry),
+		order:      list.New(),
+		maxEntries: maxEntries,
+	}
+}
+
+func (c *leafCache) leafKey() (crypto.Signer, error) {
+	c.keyOnce.Do(func() {
+		c.key, c.keyErr = sTLS.GenerateLeafKey()
+	})
+	return c.key, c.keyErr
+}
+
+func (c *leafCache) get(serverName string, now time.Time, parent *x509.Certificate, parentKey any) (*tls.Certificate, error) {
+	c.access.Lock()
+	if entry, loaded := c.entries[serverName]; loaded {
+		select {
+		case <-entry.ready:
+			if entry.err == nil && now.Before(entry.refreshAt) {
+				c.order.MoveToFront(entry.element)
+				c.access.Unlock()
+				return entry.certificate, nil
+			}
+			// Expired: issue a fresh one below.
+			c.removeLocked(entry)
+		default:
+			// Another handshake is issuing this host; share its result.
+			c.access.Unlock()
+			<-entry.ready
+			return entry.certificate, entry.err
+		}
+	}
+	entry := &leafEntry{serverName: serverName, ready: make(chan struct{})}
+	entry.element = c.order.PushFront(entry)
+	c.entries[serverName] = entry
+	for len(c.entries) > c.maxEntries {
+		oldest := c.order.Back().Value.(*leafEntry)
+		select {
+		case <-oldest.ready:
+			c.removeLocked(oldest)
+			continue
+		default:
+		}
+		break
+	}
+	c.access.Unlock()
+
+	certificate, err := c.issue(serverName, now, parent, parentKey)
+	c.access.Lock()
+	entry.certificate = certificate
+	entry.err = err
+	entry.refreshAt = now.Add(leafCertificateRefresh)
+	if err != nil {
+		c.removeLocked(entry)
+	}
+	close(entry.ready)
+	c.access.Unlock()
+	return certificate, err
+}
+
+func (c *leafCache) issue(serverName string, now time.Time, parent *x509.Certificate, parentKey any) (*tls.Certificate, error) {
+	leafKey, err := c.leafKey()
+	if err != nil {
+		return nil, err
+	}
+	return sTLS.GenerateLeafCertificate(parent, parentKey, leafKey, now.Add(-time.Hour), now.Add(leafCertificateLifetime), serverName)
+}
+
+func (c *leafCache) removeLocked(entry *leafEntry) {
+	if current, loaded := c.entries[entry.serverName]; loaded && current == entry {
+		delete(c.entries, entry.serverName)
+	}
+	if entry.element != nil {
+		c.order.Remove(entry.element)
+		entry.element = nil
+	}
+}
+
+func (c *leafCache) clear() {
+	c.access.Lock()
+	defer c.access.Unlock()
+	for _, entry := range c.entries {
+		select {
+		case <-entry.ready:
+			c.removeLocked(entry)
+		default:
+		}
+	}
+}
diff --git a/mitm/leaf_test.go b/mitm/leaf_test.go
new file mode 100644
index 000000000..fcb9ebdb2
--- /dev/null
+++ b/mitm/leaf_test.go
@@ -0,0 +1,148 @@
+package mitm
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"math/big"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+func testCA(t *testing.T) (*x509.Certificate, *ecdsa.PrivateKey) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: "test MITM CA"},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(24 * time.Hour),
+		KeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature,
+		BasicConstraintsValid: true,
+		IsCA:                  true,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, key.Public(), key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	certificate, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return certificate, key
+}
+
+func verifyLeaf(t *testing.T, certificate *tls.Certificate, ca *x509.Certificate, serverName string) {
+	t.Helper()
+	roots := x509.NewCertPool()
+	roots.AddCert(ca)
+	leaf := certificate.Leaf
+	if leaf == nil {
+		t.Fatal("leaf not populated")
+	}
+	if _, err := leaf.Verify(x509.VerifyOptions{DNSName: serverName, Roots: roots}); err != nil {
+		t.Fatalf("leaf for %s does not verify: %v", serverName, err)
+	}
+	if leaf.KeyUsage != x509.KeyUsageDigitalSignature {
+		t.Fatalf("ECDSA leaf must only carry digitalSignature, got %v", leaf.KeyUsage)
+	}
+	if len(leaf.ExtKeyUsage) != 1 || leaf.ExtKeyUsage[0] != x509.ExtKeyUsageServerAuth {
+		t.Fatalf("leaf must be serverAuth only: %v", leaf.ExtKeyUsage)
+	}
+	if _, isECDSA := certificate.PrivateKey.(*ecdsa.PrivateKey); !isECDSA {
+		t.Fatalf("leaf key is %T, want ECDSA", certificate.PrivateKey)
+	}
+}
+
+func TestLeafCacheSharesConcurrentIssuance(t *testing.T) {
+	ca, caKey := testCA(t)
+	cache := newLeafCache()
+	now := time.Now()
+	const workers = 16
+	results := make([]*tls.Certificate, workers)
+	var wait sync.WaitGroup
+	for index := range workers {
+		wait.Add(1)
+		go func() {
+			defer wait.Done()
+			certificate, err := cache.get("app.example.com", now, ca, caKey)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			results[index] = certificate
+		}()
+	}
+	wait.Wait()
+	for _, certificate := range results {
+		if certificate != results[0] {
+			t.Fatal("concurrent handshakes for one host issued different certificates")
+		}
+	}
+	verifyLeaf(t, results[0], ca, "app.example.com")
+	other, err := cache.get("cdn.example.com", now, ca, caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	verifyLeaf(t, other, ca, "cdn.example.com")
+	if other.PrivateKey != results[0].PrivateKey {
+		t.Fatal("hosts must share one leaf key")
+	}
+}
+
+func TestLeafCacheEvictsLeastRecentlyUsed(t *testing.T) {
+	ca, caKey := testCA(t)
+	cache := newLeafCache()
+	cache.maxEntries = 2
+	now := time.Now()
+	first, _ := cache.get("a.example", now, ca, caKey)
+	_, _ = cache.get("b.example", now, ca, caKey)
+	// Touch a so b becomes the eviction candidate.
+	if again, _ := cache.get("a.example", now, ca, caKey); again != first {
+		t.Fatal("cached certificate not reused")
+	}
+	_, _ = cache.get("c.example", now, ca, caKey)
+	if _, loaded := cache.entries["b.example"]; loaded {
+		t.Fatal("least recently used entry was not evicted")
+	}
+	if _, loaded := cache.entries["a.example"]; !loaded {
+		t.Fatal("recently used entry was evicted")
+	}
+	if len(cache.entries) != 2 || cache.order.Len() != 2 {
+		t.Fatalf("cache holds %d entries (%d ordered), want 2", len(cache.entries), cache.order.Len())
+	}
+}
+
+func TestLeafCacheRefreshesBeforeExpiry(t *testing.T) {
+	ca, caKey := testCA(t)
+	cache := newLeafCache()
+	now := time.Now()
+	first, _ := cache.get("refresh.example", now, ca, caKey)
+	second, _ := cache.get("refresh.example", now.Add(leafCertificateRefresh+time.Minute), ca, caKey)
+	if first == second {
+		t.Fatal("certificate past its refresh time was reused")
+	}
+	if !second.Leaf.NotAfter.After(now.Add(leafCertificateRefresh)) {
+		t.Fatal("refreshed certificate does not extend validity")
+	}
+}
+
+func TestLeafCacheIPAddress(t *testing.T) {
+	ca, caKey := testCA(t)
+	cache := newLeafCache()
+	certificate, err := cache.get("192.0.2.10", time.Now(), ca, caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(certificate.Leaf.IPAddresses) != 1 || !certificate.Leaf.IPAddresses[0].Equal(net.ParseIP("192.0.2.10")) {
+		t.Fatalf("IP leaf has %v", certificate.Leaf.IPAddresses)
+	}
+}
