+func TestBufferHTTPBodyGzip(t *testing.T) {
+	var compressed bytes.Buffer
+	writer := gzip.NewWriter(&compressed)
+	_, _ = writer.Write([]byte("decoded body"))
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	headers := make(http.Header)
+	headers.Set("Content-Encoding", "gzip")
+	body, replay, available, decoded, err := bufferHTTPBody(
+		io.NopCloser(bytes.NewReader(compressed.Bytes())),
+		int64(compressed.Len()),
+		headers,
+		1024,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer replay.Close()
+	if !available || !decoded || string(body) != "decoded body" {
+		t.Fatalf("unexpected decoded body: available=%v decoded=%v body=%q", available, decoded, body)
+	}
+}
+
+func TestSurgePatternMatchesHostAndConnectionHost(t *testing.T) {
+	pattern := regexp.MustCompile(`^https://logical\.example/`)
+	if !surgePatternMatches(pattern, "https://1.2.3.4/path", "logical.example", "") {
+		t.Fatal("pattern did not match rebuilt Host URL")
+	}
+	if !surgePatternMatches(pattern, "https://1.2.3.4/path", "other.example", "logical.example") {
+		t.Fatal("pattern did not match rebuilt connection-host URL")
+	}
+}
+
+func TestBufferHTTPBodyTooLargeReplaysEverything(t *testing.T) {
+	original := []byte("0123456789")
+	_, replay, available, _, err := bufferHTTPBody(
+		io.NopCloser(bytes.NewReader(original)),
+		-1,
+		make(http.Header),
+		4,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer replay.Close()
+	if available {
+		t.Fatal("oversized body unexpectedly available")
+	}
+	replayed, err := io.ReadAll(replay)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(replayed, original) {
+		t.Fatalf("replayed body changed: %q", replayed)
+	}
+}
+
+func TestSetResponseBodyOwnsFraming(t *testing.T) {
+	response := &http.Response{
+		Header: http.Header{
+			"Content-Encoding":  []string{"gzip"},
+			"Content-Length":    []string{"999"},
+			"Transfer-Encoding": []string{"chunked"},
