+// alone does not bound memory.
+var (
+	logEntryMaxBytes = platformLogValue(8*1024, 64*1024)
+	logRingMaxBytes  = platformLogValue(1024*1024, 16*1024*1024)
+)
+
+func platformLogValue(ios int, other int) int {
