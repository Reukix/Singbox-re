new file mode 100644
index 000000000..4697347e7
--- /dev/null
+++ b/mitm/limits.go
@@ -0,0 +1,94 @@
+package mitm
+
+import (
+	"time"
+
+	C "github.com/sagernet/sing-box/constant"
+)
+
+// engineLimits bounds every buffer the MITM engine owns. The iOS values keep a
+// busy MITM session inside the 50 MiB Network Extension footprint; other
+// platforms keep generous values that favor throughput.
+type engineLimits struct {
+	// bodyBudget is the global number of bytes all buffered bodies (wire,
+	// decoded and rewritten copies) may hold at once.
+	bodyBudget int64
+	// maxBody caps any single buffered body, whatever max-size says.
+	maxBody int64
+	// printBody caps bodies copied into the log by the print option.
+	printBody int64
+
+	// Downstream (client-facing) HTTP/2 server. The client is local, so small
+	// windows cost no throughput.
+	serverMaxConcurrentStreams uint32
+	serverMaxReadFrameSize     uint32
+	serverConnectionWindow     int32
+	serverStreamWindow         int32
+	serverIdleTimeout          time.Duration
+
+	// Upstream HTTP/2 receive windows: the most data a slow client can leave
+	// buffered in the engine per stream / per upstream connection. Clients
+	// share upstream connections, so the connection window is many stream
+	// windows wide: a few stalled streams (a paused video) must not stall
+	// every other request to the same host.
+	upstreamStreamWindow     int32
+	upstreamConnectionWindow int32
+	upstreamIdleTimeout      time.Duration
+	upstreamMaxIdlePerHost   int
+	upstreamTransportIdle    time.Duration
+	// upstreamHTTP1ConnsPerHost bounds parallel HTTP/1 connections to one
+	// upstream host; excess requests wait for a free connection.
+	upstreamHTTP1ConnsPerHost int
+
+	// HTTP/1 keep-alive connections are closed after this much inactivity.
+	http1IdleTimeout time.Duration
+
+	// Admission of new MITM sessions: above maxSessions, or with less
+	// free memory than sessionHeadroom, new connections pass through
+	// without interception.
+	maxSessions     int32
+	sessionHeadroom uint64
+}
+
+func platformLimits() engineLimits {
+	if C.IsIos {
+		return engineLimits{
+			bodyBudget:                 6 * 1024 * 1024,
+			maxBody:                    2 * 1024 * 1024,
+			printBody:                  16 * 1024,
+			serverMaxConcurrentStreams: 64,
+			serverMaxReadFrameSize:     16 * 1024,
+			serverConnectionWindow:     256 * 1024,
+			serverStreamWindow:         128 * 1024,
+			serverIdleTimeout:          90 * time.Second,
+			upstreamStreamWindow:       256 * 1024,
+			upstreamConnectionWindow:   4 * 1024 * 1024,
+			upstreamIdleTimeout:        45 * time.Second,
+			upstreamMaxIdlePerHost:     2,
+			upstreamTransportIdle:      2 * time.Minute,
+			upstreamHTTP1ConnsPerHost:  6,
+			http1IdleTimeout:           60 * time.Second,
+			maxSessions:                48,
+			sessionHeadroom:            12 * 1024 * 1024,
+		}
+	}
+	return engineLimits{
+		bodyBudget:                 64 * 1024 * 1024,
+		maxBody:                    32 * 1024 * 1024,
+		printBody:                  128 * 1024,
+		serverMaxConcurrentStreams: 250,
+		serverMaxReadFrameSize:     16 * 1024,
+		serverConnectionWindow:     1024 * 1024,
+		serverStreamWindow:         1024 * 1024,
+		serverIdleTimeout:          3 * time.Minute,
+		upstreamStreamWindow:       1024 * 1024,
+		upstreamConnectionWindow:   16 * 1024 * 1024,
+		upstreamIdleTimeout:        90 * time.Second,
+		upstreamMaxIdlePerHost:     4,
+		upstreamTransportIdle:      5 * time.Minute,
+		upstreamHTTP1ConnsPerHost:  16,
+		http1IdleTimeout:           2 * time.Minute,
+		maxSessions:                1024,
+		sessionHeadroom:            0,
+	}
+}
diff --git a/mitm/session.go b/mitm/session.go
new file mode 100644
index 000000000..49ce33760
--- /dev/null
+++ b/mitm/session.go
@@ -0,0 +1,81 @@
+package mitm
+
+import (
+	"net"
+	"sync"
+	"sync/atomic"
+)
+
+// mitmSession is one intercepted client connection.
+type mitmSession struct {
+	conn   net.Conn
+	active atomic.Int32
+}
+
+func (s *mitmSession) begin() {
+	s.active.Add(1)
+}
+
+func (s *mitmSession) end() {
+	s.active.Add(-1)
+}
+
+// sessionTracker counts live sessions for admission and lets memory pressure
+// close the ones that are idle right now.
+type sessionTracker struct {
+	access   sync.Mutex
+	sessions map[*mitmSession]struct{}
+	count    atomic.Int32
+}
+
+func (t *sessionTracker) add(conn net.Conn) *mitmSession {
+	session := &mitmSession{conn: conn}
+	t.access.Lock()
+	if t.sessions == nil {
+		t.sessions = make(map[*mitmSession]struct{})
+	}
+	t.sessions[session] = struct{}{}
+	t.access.Unlock()
+	t.count.Add(1)
+	return session
+}
+
+func (t *sessionTracker) remove(session *mitmSession) {
+	t.access.Lock()
+	_, loaded := t.sessions[session]
+	delete(t.sessions, session)
+	t.access.Unlock()
+	if loaded {
+		t.count.Add(-1)
+	}
+}
+
+// closeIdle closes sessions without an in-flight request and returns how many
+// were closed. Clients reconnect on demand, so this frees their buffers
+// without failing any request.
+func (t *sessionTracker) closeIdle() int {
+	var idle []*mitmSession
+	t.access.Lock()
+	for session := range t.sessions {
+		if session.active.Load() == 0 {
+			idle = append(idle, session)
+		}
+	}
+	t.access.Unlock()
+	for _, session := range idle {
+		_ = session.conn.Close()
+	}
+	return len(idle)
+}
+
+func (t *sessionTracker) closeAll() {
+	t.access.Lock()
+	sessions := make([]*mitmSession, 0, len(t.sessions))
+	for session := range t.sessions {
+		sessions = append(sessions, session)
+	}
+	t.access.Unlock()
+	for _, session := range sessions {
+		_ = session.conn.Close()
+	}
+}
diff --git a/mitm/session_test.go b/mitm/session_test.go
new file mode 100644
index 000000000..4910937fa
--- /dev/null
+++ b/mitm/session_test.go
@@ -0,0 +1,85 @@
+package mitm
+
+import (
+	"crypto/tls"
+	"net"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/memguard"
+	"github.com/sagernet/sing-tun"
+)
+
+func TestAdmitSessionLimits(t *testing.T) {
+	engine := testEngine(1024)
+	engine.limits.maxSessions = 1
+	engine.limits.sessionHeadroom = 12 * 1024 * 1024
+	if admitted, reason := engine.admitSession(); !admitted {
+		t.Fatalf("idle engine refused a session: %s", reason)
+	}
+	client, server := net.Pipe()
+	defer client.Close()
+	session := engine.sessions.add(server)
+	if admitted, _ := engine.admitSession(); admitted {
+		t.Fatal("session limit not enforced")
+	}
+	engine.sessions.remove(session)
+
+	engine.pressure = func() tun.MemoryPressure { return tun.MemoryPressureWarning }
+	if admitted, _ := engine.admitSession(); admitted {
+		t.Fatal("memory pressure must stop interception")
+	}
+	engine.pressure = nil
+
+	memguard.SetHeadroomFunc(func() (uint64, bool) { return 10 * 1024 * 1024, true })
+	defer memguard.SetHeadroomFunc(nil)
+	if admitted, _ := engine.admitSession(); admitted {
+		t.Fatal("low headroom must stop interception")
+	}
+	memguard.SetHeadroomFunc(func() (uint64, bool) { return 30 * 1024 * 1024, true })
+	if admitted, reason := engine.admitSession(); !admitted {
+		t.Fatalf("enough headroom refused: %s", reason)
+	}
+}
+
+func TestSessionTrackerClosesOnlyIdleSessions(t *testing.T) {
+	var tracker sessionTracker
+	idleClient, idleServer := net.Pipe()
+	busyClient, busyServer := net.Pipe()
+	defer idleClient.Close()
+	defer busyClient.Close()
+	idle := tracker.add(idleServer)
+	busy := tracker.add(busyServer)
+	busy.begin()
+	if closed := tracker.closeIdle(); closed != 1 {
+		t.Fatalf("closed %d sessions, want 1", closed)
+	}
+	if _, err := idleServer.Write([]byte("x")); err == nil {
+		t.Fatal("idle session still open")
+	}
+	busy.end()
+	tracker.remove(idle)
+	tracker.remove(busy)
+	tracker.remove(busy)
+	if tracker.count.Load() != 0 {
+		t.Fatalf("count %d after removing all sessions", tracker.count.Load())
+	}
+}
+
+func TestTLSPassthroughReason(t *testing.T) {
+	metadata := func(protos ...string) adapter.InboundContext {
+		return adapter.InboundContext{ClientHello: &tls.ClientHelloInfo{ServerName: "example.com", SupportedProtos: protos}}
+	}
+	if reason := tlsPassthroughReason(false, metadata("h2")); reason == "" {
+		t.Fatal("h2-only client without MITM HTTP/2 must pass through")
+	}
+	if reason := tlsPassthroughReason(true, metadata("h2")); reason != "" {
+		t.Fatalf("h2-only client with MITM HTTP/2: %s", reason)
+	}
+	if reason := tlsPassthroughReason(false, metadata("h2", "http/1.1")); reason != "" {
+		t.Fatalf("http/1.1 client: %s", reason)
+	}
+	if reason := tlsPassthroughReason(false, metadata()); reason != "" {
+		t.Fatalf("client without ALPN: %s", reason)
+	}
+}
diff --git a/mitm/upstream.go b/mitm/upstream.go
new file mode 100644
index 000000000..7c403e563
--- /dev/null
+++ b/mitm/upstream.go
@@ -0,0 +1,216 @@
+package mitm
+
+import (
+	"context"
+	"crypto/tls"
+	"net"
+	"net/http"
+	"reflect"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/dialer"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"golang.org/x/net/http2"
+)
+
+// upstreamKey identifies a shareable upstream transport. Requests with the
+// same outbound, destination, TLS server name and version range reuse one
+// transport, which pools connections per request host: an intercepted HTTP/2
+// client with 50 streams now shares one upstream connection instead of
+// dialing 50 proxied connections and TLS handshakes.
+type upstreamKey struct {
+	// dialer identifies the outbound: its tag, or the dialer pointer itself.
+	dialer any
+	// destination is where the transport dials. The transport pools by URL
+	// host only, so requests routed to different addresses for the same
+	// host (override_address, a Host header without its port) must not share.
+	destination string
+	serverName  string
+	minVersion  uint16
+	maxVersion  uint16
+	tls         bool
+	http2       bool
+}
+
+type upstreamTransport struct {
+	transport *http.Transport
+	inFlight  atomic.Int32
+	lastUsed  atomic.Int64
+}
+
+type upstreamPool struct {
+	access     sync.Mutex
+	transports map[upstreamKey]*upstreamTransport
+	limits     *engineLimits
+	timeFunc   func() time.Time
+	closed     bool
+}
+
+func newUpstreamPool(limits *engineLimits) *upstreamPool {
+	return &upstreamPool{
+		transports: make(map[upstreamKey]*upstreamTransport),
+		limits:     limits,
+		timeFunc:   time.Now,
+	}
+}
+
+// upstreamKeyFor derives the pool key from the connection's destination and
+// the per-request TLS config the engine already builds; tlsConfig is nil for
+// plain HTTP. poolable is false when the dialer has no stable identity to
+// key on.
+func upstreamKeyFor(this N.Dialer, destination M.Socksaddr, tlsConfig *tls.Config, http2Allowed bool) (key upstreamKey, poolable bool) {
+	key.destination = destination.String()
+	key.http2 = http2Allowed && tlsConfig != nil
+	if tlsConfig != nil {
+		key.tls = true
+		key.serverName = tlsConfig.ServerName
+		key.minVersion = tlsConfig.MinVersion
+		key.maxVersion = tlsConfig.MaxVersion
+	}
+	switch dialerValue := this.(type) {
+	case adapter.Outbound:
+		key.dialer = "outbound/" + dialerValue.Tag()
+	default:
+		if this == nil || reflect.TypeOf(this).Kind() != reflect.Pointer {
+			return key, false
+		}
+		key.dialer = this
+	}
+	return key, true
+}
+
+// acquire returns the transport for key, creating it with this as the
+// dialer; release must be called once the response body is closed.
+func (p *upstreamPool) acquire(key upstreamKey, this N.Dialer) (*upstreamTransport, error) {
+	p.access.Lock()
+	defer p.access.Unlock()
+	if p.closed {
+		return nil, net.ErrClosed
+	}
+	transport, loaded := p.transports[key]
+	if !loaded {
+		newTransport, err := p.newTransport(key, this)
+		if err != nil {
+			return nil, err
+		}
+		transport = &upstreamTransport{transport: newTransport}
+		p.transports[key] = transport
+	}
+	transport.inFlight.Add(1)
+	transport.lastUsed.Store(p.timeFunc().UnixNano())
+	return transport, nil
+}
+
+func (p *upstreamPool) release(transport *upstreamTransport) {
+	transport.lastUsed.Store(p.timeFunc().UnixNano())
+	transport.inFlight.Add(-1)
+}
+
+func (p *upstreamPool) newTransport(key upstreamKey, this N.Dialer) (*http.Transport, error) {
+	limits := p.limits
+	transport := &http.Transport{
+		DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+			// The request context carries the intercepted connection's
+			// metadata; net/http keeps its values for the dial.
+			metadata := adapter.ContextFrom(ctx)
+			if metadata == nil {
+				return nil, E.New("MITM upstream dial without connection metadata")
+			}
+			if len(metadata.DestinationAddresses) > 0 || metadata.Destination.IsIP() {
+				return dialer.DialSerialNetwork(ctx, this, N.NetworkTCP, metadata.Destination, metadata.DestinationAddresses, metadata.NetworkStrategy, metadata.NetworkType, metadata.FallbackNetworkType, metadata.FallbackDelay)
+			}
+			return this.DialContext(ctx, N.NetworkTCP, metadata.Destination)
+		},
+		ForceAttemptHTTP2:     key.http2,
+		MaxConnsPerHost:       limits.upstreamHTTP1ConnsPerHost,
+		MaxIdleConnsPerHost:   limits.upstreamMaxIdlePerHost,
+		IdleConnTimeout:       limits.upstreamIdleTimeout,
+		TLSHandshakeTimeout:   15 * time.Second,
+		ExpectContinueTimeout: time.Second,
+	}
+	if key.tls {
+		transport.TLSClientConfig = &tls.Config{
+			Time:       p.timeFunc,
+			ServerName: key.serverName,
+			MinVersion: key.minVersion,
+			MaxVersion: key.maxVersion,
+		}
+	}
+	if key.http2 {
+		// Until the first connection exists, every concurrent request dials
+		// its own: a client opening 40 streams at once made 40 proxied dials
+		// and TLS handshakes, all but one thrown away after ALPN. For HTTP/2
+		// MaxConnsPerHost limits the dials in flight, so the requests wait
+		// for one connection and share it.
+		transport.MaxConnsPerHost = 2
+		// x/net defaults to a 4 MiB per-stream and 1 GiB per-connection
+		// receive window: with a slow client every stream could park 4 MiB
+		// in the engine. These windows bound that, per stream and per
+		// upstream connection.
+		transport.HTTP2 = &http.HTTP2Config{
+			MaxReceiveBufferPerStream:     int(limits.upstreamStreamWindow),
+			MaxReceiveBufferPerConnection: int(limits.upstreamConnectionWindow),
+			SendPingTimeout:               30 * time.Second,
+			PingTimeout:                   15 * time.Second,
+		}
+		err := http2.ConfigureTransport(transport)
+		if err != nil {
+			return nil, E.Cause(err, "configure HTTP/2 transport")
+		}
+	}
+	return transport, nil
+}
+
+// closeIdle drops every idle upstream connection, e.g. under memory pressure.
+func (p *upstreamPool) closeIdle() {
+	p.access.Lock()
+	transports := make([]*upstreamTransport, 0, len(p.transports))
+	for _, transport := range p.transports {
+		transports = append(transports, transport)
+	}
+	p.access.Unlock()
+	for _, transport := range transports {
+		transport.transport.CloseIdleConnections()
+	}
+}
+
+// cleanup forgets transports that carried no request for a while, so pools
+// for hosts the user no longer visits do not linger.
+func (p *upstreamPool) cleanup() {
+	threshold := p.timeFunc().Add(-p.limits.upstreamTransportIdle).UnixNano()
+	var stale []*upstreamTransport
+	p.access.Lock()
+	for key, transport := range p.transports {
+		if transport.inFlight.Load() == 0 && transport.lastUsed.Load() < threshold {
+			delete(p.transports, key)
+			stale = append(stale, transport)
+		}
+	}
+	p.access.Unlock()
+	for _, transport := range stale {
+		transport.transport.CloseIdleConnections()
+	}
+}
+
+func (p *upstreamPool) size() int {
+	p.access.Lock()
+	defer p.access.Unlock()
+	return len(p.transports)
+}
+
+func (p *upstreamPool) close() {
+	p.access.Lock()
+	p.closed = true
+	transports := p.transports
+	p.transports = make(map[upstreamKey]*upstreamTransport)
+	p.access.Unlock()
+	for _, transport := range transports {
+		transport.transport.CloseIdleConnections()
+	}
+}
