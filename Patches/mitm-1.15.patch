diff --git a/common/memguard/memguard.go b/common/memguard/memguard.go
new file mode 100644
index 000000000..93828e652
--- /dev/null
+++ b/common/memguard/memguard.go
@@ -0,0 +1,125 @@
+// Package memguard admits memory-hungry work (buffered bodies, scripts, new
+// MITM sessions) only while the process can afford it.
+//
+// On iOS the Network Extension is killed synchronously when its footprint
+// crosses the jetsam limit, and the only kernel warning arrives once at 80%.
+// A single script run can allocate 20 MiB in a few milliseconds, faster than
+// any reactive monitor, so callers must ask before they allocate.
+package memguard
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing/common/memory"
+)
+
+// Reserve is the headroom every admitted operation must leave untouched. It
+// sits above the OOM killer's 5 MiB trigger margin so admitted work never
+// causes a network reset on its own.
+const Reserve uint64 = 8 * 1024 * 1024
+
+var headroomFunc atomic.Pointer[func() (uint64, bool)]
+
+// Operations admitted with Acquire hold their expected allocation here until
+// they finish. The kernel headroom only drops once memory is actually used,
+// so without this, operations that start together would all be admitted
+// against the same headroom.
+var (
+	reservationAccess sync.Mutex
+	reserved          uint64
+	reservationFreed  = make(chan struct{})
+)
+
+// Headroom returns the bytes left before the platform memory limit. It is
+// only known inside an iOS app extension, where os_proc_available_memory()
+// reports limit minus phys_footprint with a single cheap syscall.
+func Headroom() (uint64, bool) {
+	if override := headroomFunc.Load(); override != nil {
+		return (*override)()
+	}
+	if !C.IsIos || !memory.AvailableAvailable() {
+		return 0, false
+	}
+	available := memory.Available()
+	if available == 0 {
+		// 0 means "not a managed process" (or already past the limit).
+		return 0, false
+	}
+	return available, true
+}
+
+// Admit reports whether an operation expected to allocate need bytes may run
+// while keeping Reserve free, counting what running operations reserved.
+// Without a known limit it always admits.
+func Admit(need uint64) bool {
+	return AdmitWithHeadroom(need, Reserve)
+}
+
+// AdmitWithHeadroom is Admit with an explicit minimum instead of Reserve.
+func AdmitWithHeadroom(need uint64, minimum uint64) bool {
+	available, known := Headroom()
+	if !known {
+		return true
+	}
+	return available >= need+minimum+Reserved()
+}
+
+// Reserved returns the bytes held by operations admitted with Acquire.
+func Reserved() uint64 {
+	reservationAccess.Lock()
+	defer reservationAccess.Unlock()
+	return reserved
+}
+
+// Acquire admits an operation expected to allocate need bytes and holds that
+// amount against every later admission until release is called. While other
+// operations hold reservations it waits for them to finish instead of
+// failing, until ctx is done; it fails at once when even the whole headroom
+// would not be enough. Without a known limit it always admits.
+func Acquire(ctx context.Context, need uint64) (release func(), ok bool) {
+	for {
+		available, known := Headroom()
+		if !known {
+			return func() {}, true
+		}
+		reservationAccess.Lock()
+		if available >= need+Reserve+reserved {
+			reserved += need
+			reservationAccess.Unlock()
+			var once sync.Once
+			return func() {
+				once.Do(func() {
+					reservationAccess.Lock()
+					reserved -= need
+					close(reservationFreed)
+					reservationFreed = make(chan struct{})
+					reservationAccess.Unlock()
+				})
+			}, true
+		}
+		if reserved == 0 {
+			reservationAccess.Unlock()
+			return nil, false
+		}
+		freed := reservationFreed
+		reservationAccess.Unlock()
+		select {
+		case <-freed:
+		case <-ctx.Done():
+			return nil, false
+		}
+	}
+}
+
+// SetHeadroomFunc overrides the headroom source; nil restores the platform
+// source. Intended for tests.
+func SetHeadroomFunc(fn func() (uint64, bool)) {
+	if fn == nil {
+		headroomFunc.Store(nil)
+		return
+	}
+	headroomFunc.Store(&fn)
+}
diff --git a/common/memguard/memguard_test.go b/common/memguard/memguard_test.go
new file mode 100644
index 000000000..e690d44f2
--- /dev/null
+++ b/common/memguard/memguard_test.go
@@ -0,0 +1,92 @@
+package memguard
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestAdmitKeepsReserve(t *testing.T) {
+	SetHeadroomFunc(func() (uint64, bool) { return 20 * 1024 * 1024, true })
+	defer SetHeadroomFunc(nil)
+	if !Admit(12 * 1024 * 1024) {
+		t.Fatal("12 MiB with 20 MiB headroom leaves the 8 MiB reserve")
+	}
+	if Admit(12*1024*1024 + 1) {
+		t.Fatal("admitted work that eats into the reserve")
+	}
+	if !AdmitWithHeadroom(0, 20*1024*1024) || AdmitWithHeadroom(1, 20*1024*1024) {
+		t.Fatal("explicit minimum not applied")
+	}
+	SetHeadroomFunc(func() (uint64, bool) { return 0, false })
+	if !Admit(1 << 40) {
+		t.Fatal("unknown headroom must admit")
+	}
+}
+
+func TestAcquireHoldsReservations(t *testing.T) {
+	const mib = 1024 * 1024
+	SetHeadroomFunc(func() (uint64, bool) { return 30 * mib, true })
+	defer SetHeadroomFunc(nil)
+	ctx := context.Background()
+	first, ok := Acquire(ctx, 10*mib)
+	if !ok {
+		t.Fatal("first operation refused")
+	}
+	second, ok := Acquire(ctx, 10*mib)
+	if !ok {
+		t.Fatal("second operation fits beside the first")
+	}
+	if Admit(4 * mib) {
+		t.Fatal("Admit ignored the reservations")
+	}
+	// A third does not fit while both run: it waits for one to finish.
+	admitted := make(chan func(), 1)
+	go func() {
+		release, ok := Acquire(ctx, 10*mib)
+		if ok {
+			admitted <- release
+		} else {
+			admitted <- nil
+		}
+	}()
+	select {
+	case <-admitted:
+		t.Fatal("third operation admitted against reserved memory")
+	case <-time.After(50 * time.Millisecond):
+	}
+	first()
+	first() // releasing twice must not free the reservation twice
+	select {
+	case release := <-admitted:
+		if release == nil {
+			t.Fatal("third operation refused after memory was freed")
+		}
+		release()
+	case <-time.After(time.Second):
+		t.Fatal("third operation not woken")
+	}
+	second()
+	if Reserved() != 0 {
+		t.Fatalf("%d bytes still reserved", Reserved())
+	}
+}
+
+func TestAcquireFailsFastWithoutHeadroom(t *testing.T) {
+	const mib = 1024 * 1024
+	SetHeadroomFunc(func() (uint64, bool) { return 15 * mib, true })
+	defer SetHeadroomFunc(nil)
+	if _, ok := Acquire(context.Background(), 10*mib); ok {
+		t.Fatal("admitted an operation that does not fit even alone")
+	}
+	release, ok := Acquire(context.Background(), 5*mib)
+	if !ok {
+		t.Fatal("small operation refused")
+	}
+	defer release()
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+	if _, ok := Acquire(ctx, 5*mib); ok {
+		t.Fatal("waiting operation admitted past its deadline")
+	}
+}
