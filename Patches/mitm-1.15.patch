diff --git a/script/modules/surge/http.go b/script/modules/surge/http.go
new file mode 100644
index 000000000..e46a7e2ef
--- /dev/null
+++ b/script/modules/surge/http.go
@@ -0,0 +1,167 @@
+package surge
+
+import (
+	"encoding/json"
+	"net/http"
+	"time"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/script/jsc"
+	"github.com/sagernet/sing-box/script/modules/boxctx"
+	E "github.com/sagernet/sing/common/exceptions"
+	F "github.com/sagernet/sing/common/format"
+
+	"github.com/dop251/goja"
+)
+
+type HTTP struct {
+	class  jsc.Class[*Module, *HTTP]
+	client *HTTPClient
+}
+
+// ScriptDataLimit bounds data a script can pull into the JavaScript engine in
+// one piece ($httpClient responses, $utils.ungzip output). Inside the iOS
+// Network Extension a JavaScript engine multiplies it many times over.
+func ScriptDataLimit() int64 {
+	if C.IsIos {
+		return 2 * 1024 * 1024
+	}
+	return 4 * 1024 * 1024
+}
+
+func createHTTP(module *Module) jsc.Class[*Module, *HTTP] {
+	class := jsc.NewClass[*Module, *HTTP](module)
+	class.DefineConstructor(newHTTP)
+	class.DefineMethod("get", httpRequest(http.MethodGet))
+	class.DefineMethod("post", httpRequest(http.MethodPost))
+	class.DefineMethod("put", httpRequest(http.MethodPut))
+	class.DefineMethod("delete", httpRequest(http.MethodDelete))
+	class.DefineMethod("head", httpRequest(http.MethodHead))
+	class.DefineMethod("options", httpRequest(http.MethodOptions))
+	class.DefineMethod("patch", httpRequest(http.MethodPatch))
+	class.DefineMethod("trace", httpRequest(http.MethodTrace))
+	class.DefineMethod("toString", (*HTTP).toString)
+	return class
+}
+
+func newHTTP(class jsc.Class[*Module, *HTTP], call goja.ConstructorCall) *HTTP {
+	boxContext := boxctx.MustFromRuntime(class.Runtime())
+	return &HTTP{
+		class:  class,
+		client: NewHTTPClient(boxContext.Context, boxContext.Logger),
+	}
+}
+
+func httpRequest(method string) func(s *HTTP, call goja.FunctionCall) any {
+	return func(s *HTTP, call goja.FunctionCall) any {
+		if len(call.Arguments) != 2 {
+			panic(s.class.Runtime().NewTypeError("invalid arguments"))
+		}
+		context := boxctx.MustFromRuntime(s.class.Runtime())
+		options := HTTPRequestOptions{
+			Method:       method,
+			Headers:      make(http.Header),
+			Timeout:      5 * time.Second,
+			AutoCookie:   true,
+			AutoRedirect: true,
+		}
+		var (
+			fullHeaderMode bool
+			binaryMode     bool
+		)
+		switch optionsValue := call.Argument(0).(type) {
+		case goja.String:
+			options.URL = optionsValue.String()
+		case *goja.Object:
+			options.URL = jsc.AssertString(s.class.Runtime(), optionsValue.Get("url"), "options.url", false)
+			options.Headers = jsc.AssertHTTPHeader(s.class.Runtime(), optionsValue.Get("headers"), "option.headers")
+			if options.Headers == nil {
+				options.Headers = make(http.Header)
+			}
+			bodyValue := optionsValue.Get("body")
+			if !jsc.IsNil(bodyValue) {
+				switch bodyValue.Export().(type) {
+				case map[string]any, []any:
+					var err error
+					options.Body, err = json.Marshal(bodyValue.Export())
+					if err != nil {
+						panic(s.class.Runtime().NewGoError(err))
+					}
+					if options.Headers.Get("Content-Type") == "" {
+						options.Headers.Set("Content-Type", "application/json")
+					}
+				default:
+					options.Body = jsc.AssertStringBinary(s.class.Runtime(), bodyValue, "options.body", true)
+				}
+			}
+			timeoutInt := jsc.AssertInt(s.class.Runtime(), optionsValue.Get("timeout"), "options.timeout", true)
+			if timeoutInt > 0 {
+				options.Timeout = time.Duration(timeoutInt) * time.Second
+			}
+			options.Insecure = jsc.AssertBool(s.class.Runtime(), optionsValue.Get("insecure"), "options.insecure", true)
+			if value := optionsValue.Get("auto-cookie"); !jsc.IsNil(value) {
+				options.AutoCookie = jsc.AssertBool(s.class.Runtime(), value, "options.auto-cookie", false)
+			}
+			if value := optionsValue.Get("auto-redirect"); !jsc.IsNil(value) {
+				options.AutoRedirect = jsc.AssertBool(s.class.Runtime(), value, "options.auto-redirect", false)
+			}
+			binaryMode = jsc.AssertBool(s.class.Runtime(), optionsValue.Get("binary-mode"), "options.binary-mode", true)
+			fullHeaderMode = jsc.AssertBool(s.class.Runtime(), optionsValue.Get("full-header-mode"), "options.full-header-mode", true)
+		default:
+			panic(s.class.Runtime().NewTypeError(F.ToString("invalid argument: options: expected string or object, but got ", optionsValue)))
+		}
+		callback := jsc.AssertFunction(s.class.Runtime(), call.Argument(1), "callback")
+		if options.Insecure && s.client.manager == nil {
+			panic(s.class.Runtime().NewTypeError("insecure script HTTP requires the sing-box HTTP client manager"))
+		}
+		go func() {
+			result, err := s.client.Do(options)
+			if err != nil {
+				deliverHTTPCallback(context, callback, err.Error(), 0, nil, nil, fullHeaderMode, binaryMode)
+				return
+			}
+			deliverHTTPCallback(context, callback, result.Error, result.StatusCode, result.Headers, result.Body, fullHeaderMode, binaryMode)
+		}()
+		return nil
+	}
+}
+
+func deliverHTTPCallback(context *boxctx.Context, callback goja.Callable, errorMessage string, statusCode int, headers http.Header, content []byte, fullHeaderMode bool, binaryMode bool) {
+	if context.EventLoop == nil {
+		context.ErrorHandler(E.New("script event loop is unavailable"))
+		return
+	}
+	context.EventLoop.RunOnLoop(func(runtime *goja.Runtime) {
+		if errorMessage != "" {
+			_, callbackErr := callback(nil, runtime.ToValue(errorMessage), nil, nil)
+			if callbackErr != nil {
+				context.ErrorHandler(callbackErr)
+			}
+			return
+		}
+		responseObject := runtime.NewObject()
+		responseObject.Set("status", statusCode)
+		responseObject.Set("statusCode", statusCode)
+		if fullHeaderMode {
+			responseObject.Set("headers", jsc.HeadersToArrayValue(runtime, headers))
+		} else {
+			responseObject.Set("headers", jsc.HeadersToValue(runtime, headers))
+		}
+		var bodyValue goja.Value
+		if binaryMode {
+			bodyValue = jsc.NewUint8Array(runtime, content)
+		} else {
+			bodyValue = runtime.ToValue(string(content))
+		}
+		responseObject.Set("body", bodyValue)
+		responseObject.Set("bodyBytes", jsc.NewUint8Array(runtime, content))
+		_, callbackErr := callback(nil, nil, responseObject, bodyValue)
+		if callbackErr != nil {
+			context.ErrorHandler(callbackErr)
+		}
+	})
+}
+
+func (h *HTTP) toString(call goja.FunctionCall) any {
+	return "[sing-box Surge HTTP]"
+}
diff --git a/script/modules/surge/module.go b/script/modules/surge/module.go
new file mode 100644
index 000000000..2dc60fb3d
--- /dev/null
+++ b/script/modules/surge/module.go
@@ -0,0 +1,109 @@
+package surge
+
+import (
+	"strings"
+
+	"github.com/sagernet/sing-box/script/jsc"
+	"github.com/sagernet/sing-box/script/modules/require"
+	"github.com/sagernet/sing/common"
+
+	"github.com/dop251/goja"
+)
+
+const ModuleName = "surge"
+
+type Module struct {
+	runtime              *goja.Runtime
+	classScript          jsc.Class[*Module, *Script]
+	classEnvironment     jsc.Class[*Module, *Environment]
+	classPersistentStore jsc.Class[*Module, *PersistentStore]
+	classHTTP            jsc.Class[*Module, *HTTP]
+	classUtils           jsc.Class[*Module, *Utils]
+	classNotification    jsc.Class[*Module, *Notification]
+}
+
+func Require(runtime *goja.Runtime, module *goja.Object) {
+	m := &Module{
+		runtime: runtime,
+	}
+	m.classScript = createScript(m)
+	m.classEnvironment = createEnvironment(m)
+	m.classPersistentStore = createPersistentStore(m)
+	m.classHTTP = createHTTP(m)
+	m.classUtils = createUtils(m)
+	m.classNotification = createNotification(m)
+	exports := module.Get("exports").(*goja.Object)
+	exports.Set("Script", m.classScript.ToValue())
+	exports.Set("Environment", m.classEnvironment.ToValue())
+	exports.Set("PersistentStore", m.classPersistentStore.ToValue())
+	exports.Set("HTTP", m.classHTTP.ToValue())
+	exports.Set("Utils", m.classUtils.ToValue())
+	exports.Set("Notification", m.classNotification.ToValue())
+}
+
+func Enable(runtime *goja.Runtime, scriptType string, args []string, binaryBodyMode bool, cronExpression string) {
+	exports := require.Require(runtime, ModuleName).ToObject(runtime)
+	classScript := jsc.GetClass[*Module, *Script](runtime, exports, "Script")
+	classEnvironment := jsc.GetClass[*Module, *Environment](runtime, exports, "Environment")
+	classPersistentStore := jsc.GetClass[*Module, *PersistentStore](runtime, exports, "PersistentStore")
+	classHTTP := jsc.GetClass[*Module, *HTTP](runtime, exports, "HTTP")
+	classUtils := jsc.GetClass[*Module, *Utils](runtime, exports, "Utils")
+	classNotification := jsc.GetClass[*Module, *Notification](runtime, exports, "Notification")
+	runtime.Set("$script", classScript.New(&Script{class: classScript, ScriptType: scriptType, BinaryBodyMode: binaryBodyMode}))
+	runtime.Set("$environment", classEnvironment.New(&Environment{class: classEnvironment}))
+	persistentStore := newPersistentStore(classPersistentStore)
+	runtime.Set("$persistentStore", persistentStore)
+	nativeHTTPClient := classHTTP.New(newHTTP(classHTTP, goja.ConstructorCall{}))
+	httpClient := runtime.NewObject()
+	for _, method := range []string{"get", "post", "put", "delete", "head", "options", "patch", "trace"} {
+		nativeMethod, callable := goja.AssertFunction(nativeHTTPClient.Get(method))
+		if !callable {
+			continue
+		}
+		httpClient.Set(method, func(call goja.FunctionCall) goja.Value {
+			result, err := nativeMethod(nativeHTTPClient, call.Arguments...)
+			if err != nil {
+				panic(err)
+			}
+			return result
+		})
+	}
+	runtime.Set("$http", httpClient)
+	runtime.Set("$httpClient", httpClient)
+	runtime.Set("$httpAPI", func(call goja.FunctionCall) goja.Value {
+		if len(call.Arguments) < 4 {
+			panic(runtime.NewTypeError("$httpAPI requires method, path, body and callback"))
+		}
+		callback := jsc.AssertFunction(runtime, call.Argument(3), "$httpAPI callback")
+		result := runtime.NewObject()
+		result.Set("success", false)
+		result.Set("error", "Surge HTTP API is not supported by sing-box")
+		if _, err := callback(nil, result); err != nil {
+			panic(err)
+		}
+		return goja.Undefined()
+	})
+	runtime.Set("$utils", classUtils.New(&Utils{class: classUtils}))
+	runtime.Set("$notification", newNotification(classNotification))
+	argumentValues := common.Map(args, func(it string) any {
+		return it
+	})
+	runtime.Set("$argument", strings.Join(args, "&"))
+	runtime.Set("$arguments", runtime.NewArray(argumentValues...))
+	network := runtime.NewObject()
+	wifi := runtime.NewObject()
+	wifi.Set("ssid", goja.Null())
+	wifi.Set("bssid", goja.Null())
+	network.Set("wifi", wifi)
+	network.Set("dns", runtime.NewArray())
+	network.Set("v4", runtime.NewObject())
+	network.Set("v6", runtime.NewObject())
+	runtime.Set("$network", network)
+	if scriptType == "cron" && cronExpression != "" {
+		runtime.Set("$cronexp", cronExpression)
+	}
+}
+
+func (m *Module) Runtime() *goja.Runtime {
+	return m.runtime
+}
diff --git a/script/modules/surge/native.go b/script/modules/surge/native.go
new file mode 100644
index 000000000..94be881cf
--- /dev/null
+++ b/script/modules/surge/native.go
@@ -0,0 +1,315 @@
+package surge
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"io"
+	"net/http"
+	"net/http/cookiejar"
+	"runtime"
+	"strings"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/memguard"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/experimental/locale"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common"
+	E "github.com/sagernet/sing/common/exceptions"
+	F "github.com/sagernet/sing/common/format"
+	"github.com/sagernet/sing/common/logger"
+	"github.com/sagernet/sing/service"
+
+	"golang.org/x/net/publicsuffix"
+)
+
+// The functions in this file implement the Surge script API independently of
+// the JavaScript engine, so the goja bindings and platform engines (a WebKit
+// content process on iOS) share one behavior.
+
+// HTTPRequestOptions is one $httpClient call.
+type HTTPRequestOptions struct {
+	Method       string
+	URL          string
+	Headers      http.Header
+	Body         []byte
+	Timeout      time.Duration
+	Insecure     bool
+	AutoCookie   bool
+	AutoRedirect bool
+}
+
+// HTTPResult is a $httpClient response. Error is set instead of the other
+// fields when the request failed; it is passed to the script callback as is.
+type HTTPResult struct {
+	Error      string
+	StatusCode int
+	Headers    http.Header
+	Body       []byte
+}
+
+// HTTPClient carries the state of $httpClient for one script run: its cookie
+// jar and transports.
+type HTTPClient struct {
+	ctx       context.Context
+	logger    logger.ContextLogger
+	cookieJar *cookiejar.Jar
+	transport http.RoundTripper
+	manager   adapter.HTTPClientManager
+}
+
+func NewHTTPClient(ctx context.Context, logger logger.ContextLogger) *HTTPClient {
+	var transport http.RoundTripper = http.DefaultTransport
+	manager := service.FromContext[adapter.HTTPClientManager](ctx)
+	if manager != nil {
+		if defaultTransport := manager.DefaultTransport(); defaultTransport != nil {
+			transport = defaultTransport
+		}
+	}
+	return &HTTPClient{
+		ctx:    ctx,
+		logger: logger,
+		cookieJar: common.Must1(cookiejar.New(&cookiejar.Options{
+			PublicSuffixList: publicsuffix.List,
+		})),
+		transport: transport,
+		manager:   manager,
+	}
+}
+
+// Do performs the request. Only setup errors are returned; transport and
+// read failures are reported in HTTPResult.Error like the Surge callback does.
+func (c *HTTPClient) Do(options HTTPRequestOptions) (*HTTPResult, error) {
+	requestTransport := c.transport
+	if options.Insecure {
+		if c.manager == nil {
+			return nil, E.New("insecure script HTTP requires the sing-box HTTP client manager")
+		}
+		insecureTransport, err := c.manager.ResolveTransport(
+			c.ctx,
+			c.logger,
+			option.HTTPClientOptions{
+				OutboundTLSOptionsContainer: option.OutboundTLSOptionsContainer{
+					TLS: &option.OutboundTLSOptions{Insecure: true},
+				},
+				DefaultOutbound: true,
+			},
+		)
+		if err != nil {
+			return nil, err
+		}
+		requestTransport = insecureTransport
+		defer insecureTransport.CloseIdleConnections()
+	}
+	timeout := options.Timeout
+	if timeout <= 0 {
+		timeout = 5 * time.Second
+	}
+	autoRedirect := options.AutoRedirect
+	httpClient := &http.Client{
+		Timeout:   timeout,
+		Transport: requestTransport,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			if autoRedirect {
+				return nil
+			}
+			return http.ErrUseLastResponse
+		},
+	}
+	if options.AutoCookie {
+		httpClient.Jar = c.cookieJar
+	}
+	request, err := http.NewRequestWithContext(c.ctx, options.Method, options.URL, bytes.NewReader(options.Body))
+	if err != nil {
+		return nil, err
+	}
+	headers := options.Headers
+	if headers == nil {
+		headers = make(http.Header)
+	}
+	if host := headers.Get("Host"); host != "" {
+		request.Host = host
+		headers.Del("Host")
+	}
+	request.Header = headers
+	response, err := httpClient.Do(request)
+	if err != nil {
+		return &HTTPResult{Error: err.Error()}, nil
+	}
+	defer response.Body.Close()
+	limit := ScriptDataLimit()
+	if !memguard.Admit(scriptResponseCost(response.ContentLength, limit)) {
+		return &HTTPResult{Error: "insufficient memory headroom for the response body"}, nil
+	}
+	content, err := io.ReadAll(io.LimitReader(response.Body, limit+1))
+	if err != nil {
+		return &HTTPResult{Error: err.Error()}, nil
+	}
+	if int64(len(content)) > limit {
+		return &HTTPResult{Error: F.ToString("response body exceeds ", limit, " bytes")}, nil
+	}
+	return &HTTPResult{StatusCode: response.StatusCode, Headers: response.Header, Body: content}, nil
+}
+
+// scriptResponseCost estimates what a response body costs until the script
+// sees it: the read buffer, then the copies handed to the JavaScript engine.
+// Without a Content-Length it assumes a typical API response; the reserve
+// covers the rest up to limit.
+func scriptResponseCost(contentLength int64, limit int64) uint64 {
+	if contentLength < 0 {
+		contentLength = min(limit, 1024*1024)
+	}
+	return uint64(min(contentLength, limit)) * 4
+}
+
+// PersistentStoreRead implements $persistentStore.read; an empty key means
+// the script's own tag.
+func PersistentStoreRead(ctx context.Context, tag string, key string) (string, bool) {
+	if key == "" {
+		key = tag
+	}
+	var value string
+	if cacheFile := service.FromContext[adapter.CacheFile](ctx); cacheFile != nil {
+		value = cacheFile.SurgePersistentStoreRead(key)
+	} else {
+		inMemoryCache := persistentInMemoryCache(ctx)
+		inMemoryCache.RLock()
+		value = inMemoryCache.Data[key]
+		inMemoryCache.RUnlock()
+	}
+	return value, value != ""
+}
+
+// PersistentStoreWrite implements $persistentStore.write.
+func PersistentStoreWrite(ctx context.Context, tag string, key string, value string) error {
+	if key == "" {
+		key = tag
+	}
+	if cacheFile := service.FromContext[adapter.CacheFile](ctx); cacheFile != nil {
+		return cacheFile.SurgePersistentStoreWrite(key, value)
+	}
+	inMemoryCache := persistentInMemoryCache(ctx)
+	inMemoryCache.Lock()
+	inMemoryCache.Data[key] = value
+	inMemoryCache.Unlock()
+	return nil
+}
+
+// fallbackInMemoryCache backs $persistentStore when the context has neither a
+// cache file nor a script manager, so writes survive across calls.
+var fallbackInMemoryCache = &adapter.SurgeInMemoryCache{Data: make(map[string]string)}
+
+func persistentInMemoryCache(ctx context.Context) *adapter.SurgeInMemoryCache {
+	if manager := service.FromContext[adapter.ScriptManager](ctx); manager != nil {
+		return manager.SurgeCache()
+	}
+	return fallbackInMemoryCache
+}
+
+// NotificationRequest is one $notification.post call.
+type NotificationRequest struct {
+	Title       string
+	Subtitle    string
+	Body        string
+	OpenURL     string
+	Clipboard   string
+	MediaURL    string
+	MediaData   []byte
+	MediaType   string
+	AutoDismiss int
+}
+
+// PostNotification logs the notification and forwards it to the platform.
+func PostNotification(ctx context.Context, logger logger.ContextLogger, tag string, request NotificationRequest) {
+	title, subtitle, body := request.Title, request.Subtitle, request.Body
+	if title != "" && subtitle == "" && body == "" {
+		body = title
+		title = ""
+	} else if title != "" && subtitle != "" && body == "" {
+		body = subtitle
+		subtitle = ""
+	}
+	var builder strings.Builder
+	if title != "" {
+		builder.WriteString("[")
+		builder.WriteString(title)
+		if subtitle != "" {
+			builder.WriteString(" - ")
+			builder.WriteString(subtitle)
+		}
+		builder.WriteString("]: ")
+	}
+	builder.WriteString(body)
+	logger.Info("notification: " + builder.String())
+	platformInterface := service.FromContext[adapter.PlatformInterface](ctx)
+	if platformInterface == nil {
+		return
+	}
+	err := platformInterface.SendNotification(&adapter.Notification{
+		Identifier: "surge-script-notification-" + tag,
+		TypeName:   "Surge Script Notification (" + tag + ")",
+		TypeID:     11,
+		Title:      title,
+		Subtitle:   subtitle,
+		Body:       body,
+		OpenURL:    request.OpenURL,
+		Clipboard:  request.Clipboard,
+		MediaURL:   request.MediaURL,
+		MediaData:  request.MediaData,
+		MediaType:  request.MediaType,
+		Timeout:    request.AutoDismiss,
+	})
+	if err != nil {
+		logger.Error(E.Cause(err, "send notification"))
+	}
+}
+
+// Ungzip implements $utils.ungzip with an output limit.
+func Ungzip(data []byte) ([]byte, error) {
+	reader, err := gzip.NewReader(bytes.NewReader(data))
+	if err != nil {
+		return nil, err
+	}
+	defer reader.Close()
+	limit := ScriptDataLimit()
+	decoded, err := io.ReadAll(io.LimitReader(reader, limit+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(decoded)) > limit {
+		return nil, E.New("ungzip: decompressed data exceeds ", limit, " bytes")
+	}
+	return decoded, nil
+}
+
+// EnvironmentValues returns the fields of $environment.
+func EnvironmentValues() map[string]string {
+	return map[string]string{
+		"system":        environmentSystem(),
+		"surge-build":   "N/A",
+		"surge-version": "sing-box " + C.Version,
+		"language":      locale.Current().Locale,
+		"device-model":  "N/A",
+	}
+}
+
+func environmentSystem() string {
+	switch runtime.GOOS {
+	case "ios":
+		return "iOS"
+	case "darwin":
+		return "macOS"
+	case "tvos":
+		return "tvOS"
+	case "linux":
+		return "Linux"
+	case "android":
+		return "Android"
+	case "windows":
+		return "Windows"
+	default:
+		return runtime.GOOS
+	}
+}
diff --git a/script/modules/surge/native_test.go b/script/modules/surge/native_test.go
new file mode 100644
index 000000000..28b90baca
--- /dev/null
+++ b/script/modules/surge/native_test.go
@@ -0,0 +1,40 @@
+package surge
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/common/memguard"
+	"github.com/sagernet/sing-box/log"
+)
+
+func TestHTTPClientRefusesResponseWithoutHeadroom(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		_, _ = writer.Write([]byte(strings.Repeat("a", 64*1024)))
+	}))
+	defer server.Close()
+	client := NewHTTPClient(context.Background(), log.NewNOPFactory().NewLogger("test"))
+	options := HTTPRequestOptions{Method: http.MethodGet, URL: server.URL, AutoRedirect: true}
+
+	memguard.SetHeadroomFunc(func() (uint64, bool) { return memguard.Reserve + 64*1024, true })
+	defer memguard.SetHeadroomFunc(nil)
+	result, err := client.Do(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(result.Error, "insufficient memory headroom") || result.Body != nil {
+		t.Fatalf("response read without headroom: %+v", result)
+	}
+
+	memguard.SetHeadroomFunc(func() (uint64, bool) { return 64 * 1024 * 1024, true })
+	result, err = client.Do(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Error != "" || len(result.Body) != 64*1024 {
+		t.Fatalf("response refused with enough headroom: error=%q length=%d", result.Error, len(result.Body))
+	}
+}
