new file mode 100644
index 000000000..35ac6002f
--- /dev/null
+++ b/mitm/budget.go
@@ -0,0 +1,67 @@
+package mitm
+
+import (
+	"context"
+	"time"
+
+	"golang.org/x/sync/semaphore"
+)
+
+// bodyBufferHold is the share of the engine's body budget one request holds.
+// Every byte a buffered body keeps referenced (wire copy, decoded layers,
+// rewritten copies) is charged here before it is allocated, so the budget is
+// a real bound on body memory rather than a per-request estimate.
+//
+// A nil hold, or one without a budget, admits everything; package-level
+// helpers use that for unbudgeted callers and tests.
+type bodyBufferHold struct {
+	budget  *semaphore.Weighted
+	claimed int64
+}
+
+// acquire blocks up to wait for n bytes of budget.
+func (h *bodyBufferHold) acquire(ctx context.Context, n int64, wait time.Duration) bool {
+	if h == nil || h.budget == nil || n <= 0 {
+		return true
+	}
+	acquireCtx, cancel := context.WithTimeout(ctx, wait)
+	defer cancel()
+	if h.budget.Acquire(acquireCtx, n) != nil {
+		return false
+	}
+	h.claimed += n
+	return true
+}
+
+// tryGrow charges n more bytes without waiting.
+func (h *bodyBufferHold) tryGrow(n int64) bool {
+	if h == nil || h.budget == nil || n <= 0 {
+		return true
+	}
+	if !h.budget.TryAcquire(n) {
+		return false
+	}
+	h.claimed += n
+	return true
+}
+
+// releasePart returns the charge of a buffer that is no longer referenced.
+func (h *bodyBufferHold) releasePart(n int64) {
+	if h == nil || h.budget == nil || n <= 0 {
+		return
+	}
+	n = min(n, h.claimed)
+	if n == 0 {
+		return
+	}
+	h.budget.Release(n)
+	h.claimed -= n
+}
+
+func (h *bodyBufferHold) releaseAll() {
+	if h == nil || h.budget == nil || h.claimed == 0 {
+		return
+	}
+	h.budget.Release(h.claimed)
+	h.claimed = 0
+}
diff --git a/mitm/budget_test.go b/mitm/budget_test.go
new file mode 100644
index 000000000..299f6585a
--- /dev/null
+++ b/mitm/budget_test.go
@@ -0,0 +1,169 @@
+package mitm
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"io"
+	"net/http"
+	"regexp"
+	"testing"
+
+	"github.com/sagernet/sing-box/common/memguard"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+
+	"golang.org/x/sync/semaphore"
+)
+
+func testEngine(budget int64) *Engine {
+	limits := platformLimits()
+	limits.bodyBudget = budget
+	limits.maxBody = 32 * 1024 * 1024
+	return &Engine{
+		logger:     log.NewNOPFactory().NewLogger("mitm"),
+		limits:     limits,
+		bodyBuffer: semaphore.NewWeighted(budget),
+	}
+}
+
+func gzipBytes(t *testing.T, content []byte) []byte {
+	t.Helper()
+	var compressed bytes.Buffer
+	writer := gzip.NewWriter(&compressed)
+	_, _ = writer.Write(content)
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return compressed.Bytes()
+}
+
+func gzipHeaders() http.Header {
+	headers := make(http.Header)
+	headers.Set("Content-Encoding", "gzip")
+	return headers
+}
+
+func TestBufferBodyChargesDecodedAndReleasesWire(t *testing.T) {
+	plain := bytes.Repeat([]byte("sing-box "), 8*1024)
+	wire := gzipBytes(t, plain)
+	engine := testEngine(1024 * 1024)
+	hold := bodyBufferHold{budget: engine.bodyBuffer}
+	content, replay, available, decoded, denied, err := engine.bufferBody(context.Background(), &hold, io.NopCloser(bytes.NewReader(wire)), int64(len(wire)), gzipHeaders(), 1024*1024)
+	if err != nil || denied || !available || !decoded {
+		t.Fatalf("err=%v denied=%v available=%v decoded=%v", err, denied, available, decoded)
+	}
+	_ = replay.Close()
+	if !bytes.Equal(content, plain) {
+		t.Fatal("decoded body mismatch")
+	}
+	// Only the decoded copy may stay charged once the wire copy is dropped.
+	if hold.claimed > int64(cap(content)) || hold.claimed < int64(len(content)) {
+		t.Fatalf("claimed %d bytes for a %d byte (cap %d) decoded body", hold.claimed, len(content), cap(content))
+	}
+	engine.releaseBodyBuffer(&hold)
+	if hold.claimed != 0 || !engine.bodyBuffer.TryAcquire(1024*1024) {
+		t.Fatal("budget not fully returned")
+	}
+}
+
+func TestBufferBodyExhaustedWhileDecodingFailsOpen(t *testing.T) {
+	plain := bytes.Repeat([]byte("0123456789abcdef"), 16*1024)
+	wire := gzipBytes(t, plain)
+	// Enough for the wire copy and the first decode chunk, not the full decode.
+	engine := testEngine(int64(len(wire)) + bodyReadChunk + 1024)
+	hold := bodyBufferHold{budget: engine.bodyBuffer}
+	content, replay, available, _, denied, err := engine.bufferBody(context.Background(), &hold, io.NopCloser(bytes.NewReader(wire)), int64(len(wire)), gzipHeaders(), 1024*1024)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if available || !denied || content != nil {
+		t.Fatalf("decode past the budget must fail open: available=%v denied=%v", available, denied)
+	}
+	forwarded, err := io.ReadAll(replay)
+	if err != nil || !bytes.Equal(forwarded, wire) {
+		t.Fatalf("fail-open must forward the original wire body: err=%v len=%d", err, len(forwarded))
+	}
+	engine.releaseBodyBuffer(&hold)
+}
+
+func TestBufferBodyChunkedGrowthExhaustedReplaysEverything(t *testing.T) {
+	payload := bytes.Repeat([]byte("x"), 100*1024)
+	engine := testEngine(40 * 1024)
+	hold := bodyBufferHold{budget: engine.bodyBuffer}
+	_, replay, available, _, denied, err := engine.bufferBody(context.Background(), &hold, io.NopCloser(bytes.NewReader(payload)), -1, nil, 1024*1024)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if available || !denied {
+		t.Fatalf("growth past the budget must fail open: available=%v denied=%v", available, denied)
+	}
+	forwarded, err := io.ReadAll(replay)
+	if err != nil || !bytes.Equal(forwarded, payload) {
+		t.Fatalf("replay lost bytes: err=%v len=%d", err, len(forwarded))
+	}
+	if hold.claimed > 40*1024 {
+		t.Fatalf("claimed %d bytes beyond the budget", hold.claimed)
+	}
+	engine.releaseBodyBuffer(&hold)
+}
+
+func TestBufferBodyRespectsPlatformMaxBody(t *testing.T) {
+	engine := testEngine(1024 * 1024)
+	engine.limits.maxBody = 1024
+	payload := bytes.Repeat([]byte("y"), 2048)
+	hold := bodyBufferHold{budget: engine.bodyBuffer}
+	_, replay, available, _, denied, err := engine.bufferBody(context.Background(), &hold, io.NopCloser(bytes.NewReader(payload)), int64(len(payload)), nil, 32*1024*1024)
+	if err != nil || available || denied {
+		t.Fatalf("body above maxBody must pass through: err=%v available=%v denied=%v", err, available, denied)
+	}
+	forwarded, _ := io.ReadAll(replay)
+	if !bytes.Equal(forwarded, payload) {
+		t.Fatal("pass-through body changed")
+	}
+	if hold.claimed != 0 {
+		t.Fatalf("pass-through charged %d bytes", hold.claimed)
+	}
+}
+
+func TestBufferBodyDeniedWithoutHeadroom(t *testing.T) {
+	memguard.SetHeadroomFunc(func() (uint64, bool) { return 4 * 1024 * 1024, true })
+	defer memguard.SetHeadroomFunc(nil)
+	engine := testEngine(1024 * 1024)
+	payload := bytes.Repeat([]byte("z"), 4096)
+	hold := bodyBufferHold{budget: engine.bodyBuffer}
+	_, replay, available, _, denied, err := engine.bufferBody(context.Background(), &hold, io.NopCloser(bytes.NewReader(payload)), int64(len(payload)), nil, 1024*1024)
+	if err != nil || available || !denied {
+		t.Fatalf("low headroom must deny: err=%v available=%v denied=%v", err, available, denied)
+	}
+	forwarded, _ := io.ReadAll(replay)
+	if !bytes.Equal(forwarded, payload) {
+		t.Fatal("denied body changed")
+	}
+}
+
+func TestRewriteBodyChargesItsCopy(t *testing.T) {
+	body := bytes.Repeat([]byte("ad "), 1024)
+	rule := &option.SurgeBodyRewriteLine{
+		Match:   []*regexp.Regexp{regexp.MustCompile("ad")},
+		Replace: []string{"ok"},
+	}
+	engine := testEngine(1024)
+	hold := bodyBufferHold{budget: engine.bodyBuffer}
+	if rewritten, applied := engine.rewriteBody(context.Background(), &hold, body, rule, 1024*1024, "response"); applied || !bytes.Equal(rewritten, body) {
+		t.Fatal("rewrite without budget for its copy must be skipped")
+	}
+	engine = testEngine(1024 * 1024)
+	hold = bodyBufferHold{budget: engine.bodyBuffer}
+	if !hold.tryGrow(int64(cap(body))) {
+		t.Fatal("charge body")
+	}
+	rewritten, applied := engine.rewriteBody(context.Background(), &hold, body, rule, 1024*1024, "response")
+	if !applied || !bytes.Equal(rewritten, bytes.Repeat([]byte("ok "), 1024)) {
+		t.Fatalf("rewrite failed: applied=%v", applied)
+	}
+	if hold.claimed < int64(len(rewritten)) || hold.claimed > int64(cap(rewritten))+4096 {
+		t.Fatalf("claimed %d bytes for a %d byte rewritten body", hold.claimed, len(rewritten))
+	}
+	engine.releaseBodyBuffer(&hold)
+}
