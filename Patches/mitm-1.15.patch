+//go:build with_script
+
+package script
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+)
+
+func NewScript(ctx context.Context, logger logger.ContextLogger, options option.Script) (adapter.Script, error) {
+	switch options.Type {
+	case C.ScriptTypeSurge:
+		return NewSurgeScript(ctx, logger, options)
+	default:
+		return nil, E.New("unknown script type: ", options.Type)
+	}
+}
diff --git a/script/script_surge.go b/script/script_surge.go
new file mode 100644
index 000000000..1fc6555c3
--- /dev/null
+++ b/script/script_surge.go
@@ -0,0 +1,475 @@
+//go:build with_script
+
+package script
+
+import (
+	"context"
+	"net/http"
+	"sync"
+	"time"
+	"unsafe"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/script/jsc"
+	"github.com/sagernet/sing-box/script/modules/surge"
+	"github.com/sagernet/sing/common"
+	E "github.com/sagernet/sing/common/exceptions"
+	F "github.com/sagernet/sing/common/format"
+	"github.com/sagernet/sing/common/logger"
+
+	"github.com/adhocore/gronx"
+	"github.com/dop251/goja"
+)
+
+const defaultSurgeScriptTimeout = 10 * time.Second
+
+var surgeScriptSlots = make(chan struct{}, surgeScriptConcurrency())
+
+var _ adapter.SurgeScript = (*SurgeScript)(nil)
+
+func setSurgeDoneAliases(runtime *goja.Runtime, done func(goja.FunctionCall) goja.Value) {
+	doneValue := runtime.ToValue(done)
+	runtime.Set("done", doneValue)
+	runtime.Set("$done", doneValue)
+}
+
+func setSurgeRequestAliases(runtime *goja.Runtime, request *goja.Object) {
+	runtime.Set("request", request)
+	runtime.Set("$request", request)
+}
+
+func setSurgeResponseAliases(runtime *goja.Runtime, response *goja.Object) {
+	runtime.Set("response", response)
+	runtime.Set("$response", response)
+}
+
+func surgeRequestHeaders(request *http.Request) http.Header {
+	headers := request.Header.Clone()
+	if request.Host != "" {
+		headers.Set("Host", request.Host)
+	}
+	return headers
+}
+
+func surgeResultBody(runtime *goja.Runtime, object *goja.Object) []byte {
+	if body := object.Get("body"); !jsc.IsNil(body) {
+		return jsc.AssertStringBinary(runtime, body, "body", true)
+	}
+	return jsc.AssertStringBinary(runtime, object.Get("bodyBytes"), "bodyBytes", true)
+}
+
+type SurgeScript struct {
+	ctx    context.Context
+	logger logger.ContextLogger
+	tag    string
+	source Source
+
+	cronExpression string
+	cronTimeout    time.Duration
+	cronArguments  []string
+	cronTimer      *time.Timer
+	cronDone       chan struct{}
+}
+
+func acquireSurgeScriptSlot(ctx context.Context) error {
+	select {
+	case surgeScriptSlots <- struct{}{}:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func releaseSurgeScriptSlot() {
+	<-surgeScriptSlots
+}
+
+func NewSurgeScript(ctx context.Context, logger logger.ContextLogger, options option.Script) (adapter.Script, error) {
+	source, err := NewSource(ctx, logger, options)
+	if err != nil {
+		return nil, err
+	}
+	cronOptions := common.PtrValueOrDefault(options.SurgeOptions.CronOptions)
+	if cronOptions.Expression != "" {
+		if !gronx.IsValid(cronOptions.Expression) {
+			return nil, E.New("invalid cron expression: ", cronOptions.Expression)
+		}
+	}
+	return &SurgeScript{
+		ctx:            ctx,
+		logger:         logger,
+		tag:            options.Tag,
+		source:         source,
+		cronExpression: cronOptions.Expression,
+		cronTimeout:    time.Duration(cronOptions.Timeout),
+		cronArguments:  cronOptions.Arguments,
+		cronDone:       make(chan struct{}),
+	}, nil
+}
+
+func (s *SurgeScript) Type() string {
+	return C.ScriptTypeSurge
+}
+
+func (s *SurgeScript) Tag() string {
+	return s.tag
+}
+
+func (s *SurgeScript) StartContext(ctx context.Context, startContext *adapter.HTTPStartContext) error {
+	return s.source.StartContext(ctx, startContext)
+}
+
+func (s *SurgeScript) PostStart() error {
+	err := s.source.PostStart()
+	if err != nil {
+		return err
+	}
+	if s.cronExpression != "" {
+		go s.loopCronEvents()
+	}
+	return nil
+}
+
+func (s *SurgeScript) loopCronEvents() {
+	s.logger.Debug("starting event")
+	err := s.ExecuteGeneric(s.ctx, "cron", s.cronTimeout, s.cronArguments)
+	if err != nil {
+		s.logger.Error(E.Cause(err, "running event"))
+	}
+	nextTick, err := gronx.NextTick(s.cronExpression, false)
+	if err != nil {
+		s.logger.Error(E.Cause(err, "determine next tick"))
+		return
+	}
+	s.cronTimer = time.NewTimer(nextTick.Sub(time.Now()))
+	s.logger.Debug("next event at: ", nextTick.Format(log.DefaultTimeFormat))
+	for {
+		select {
+		case <-s.ctx.Done():
+			return
+		case <-s.cronDone:
+			return
+		case <-s.cronTimer.C:
+			s.logger.Debug("starting event")
+			err = s.ExecuteGeneric(s.ctx, "cron", s.cronTimeout, s.cronArguments)
+			if err != nil {
+				s.logger.Error(E.Cause(err, "running event"))
+			}
+			nextTick, err = gronx.NextTick(s.cronExpression, false)
+			if err != nil {
+				s.logger.Error(E.Cause(err, "determine next tick"))
+				return
+			}
+			s.cronTimer.Reset(nextTick.Sub(time.Now()))
+			s.logger.Debug("configured next event at: ", nextTick)
+		}
+	}
+}
+
+func (s *SurgeScript) Close() error {
+	err := s.source.Close()
+	if s.cronTimer != nil {
+		s.cronTimer.Stop()
+		close(s.cronDone)
+	}
+	return err
+}
+
+func (s *SurgeScript) ExecuteGeneric(ctx context.Context, scriptType string, timeout time.Duration, arguments []string) error {
+	if timeout == 0 {
+		timeout = defaultSurgeScriptTimeout
+	}
+	if engine := s.platformEngineFor(0); engine != nil {
+		if s.executePlatformGeneric(ctx, engine, scriptType, timeout, arguments) {
+			return nil
+		}
+	}
+	ctx, timeoutCancel := context.WithTimeout(ctx, timeout)
+	defer timeoutCancel()
+	if err := acquireSurgeScriptSlot(ctx); err != nil {
+		return err
+	}
+	defer releaseSurgeScriptSlot()
+	releaseMemory, admitted := acquireGojaScript(ctx, 0, s.source.uncompiledLength())
+	if !admitted {
+		return E.New("script skipped: insufficient memory headroom")
+	}
+	defer releaseMemory()
+	program := s.source.Program()
+	if program == nil {
+		return E.New("invalid script")
+	}
+	ctx, cancel := context.WithCancelCause(ctx)
+	defer cancel(nil)
+	runtime, loop := NewRuntime(ctx, cancel)
+	SetModules(runtime, loop, ctx, s.logger, cancel, s.tag)
+	defer loop.Terminate()
+	surge.Enable(runtime, scriptType, arguments, false, s.cronExpression)
+	done := make(chan struct{})
+	doneFunc := common.OnceFunc(func() {
+		close(done)
+	})
+	setSurgeDoneAliases(runtime, func(call goja.FunctionCall) goja.Value {
+		doneFunc()
+		return goja.Undefined()
+	})
+	var (
+		access    sync.Mutex
+		scriptErr error
+	)
+	loop.Start()
+	loop.RunOnLoop(func(runtime *goja.Runtime) {
+		_, err := runtime.RunProgram(program)
+		if err != nil {
+			access.Lock()
+			scriptErr = err
+			access.Unlock()
+			doneFunc()
+		}
+	})
+	select {
+	case <-ctx.Done():
+		runtime.Interrupt(ctx.Err())
+		return ctx.Err()
+	case <-done:
+		access.Lock()
+		defer access.Unlock()
+	}
+	return scriptErr
+}
+
+func (s *SurgeScript) ExecuteHTTPRequest(ctx context.Context, timeout time.Duration, request *http.Request, body []byte, binaryBody bool, fullHeaderMode bool, arguments []string) (*adapter.HTTPRequestScriptResult, error) {
+	if timeout == 0 {
+		timeout = defaultSurgeScriptTimeout
+	}
+	if engine := s.platformEngineFor(len(body)); engine != nil {
+		if result, handled := s.executePlatformHTTPRequest(ctx, engine, timeout, request, body, binaryBody, fullHeaderMode, arguments); handled {
+			return result, nil
+		}
+	}
+	ctx, timeoutCancel := context.WithTimeout(ctx, timeout)
+	defer timeoutCancel()
+	if err := acquireSurgeScriptSlot(ctx); err != nil {
+		s.logger.Error(E.Cause(err, "HTTP request script skipped"))
+		return &adapter.HTTPRequestScriptResult{}, nil
+	}
+	defer releaseSurgeScriptSlot()
+	releaseMemory, admitted := acquireGojaScript(ctx, len(body), s.source.uncompiledLength())
+	if !admitted {
+		s.logger.Warn("HTTP request script skipped: insufficient memory headroom for a ", len(body), " byte body")
+		return &adapter.HTTPRequestScriptResult{}, nil
+	}
+	defer releaseMemory()
+	defer releaseScriptMemory(len(body))
+	program := s.source.Program()
+	if program == nil {
+		s.logger.Warn("HTTP request script skipped because source is unavailable")
+		return &adapter.HTTPRequestScriptResult{}, nil
+	}
+	ctx, cancel := context.WithCancelCause(ctx)
+	defer cancel(nil)
+	runtime, loop := NewRuntime(ctx, cancel)
+	SetModules(runtime, loop, ctx, s.logger, cancel, s.tag)
+	defer loop.Terminate()
+	surge.Enable(runtime, "http-request", arguments, binaryBody, "")
+	runtime.ClearInterrupt()
+	requestObject := runtime.NewObject()
+	requestObject.Set("url", request.URL.String())
+	requestObject.Set("method", request.Method)
+	requestHeaders := surgeRequestHeaders(request)
+	if fullHeaderMode {
+		requestObject.Set("headers", jsc.HeadersToArrayValue(runtime, requestHeaders))
+	} else {
+		requestObject.Set("headers", jsc.HeadersToValue(runtime, requestHeaders))
+	}
+	if len(body) > 0 {
+		if !binaryBody {
+			requestObject.Set("body", string(body))
+		} else {
+			requestObject.Set("body", jsc.NewUint8Array(runtime, body))
+		}
+		requestObject.Set("bodyBytes", jsc.NewUint8Array(runtime, body))
+	}
+	requestObject.Set("id", F.ToString(uintptr(unsafe.Pointer(request))))
+	setSurgeRequestAliases(runtime, requestObject)
+	done := make(chan struct{})
+	doneFunc := common.OnceFunc(func() {
+		close(done)
+	})
+	var (
+		access    sync.Mutex
+		result    adapter.HTTPRequestScriptResult
+		scriptErr error
+	)
+	setSurgeDoneAliases(runtime, func(call goja.FunctionCall) goja.Value {
+		defer doneFunc()
+		resultObject := jsc.AssertObject(runtime, call.Argument(0), "done() argument", true)
+		if resultObject == nil {
+			return goja.Undefined()
+		}
+		access.Lock()
+		defer access.Unlock()
+		result.Abort = jsc.AssertBool(runtime, resultObject.Get("abort"), "abort", true)
+		result.URL = jsc.AssertString(runtime, resultObject.Get("url"), "url", true)
+		result.Headers = jsc.AssertHTTPHeader(runtime, resultObject.Get("headers"), "headers")
+		result.Body = surgeResultBody(runtime, resultObject)
+		responseObject := jsc.AssertObject(runtime, resultObject.Get("response"), "response", true)
+		if responseObject != nil {
+			status := int(jsc.AssertInt(runtime, responseObject.Get("status"), "status", true))
+			if status == 0 {
+				status = int(jsc.AssertInt(runtime, responseObject.Get("statusCode"), "statusCode", true))
+			}
+			result.Response = &adapter.HTTPRequestScriptResponse{
+				Status:  status,
+				Headers: jsc.AssertHTTPHeader(runtime, responseObject.Get("headers"), "headers"),
+				Body:    surgeResultBody(runtime, responseObject),
+			}
+		}
+		return goja.Undefined()
+	})
+	loop.Start()
+	loop.RunOnLoop(func(runtime *goja.Runtime) {
+		_, err := runtime.RunProgram(program)
+		if err != nil {
+			access.Lock()
+			scriptErr = err
+			access.Unlock()
+			doneFunc()
+		}
+	})
+	select {
+	case <-ctx.Done():
+		runtime.Interrupt(ctx.Err())
+		s.logger.Error(E.Cause(ctx.Err(), "HTTP request script failed open"))
+		return &adapter.HTTPRequestScriptResult{}, nil
+	case <-done:
+		access.Lock()
+		defer access.Unlock()
+	}
+	if scriptErr != nil {
+		s.logger.Error(E.Cause(scriptErr, "HTTP request script failed open"))
+		return &adapter.HTTPRequestScriptResult{}, nil
+	}
+	return &result, scriptErr
+}
+
+func (s *SurgeScript) ExecuteHTTPResponse(ctx context.Context, timeout time.Duration, request *http.Request, response *http.Response, body []byte, binaryBody bool, fullHeaderMode bool, arguments []string) (*adapter.HTTPResponseScriptResult, error) {
+	if timeout == 0 {
+		timeout = defaultSurgeScriptTimeout
+	}
+	if engine := s.platformEngineFor(len(body)); engine != nil {
+		if result, handled := s.executePlatformHTTPResponse(ctx, engine, timeout, request, response, body, binaryBody, fullHeaderMode, arguments); handled {
+			return result, nil
+		}
+	}
+	ctx, timeoutCancel := context.WithTimeout(ctx, timeout)
+	defer timeoutCancel()
+	if err := acquireSurgeScriptSlot(ctx); err != nil {
+		s.logger.Error(E.Cause(err, "HTTP response script skipped"))
+		return &adapter.HTTPResponseScriptResult{}, nil
+	}
+	defer releaseSurgeScriptSlot()
+	releaseMemory, admitted := acquireGojaScript(ctx, len(body), s.source.uncompiledLength())
+	if !admitted {
+		s.logger.Warn("HTTP response script skipped: insufficient memory headroom for a ", len(body), " byte body")
+		return &adapter.HTTPResponseScriptResult{}, nil
+	}
+	defer releaseMemory()
+	defer releaseScriptMemory(len(body))
+	program := s.source.Program()
+	if program == nil {
+		s.logger.Warn("HTTP response script skipped because source is unavailable")
+		return &adapter.HTTPResponseScriptResult{}, nil
+	}
+	ctx, cancel := context.WithCancelCause(ctx)
+	defer cancel(nil)
+	runtime, loop := NewRuntime(ctx, cancel)
+	SetModules(runtime, loop, ctx, s.logger, cancel, s.tag)
+	defer loop.Terminate()
+	surge.Enable(runtime, "http-response", arguments, binaryBody, "")
+	runtime.ClearInterrupt()
+	requestObject := runtime.NewObject()
+	requestObject.Set("url", request.URL.String())
+	requestObject.Set("method", request.Method)
+	requestHeaders := surgeRequestHeaders(request)
+	if fullHeaderMode {
+		requestObject.Set("headers", jsc.HeadersToArrayValue(runtime, requestHeaders))
+	} else {
+		requestObject.Set("headers", jsc.HeadersToValue(runtime, requestHeaders))
+	}
+	requestObject.Set("id", F.ToString(uintptr(unsafe.Pointer(request))))
+	setSurgeRequestAliases(runtime, requestObject)
+
+	responseObject := runtime.NewObject()
+	responseObject.Set("status", response.StatusCode)
+	responseObject.Set("statusCode", response.StatusCode)
+	if fullHeaderMode {
+		responseObject.Set("headers", jsc.HeadersToArrayValue(runtime, response.Header))
+	} else {
+		responseObject.Set("headers", jsc.HeadersToValue(runtime, response.Header))
+	}
+	if len(body) > 0 {
+		if !binaryBody {
+			responseObject.Set("body", string(body))
+		} else {
+			responseObject.Set("body", jsc.NewUint8Array(runtime, body))
+		}
+		responseObject.Set("bodyBytes", jsc.NewUint8Array(runtime, body))
+	}
+	setSurgeResponseAliases(runtime, responseObject)
+
+	done := make(chan struct{})
+	doneFunc := common.OnceFunc(func() {
+		close(done)
+	})
+	var (
+		access    sync.Mutex
+		result    adapter.HTTPResponseScriptResult
+		scriptErr error
+	)
+	setSurgeDoneAliases(runtime, func(call goja.FunctionCall) goja.Value {
+		resultObject := jsc.AssertObject(runtime, call.Argument(0), "done() argument", true)
+		if resultObject == nil {
+			doneFunc()
+			return goja.Undefined()
+		}
+		access.Lock()
+		defer access.Unlock()
+		result.Status = int(jsc.AssertInt(runtime, resultObject.Get("status"), "status", true))
+		if result.Status == 0 {
+			result.Status = int(jsc.AssertInt(runtime, resultObject.Get("statusCode"), "statusCode", true))
+		}
+		result.Abort = jsc.AssertBool(runtime, resultObject.Get("abort"), "abort", true)
+		result.Headers = jsc.AssertHTTPHeader(runtime, resultObject.Get("headers"), "headers")
+		result.Body = surgeResultBody(runtime, resultObject)
+		doneFunc()
+		return goja.Undefined()
+	})
+	loop.Start()
+	loop.RunOnLoop(func(runtime *goja.Runtime) {
+		_, err := runtime.RunProgram(program)
+		if err != nil {
+			access.Lock()
+			scriptErr = err
+			access.Unlock()
+			doneFunc()
+		}
+	})
+	select {
+	case <-ctx.Done():
+		runtime.Interrupt(ctx.Err())
+		s.logger.Error(E.Cause(ctx.Err(), "HTTP response script failed open"))
+		return &adapter.HTTPResponseScriptResult{}, nil
+	case <-done:
+		access.Lock()
+		defer access.Unlock()
+	}
+	if scriptErr != nil {
+		s.logger.Error(E.Cause(scriptErr, "HTTP response script failed open"))
+		return &adapter.HTTPResponseScriptResult{}, nil
+	}
+	return &result, nil
+}
